# edp8 fleet — one .env for start.ps1 / start.sh. Copy to `.env` and edit.
# Trusted single-machine mode (the default) needs nothing here; every line has a safe default.

# ── ports (defaults match the fleet) ───────────────────────────────────────────
EDP8_PORT=9400          # board — the source of truth (tickets, docs, criteria, events); serves the Folio SPA at /ui (EDP8_UI=folio default)
EDP_BROKER_PORT=9300    # broker — the wake plane: shell inboxes, channels, SSE; wakes parked shells
EDP_POOL_PORT=9301      # pool — spawns/parks/reaps Claude shells (one per seat)
EDP8_MCP_PORT=9402      # mcp — the one shared MCP server every shell's tools talk to
# the Slack bridge has no port (a doorbell: broker inbox growth -> Slack ping); needs slack_map.json

# ── reach from another machine (design §15, S17) ───────────────────────────────
# Uncomment to serve the board on the network. PUBLIC MODE FAILS CLOSED:
#   - EDP8_ADMIN_TOKEN must be non-default (below), and
#   - tokens.json must hold a credential for every human and at least one agent.
# TLS is expected to terminate at a reverse proxy in front of the board (see README).
#EDP8_PUBLIC_URL=https://board.example.ts.net
# EDP8_HOST overrides the bind address; public mode defaults it to 0.0.0.0, trusted to 127.0.0.1.
#EDP8_HOST=0.0.0.0

# ── secrets ────────────────────────────────────────────────────────────────────
EDP8_ADMIN_TOKEN=dev    # admin token for pool/registry routes. CHANGE THIS in public mode.
# tokens.json (next to this file, or EDP8_TOKENS): {"<human-handle>": "<secret>", "agents": {"<seat>": "<secret>"}}
#EDP8_TOKENS=

# ── owner + data ───────────────────────────────────────────────────────────────
EDP8_OWNER=owner        # the human owner handle the board bootstrap registers
#EDP8_HOME=             # defaults to this v8 dir; set to isolate a throwaway fleet
#EDP8_DATA=             # defaults to <home>/.data; logs, db, pid files live here
#EDP8_RUN_DIR=          # defaults to <home>/.run; the launcher's per-service pid/state files
