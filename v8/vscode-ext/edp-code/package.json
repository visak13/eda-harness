{
  "name": "edp-code",
  "displayName": "EDP",
  "description": "Tag a code selection to anyone on the EDP board; live-seats badge, guarded git and an external terminal for the fleet's shared tree.",
  "publisher": "edp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.138.0" },
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "extensionDependencies": ["vscode.git"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "edp.signIn", "title": "Sign in to board", "category": "EDP" },
      { "command": "edp.signOut", "title": "Sign out of board", "category": "EDP" },
      { "command": "edp.tagSelection", "title": "Tag selection on board…", "category": "EDP" },
      { "command": "edp.showSeats", "title": "Show live seats", "category": "EDP" },
      { "command": "edp.checkout", "title": "Checkout… (guarded)", "category": "EDP" },
      { "command": "edp.merge", "title": "Merge… (guarded)", "category": "EDP" },
      { "command": "edp.pull", "title": "Pull (guarded)", "category": "EDP" },
      { "command": "edp.openExternalTerminal", "title": "Open external terminal here", "category": "EDP" }
    ],
    "menus": {
      "editor/context": [{ "command": "edp.tagSelection", "when": "editorTextFocus", "group": "9_cutcopypaste@99" }]
    },
    "keybindings": [{ "command": "edp.tagSelection", "key": "ctrl+alt+m", "when": "editorTextFocus" }],
    "configuration": {
      "title": "EDP",
      "properties": {
        "edp.boardUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9400",
          "scope": "machine",
          "description": "The EDP board. Credentials are sent only to a loopback or https URL."
        },
        "edp.sharedTreePaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "machine",
          "description": "Folders that are the fleet's shared tree. Empty means the v8 repo root the service was started for."
        },
        "edp.externalTerminal": {
          "type": "object",
          "scope": "machine",
          "default": { "kind": "pwsh", "exe": "pwsh.exe" },
          "properties": {
            "kind": { "type": "string", "enum": ["pwsh", "cmd", "git-bash"] },
            "exe": { "type": "string" }
          },
          "description": "The shell `EDP: Open external terminal here` launches: kind and a real .exe path (git-bash: Git\\git-bash.exe)."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "npm run check-types && node esbuild.mjs --production",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license -o edp-code.vsix"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
