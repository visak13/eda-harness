{
  "name": "edp-code",
  "displayName": "EDP",
  "description": "Chat on EDP tickets and epics beside the editor, tag a code selection to anyone on the board; live-seats badge, guarded git and an external terminal for the fleet's shared tree.",
  "publisher": "edp",
  "version": "0.9.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.138.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "edp-chat",
          "title": "EDP Chat",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "edp-chat": [
        {
          "type": "webview",
          "id": "edp.chat",
          "name": "Chat",
          "contextualTitle": "EDP Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "edp.signIn",
        "title": "Sign in to board",
        "category": "EDP"
      },
      {
        "command": "edp.signOut",
        "title": "Sign out of board",
        "category": "EDP"
      },
      {
        "command": "edp.tagSelection",
        "title": "Tag selection on board…",
        "category": "EDP"
      },
      {
        "command": "edp.showSeats",
        "title": "Show live seats",
        "category": "EDP"
      },
      {
        "command": "edp.checkout",
        "title": "Checkout… (guarded)",
        "category": "EDP"
      },
      {
        "command": "edp.merge",
        "title": "Merge… (guarded)",
        "category": "EDP"
      },
      {
        "command": "edp.pull",
        "title": "Pull (guarded)",
        "category": "EDP"
      },
      {
        "command": "edp.openExternalTerminal",
        "title": "Open external terminal here",
        "category": "EDP"
      },
      {
        "command": "edp.chat.open",
        "title": "Open chat",
        "category": "EDP"
      },
      {
        "command": "edp.chat.pick",
        "title": "Chat: open a ticket or epic thread…",
        "category": "EDP"
      },
      {
        "command": "edp.doc.approve",
        "title": "Approve design (the version shown)",
        "category": "EDP",
        "icon": "$(check)",
        "enablement": "activeCustomEditorId == edp.docReader"
      },
      {
        "command": "edp.doc.requestChanges",
        "title": "Request changes on the design…",
        "category": "EDP",
        "icon": "$(request-changes)",
        "enablement": "activeCustomEditorId == edp.docReader"
      },
      {
        "command": "edp.doc.resolveApprove",
        "title": "Approve proposed doc",
        "category": "EDP",
        "icon": "$(pass)",
        "enablement": "activeCustomEditorId == edp.docReader"
      },
      {
        "command": "edp.doc.resolveReject",
        "title": "Reject proposed doc",
        "category": "EDP",
        "icon": "$(close)",
        "enablement": "activeCustomEditorId == edp.docReader"
      },
      {
        "command": "edp.doc.compare",
        "title": "Compare with another version…",
        "category": "EDP",
        "icon": "$(diff)",
        "enablement": "activeCustomEditorId == edp.docReader"
      },
      {
        "command": "edp.doc.source",
        "title": "Open markdown source",
        "category": "EDP",
        "icon": "$(go-to-file)",
        "enablement": "activeCustomEditorId == edp.docReader"
      },
      {
        "command": "edp.doc.fullScreen",
        "title": "Full screen (maximise the reader)",
        "category": "EDP",
        "icon": "$(screen-full)",
        "enablement": "activeCustomEditorId == edp.docReader"
      },
      {
        "command": "edp.doc.refresh",
        "title": "Refresh doc",
        "category": "EDP",
        "icon": "$(refresh)",
        "enablement": "activeCustomEditorId == edp.docReader"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "edp.tagSelection",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@99"
        }
      ],
      "editor/title": [
        {
          "command": "edp.doc.approve",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canApprove",
          "group": "navigation@1"
        },
        {
          "command": "edp.doc.requestChanges",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canApprove",
          "group": "navigation@2"
        },
        {
          "command": "edp.doc.resolveApprove",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canResolve",
          "group": "navigation@3"
        },
        {
          "command": "edp.doc.resolveReject",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canResolve",
          "group": "navigation@4"
        },
        {
          "command": "edp.doc.compare",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.hasVersions",
          "group": "navigation@5"
        },
        {
          "command": "edp.doc.source",
          "when": "activeCustomEditorId == edp.docReader",
          "group": "navigation@6"
        },
        {
          "command": "edp.doc.fullScreen",
          "when": "activeCustomEditorId == edp.docReader",
          "group": "navigation@7"
        },
        {
          "command": "edp.doc.refresh",
          "when": "activeCustomEditorId == edp.docReader",
          "group": "navigation@8"
        }
      ],
      "commandPalette": [
        {
          "command": "edp.doc.approve",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canApprove"
        },
        {
          "command": "edp.doc.requestChanges",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canApprove"
        },
        {
          "command": "edp.doc.resolveApprove",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canResolve"
        },
        {
          "command": "edp.doc.resolveReject",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.canResolve"
        },
        {
          "command": "edp.doc.compare",
          "when": "activeCustomEditorId == edp.docReader && edp.doc.hasVersions"
        },
        {
          "command": "edp.doc.source",
          "when": "activeCustomEditorId == edp.docReader"
        },
        {
          "command": "edp.doc.fullScreen",
          "when": "activeCustomEditorId == edp.docReader"
        },
        {
          "command": "edp.doc.refresh",
          "when": "activeCustomEditorId == edp.docReader"
        }
      ]
    },
    "keybindings": [
      {
        "command": "edp.tagSelection",
        "key": "ctrl+alt+m",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "EDP",
      "properties": {
        "edp.boardUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9400",
          "scope": "machine",
          "description": "The EDP board. Credentials are sent only to a loopback or https URL."
        },
        "edp.chat.commitWindow": {
          "type": "object",
          "scope": "machine",
          "default": {
            "count": 500,
            "days": 30
          },
          "properties": {
            "count": {
              "type": "number",
              "minimum": 1,
              "maximum": 5000
            },
            "days": {
              "type": "number",
              "minimum": 1,
              "maximum": 3650
            }
          },
          "description": "How much of the shared tree's history the chat reads for change cards: the newest `count` commits of the last `days` days."
        },
        "edp.sharedTreePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Folders that are the fleet's shared tree. Empty means the v8 repo root the service was started for."
        },
        "edp.externalTerminal": {
          "type": "object",
          "scope": "machine",
          "default": {
            "kind": "pwsh",
            "exe": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
          },
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "pwsh",
                "cmd",
                "git-bash"
              ]
            },
            "exe": {
              "type": "string"
            }
          },
          "description": "The shell `EDP: Open external terminal here` launches: kind and a real .exe path (git-bash: Git\\git-bash.exe)."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "edp.docReader",
        "displayName": "EDP reader",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "npm run check-types && node esbuild.mjs --production",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license -o edp-code.vsix"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.13.6",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "4.0.0",
    "dompurify": "3.4.15",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4",
    "jsdom": "30.0.1",
    "markdown-it": "15.0.2",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
