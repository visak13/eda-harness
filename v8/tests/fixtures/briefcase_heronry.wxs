<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package UpgradeCode="bd81b12f-f8df-5cbb-9334-863b658e6ae9" Name="Heronry Desktop" Version="0.9.1"
             Manufacturer="Heronry contributors" Language="1033" Scope="perUserOrMachine">
        <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

        <MajorUpgrade
            DowngradeErrorMessage="A newer version of [ProductName] is already installed."
            AllowSameVersionUpgrades="yes"
            Schedule="afterInstallInitialize" />

        <Icon Id="ProductIcon" SourceFile="icon.ico" />

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ProgramMenuSubfolder" Name="Heronry Desktop">
                <Component Id="ApplicationShortcuts">
                    <RegistryValue Root="HKMU" Key="Software\Heronry contributors\Heronry Desktop" Name="installed" Type="integer" Value="1" KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <Feature Id="DefaultFeature" Title="Heronry Desktop">
            <ComponentRef Id="ApplicationShortcuts" />
        </Feature>
    </Package>
</Wix>
