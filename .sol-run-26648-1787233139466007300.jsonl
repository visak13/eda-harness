\n 591:         # verify is NOT done â€” the plan must keep waiting on it (the gate\r\n 592:         # hasn't confirmed), not advance to acceptance-review as if it\r\n 593:         # completed. This is what makes the verify state honest at the\r\n 594:         # FSM level (fixes O4: a verify action â‰  a done one).\r\n 595:         non_terminal = [\r\n 596:             a for a in p.actions\r\n 597:             if a.status in (\"pending\", \"in_progress\", \"verify\", \"needs_review\")\r\n 598:         ]\r\n 599:         if non_terminal:\r\n 600:             verifying = [a.action_id for a in non_terminal\r\n 601:                          if a.status == \"verify\"]\r\n 602:             rationale = \"actions in flight; awaiting results\"\r\n 603:             if verifying:\r\n 604:                 rationale = (\r\n 605:                     f\"actions in flight; {len(verifying)} parked in \"\r\n 606:                     f\"`verify` (gate not yet confirmed): {verifying}\"\r\n 607:                 )\r\n 608:             # s27/C7: name the actions suppressed for liveness, so a planner\r\n 609:             # reading the WAIT can see WHY an otherwise-ready action was not\r\n 610:             # dispatched (it has a live shell) rather than inferring a stall.\r\n 611:             suppressed = [a.action_id for a in non_terminal\r\n 612:                           if a.action_id in live_action_ids]\r\n 613:             if suppressed:\r\n 614:                 rationale += (\r\n 615:                     f\"; {len(suppressed)} not dispatched because a LIVE \"\r\n 616:                     f\"worker already holds them: {suppressed}\"\r\n 617:                 )\r\n 618:             # WP2 G-REWORK: name the frozen actions so the WAIT reads as\r\n 619:             # \"held by policy\", never as an unexplained stall. A frozen\r\n 620:             # action will NOT be re-dispatched by the FSM; unfreezing is an\r\n 621:             # ask_above decision.\r\n 622:             frozen = [a.action