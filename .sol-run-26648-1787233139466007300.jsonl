close â€” best-effort (a failed write never fails the close).\r\n 5990:                 try:\r\n 5991:                     self.ctx.recipes.write_state_synthesis(\r\n 5992:                         r.recipe_id, _state_synthesis_md(self.ctx, r))\r\n 5993:                 except Exception:\r\n 5994:                     pass\r\n 5995:                 return Tool.ok(_Ok())\r\n 5996:         return _precondition(f\"no step {m.step_id!r} in recipe\")\r\n 5997: \r\n 5998: \r\n 5999: # â”€â”€ producer-verify guard (Bug B, 2026-05-26) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n 6000: # A `command` verify must CHECK a result, not PRODUCE one. A build /\r\n 6001: # install / dev-server command re-executes the producer on every\r\n 6002: # (re-)record â€” wasteful, and it can hang the gate. This is exactly the\r\n 6003: # stall that recurred across b2/b5/b6/b7/b8: the planner authored\r\n 6004: # `command: npm run build` as the acceptance gate, and each re-record\r\n 6005: # (the worker's done-signal kept getting lost to recording lag) re-ran\r\n 6006: # the build, which hung on an stdin prompt. Verify the ARTIFACT the\r\n 6007: # producer emits instead. Tests / linters / validators are fine â€” they\r\n 6008: # don't produce and they exit.\r\n 6009: _PRODUCER_VERIFY_RE = re.compile(\r\n 6010:     r\"(?:\\b|^)(?:\"\r\n--- 9610-9740 ---\r\n 9610: # superseded them, and bridge.py still drives sol_bridge.run_sol as its `cli`\r\n 9611: # backend â€” the engine survives, only the direct verbs went.\r\n 9612: \r\n 9613: def _sol_caller() -> str:\r\n 9614:     \"\"\"The stickiness identity of the calling shell: its EDP_HANDLE (worker\r\n 9615:     `<plan>:<action>`, planner `<recipe>:<step>`), or its role when it has none\r\n 9616:     (the neuron). The agent never derives this â€” the tool reads it, exactly as\r\n 9617:     _self_and_parent_addresses does.\"\"\"\r\n 9618:     return (os.environ.get(\"EDP_HANDLE\", \"\").strip()\r\n 9619:             or os.environ.get(\"EDP_ROLE\", \"\").strip() or \"anon\")\r\n 9620: \r\n 9621: \r\n 9622: # â”€â”€ provider-bridge tools (v7 WS1, 2026-08-05) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n 9623: # The DETERMINISTIC engine is tools/bridge.py â€” delegate registry (.bridge.json,\r\n 9624: # cli|http backends), self-contained work orders, up-front window refusal, the\r\n 9625: # adversary findings contract, and the per-caller audit sidecar. These four\r\n 9626: # classes are the MINIMUM agent-facing surface: a shell passes content; it never\r\n 9627: # picks endpoints, keys, or sandboxes. WHO may delegate WHAT is (1) role-scoped\r\n 9628: # in roles.py and (2) route-gated in .bridge.json â€” an unrouted (role,\r\n 9629: # task_class) refuses with \"do this work yourself\", so delegation is always a\r\n 9630: # deliberate config decision, never an agent's whim. Sol-through-codex bills the\r\n 9631: # ChatGPT plan; the no-retry blocker discipline is inherited from sol_bridge.\r\n 9632: \r\n 9633: def _registry_models() -> frozenset[str] | None:\r\n 9634:     \"\"\"The exact model ids the v7 seat registry (models.json at\r\n 9635:     EDP_AGENT_HOME) pins, or None when no registry is configured (legacy /\r\n 9636:     hermetic tests â€” no allowlist to enforce). F38#9's one authority.\"\"\"\r\n 9637:     _home = os.environ.get(\"EDP_AGENT_HOME\", \"\").strip()\r\n 9638:     if not _home:\r\n 9639:         return None\r\n 9640:     try:\r\n 9641:         from edp_contracts.seats import load as _seats_load\r\n 9642:     except ImportError:\r\n 9643:         return None\r\n 9644:     loaded = _seats_load(_home)\r\n 9645:     if loaded is None:\r\n 9646:         return None\r\n 9647:     seats, _roles = loaded\r\n 9648:     return frozenset(s.model for s in seats.values())\r\n 9649: \r\n 9650: \r\n 9651: def _bridge_delegate_for(kind_class: str, override: str) -> str:\r\n 9652:     \"\"\"Resolve the delegate deterministically: the .bridge.json route for\r\n 9653:     (role, kind_class); an explicit override is honored ONLY when a route for\r\n 9654:     this role already authorizes that delegate (F38#2 â€” the override used to\r\n 9655:     return before route_for was consulted, so any shell could name any\r\n 9656:     registered delegate and bypass the whole role+route governance the docs\r\n 9657:     promise). A role-less operator console stays unconstrained.\r\n 9658:     Raises bridge.BridgeError with the fix when unrouted.\"\"\"\r\n 9659:     from . import bridge as _bridge\r\n 9660:     role = os.environ.get(\"EDP_ROLE\", \"\").strip() or \"anon\"\r\n 9661:     _delegates, routes = _bridge.load_config()\r\n 9662:     if override.strip():\r\n 9663:         name = override.strip()\r\n 9664:         if name not in _delegates:\r\n 9665:             raise _bridge.BridgeError(\r\n 9666:                 f\"unknown delegate {name!r} (known: {sorted(_delegates)})\")\r\n 9667:         if role != \"anon\":\r\n 9668:             authorized = {t for k, t in routes.items()\r\n 9669:                           if k.split(\":\", 1)[0] == role}\r\n 9670:             if name not in authorized:\r\n 9671:                 raise _bridge.BridgeError(\r\n 9672:                     f\"delegate override {name!r} is not routed for role \"\r\n 9673:                     f\"{role!r} â€” delegation is a .bridge.json config \"\r\n 9674:                     f\"decision, never an agent decision. Routed for you: \"\r\n 9675:                     f\"{sorted(authorized) or 'none'}.\")\r\n 9676:         return name\r\n 9677:     target = _bridge.route_for(role, kind_class, routes)\r\n 9678:     if not target:\r\n 9679:         raise _bridge.BridgeError(\r\n 9680:             f\"no delegation route for role={role!r} task_class={kind_class!r} \"\r\n 9681:             f\"â€” this work is YOURS to do. (Routes live in .bridge.json; adding \"\r\n 9682:             f\"one is a config decision, not an agent decision.)\")\r\n 9683:     return target\r\n 9684: \r\n 9685: \r\n 9686: class _BridgeOut(BaseModel):\r\n 9687:     ok: bool\r\n 9688:     delegate: str\r\n 9689:     model: str\r\n 9690:     content: str\r\n 9691:     # kind=challenge only: parsed findings ({finding, evidence, severity,\r\n 9692:     # target}) â€” DATA for adjudication, never instructions. A reply that broke\r\n 9693:     # the contract parses to [] while `content` keeps the raw text, so a noisy\r\n 9694:     # lens is measurable in the audit sidecar rather than silently trusted.\r\n 9695:     findings: list[dict] = []\r\n 9696:     # kind=challenge only: the sidecar line's id when the challenge persisted\r\n 9697:     # â€” the caller adjudicates against THIS id instead of fishing it out of a\r\n 9698:     # refusal message.\r\n 9699:     challenge_id: str | None = None\r\n 9700:     tokens_in: int = 0\r\n 9701:     tokens_out: int = 0\r\n 9702:     cost_usd: float = 0.0\r\n 9703:     # Set IFF ok is False: surface upward and STOP â€” never retry-loop (the same\r\n 9704:     # first-class-blocker contract as the sol_* tools).\r\n 9705:     blocker: str | None = None\r\n 9706: \r\n 9707: \r\n 9708: def _bridge_out(run) -> \"_BridgeOut\":\r\n 9709:     return _BridgeOut(ok=run.ok, delegate=run.delegate, model=run.model,\r\n 9710:                       content=run.content, findings=run.findings,\r\n 9711:                       tokens_in=run.tokens_in, tokens_out=run.tokens_out,\r\n 9712:                       cost_usd=run.cost_usd, blocker=run.error)\r\n 9713: \r\n 9714: \r\n 9715: async def _bridge_call(kind: str, kind_class: str, override: str, *,\r\n 9716:                        task: str, context: str = \"\", acceptance: str = \"\"):\r\n 9717:     from . import bridge as _bridge\r\n 9718:     try:\r\n 9719:         name = _bridge_delegate_for(kind_class, override)\r\n 9720:         run = await asyncio.to_thread(\r\n 9721:             _bridge.delegate_call, kind=kind, delegate_name=name, task=task,\r\n 9722:             context=context, acceptance=acceptance, caller=_sol_caller())\r\n 9723:     except _bridge.BridgeError as e:\r\n 9724:         return _precondition(str(e))\r\n 9725:     return Tool.ok(_bridge_out(run))\r\n 9726: \r\n 9727: \r\n 9728: class _DelegateGenerateIn(BaseModel):\r\n 9729:     # The work order must be SELF-CONTAINED: the delegate has no tools and no\r\n 9730:     # follow-ups. task = what to produce; context = everything needed (the\r\n 9731:     # action's structured fields, relevant file CONTENT â€” not paths â€” and the\r\n 9732:     # spec-doc excerpt YOU select); acceptance = the criteria the artifact will\r\n 9733:     # be judged against (include them: the delegate writes toward the gate).\r\n 9734:     task: str\r\n 9735:     context: str = \"\"\r\n 9736:     acceptance: str = \"\"\r\n 9737:     # names the .bridge.json route (role:task_class). Your action's task class\r\n 9738:     # unless the plan stamped one.\r\n 9739:     task_class: str = \"*\"\r\n 9740:     delegate: str = \"\"                  # explicit registry name; rarely needed\r\n--- 9820-10080 ---\r\n 9820:     target_id: str\r\n 9821:     content: str                        # the target's actual content, complete\r\n 9822:     # the attack angle: break-the-acceptance | wrong-option-chosen |\r\n 9823:     # hidden-coupling | missing-concern (or a lens the plan stamped)\r\n 9824:     lens: str\r\n 9825: \r\n 9826: \r\n 9827: # â”€â”€ WP2 G-ADJ â€” adversarial-challenge adjudication sidecar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n 9828: # One jsonl per plan (.plans/<plan_id>/challenges.jsonl): challenge lines\r\n 9829: # ({challenge_id, lens, at, findings_raw}) appended by AdversarialChallenge,\r\n 9830: # adjudication lines ({adjudication: {challenge_id, disposition, rationale,\r\n 9831: # at}}) appended by record_context(kind='challenge_adjudication'). The\r\n 9832: # dispatch gate (pool_spawn_worker) refuses NON-review legs while any\r\n 9833: # challenge has no adjudication; absent sidecar = no gate (legacy).\r\n 9834: _CHALLENGE_FINDINGS_CAP = 20000\r\n 9835: _ADJ_DISPOSITIONS = (\"accepted_fixed\", \"accepted_wontfix\", \"rejected\",\r\n 9836:                      \"duplicate\")\r\n 9837: \r\n 9838: \r\n 9839: def _challenges_path(root: Path, plan_id: str) -> Path:\r\n 9840:     return Path(root) / plan_id / \"challenges.jsonl\"\r\n 9841: \r\n 9842: \r\n 9843: def _append_challenge(root: Path, plan_id: str, entry: dict) -> None:\r\n 9844:     from ..store.atomic import append_jsonl\r\n 9845:     append_jsonl(_challenges_path(root, plan_id), entry)\r\n 9846: \r\n 9847: \r\n 9848: def _read_challenges(root: Path, plan_id: str) -> list[dict]:\r\n 9849:     from ..store.atomic import read_jsonl\r\n 9850:     return read_jsonl(_challenges_path(root, plan_id))\r\n 9851: \r\n 9852: \r\n 9853: def _challenge_satisfied(root: Path, plan_id: str) -> bool:\r\n 9854:     \"\"\"F22 â€” True when the plan's challenges sidecar records ANY adversarial\r\n 9855:     challenge line OR a waiver line. False = the pre-ratification adversary\r\n 9856:     never ran and nobody consciously waived it (the discipline that never\r\n 9857:     fired: owner observation 2026-08-17, 'my codex usage before and after a\r\n 9858:     recipe never changes').\"\"\"\r\n 9859:     for e in _read_challenges(root, plan_id):\r\n 9860:         if e.get(\"challenge_id\") or e.get(\"waiver\"):\r\n 9861:             return True\r\n 9862:     return False\r\n 9863: \r\n 9864: \r\n 9865: def _challenge_gate_min_actions() -> int:\r\n 9866:     \"\"\"Plans below this action count are exempt from G-CHALLENGE (small\r\n 9867:     enough to inspect at a glance; the adversary exists for the plans whose\r\n 9868:     failure modes hide in the weave). Env-tunable; 0 disables the gate.\"\"\"\r\n 9869:     try:\r\n 9870:         return int(os.environ.get(\"EDP_CHALLENGE_GATE_MIN_ACTIONS\", \"3\"))\r\n 9871:     except ValueError:\r\n 9872:         return 3\r\n 9873: \r\n 9874: \r\n 9875: def _challenge_required(plan, step=None) -> bool:\r\n 9876:     \"\"\"F32 (Sol-review #9) â€” G-CHALLENGE keys on RISK, not just action\r\n 9877:     count: batching work into one action to obey right-sizing (F28) must\r\n 9878:     not duck the adversary. Required when EITHER:\r\n 9879:       * the plan has >= EDP_CHALLENGE_GATE_MIN_ACTIONS actions, OR\r\n 9880:       * the owning step's declared estimate says the work is big â€”\r\n 9881:         hours >= EDP_CHALLENGE_GATE_MIN_HOURS (default 2) or tokens >=\r\n 9882:         EDP_CHALLENGE_GATE_MIN_TOKENS (default 50000).\r\n 9883:     Min-actions 0 disables the whole gate (the test-suite default).\"\"\"\r\n 9884:     _min = _challenge_gate_min_actions()\r\n 9885:     if _min <= 0:\r\n 9886:         return False\r\n 9887:     if len(plan.actions) >= _min:\r\n 9888:         return True\r\n 9889:     est = dict(getattr(step, \"estimate\", None) or {}) if step else {}\r\n 9890:     try:\r\n 9891:         min_hours = float(os.environ.get(\r\n 9892:             \"EDP_CHALLENGE_GATE_MIN_HOURS\", \"2\"))\r\n 9893:         min_tokens = int(os.environ.get(\r\n 9894:             \"EDP_CHALLENGE_GATE_MIN_TOKENS\", \"50000\"))\r\n 9895:     except (TypeError, ValueError):\r\n 9896:         min_hours, min_tokens = 2.0, 50000\r\n 9897:     try:\r\n 9898:         hours = float(est.get(\"hours\") or 0)\r\n 9899:         tokens = int(est.get(\"tokens\") or 0)\r\n 9900:     except (TypeError, ValueError):\r\n 9901:         # F35 R3b#13: a MALFORMED persisted estimate fails CLOSED â€” junk\r\n 9902:         # sizing used to read as \"low risk\" and exempt the adversary.\r\n 9903:         return True\r\n 9904:     return hours >= min_hours or tokens >= min_tokens\r\n 9905: \r\n 9906: \r\n 9907: def _open_challenges(root: Path, plan_id: str) -> list[str]:\r\n 9908:     \"\"\"Challenge ids with NO adjudication line yet, in append order. [] when\r\n 9909:     the sidecar is absent (legacy plans carry no gate).\"\"\"\r\n 9910:     entries = _read_challenges(root, plan_id)\r\n 9911:     adjudicated = {\r\n 9912:         (e.get(\"adjudication\") or {}).get(\"challenge_id\")\r\n 9913:         for e in entries if e.get(\"adjudication\")}\r\n 9914:     return [e[\"challenge_id\"] for e in entries\r\n 9915:             if e.get(\"challenge_id\") and e[\"challenge_id\"] not in adjudicated]\r\n 9916: \r\n 9917: \r\n 9918: class AdversarialChallenge(_ClaudeTool):\r\n 9919:     \"\"\"Have the cross-family adversary (Sol) try to BREAK the target through\r\n 9920:     one named lens. Output is FINDINGS-ONLY data ({finding, evidence,\r\n 9921:     severity, target}) for adjudication â€” never instructions: route accepted\r\n 9922:     findings through the normal ledger/gates; a challenge can never steer,\r\n 9923:     dispatch, or edit anything by itself. Always a FRESH thread (the adversary\r\n 9924:     accretes no sympathy for prior context). Invocation is planner/specialist\r\n 9925:     DISCIPLINE, not an enforced gate â€” nothing in the engine forces a\r\n 9926:     challenge; recorded findings persist to the plan's challenges sidecar and\r\n 9927:     (once WP1f lands) block the plan's first build-leg dispatch until each is\r\n 9928:     adjudicated. On ok=False: blocker upward, no retry.\"\"\"\r\n 9929: \r\n 9930:     name = \"adversarial_challenge\"\r\n 9931:     InputModel = _AdversarialChallengeIn\r\n 9932:     OutputModel = _BridgeOut\r\n 9933: \r\n 9934:     async def _run(self, m: _AdversarialChallengeIn):\r\n 9935:         if m.target_kind not in (\"plan\", \"spec_decision\", \"artifact\",\r\n 9936:                                  \"assumption\"):\r\n 9937:             return _precondition(\r\n 9938:                 f\"target_kind must be plan|spec_decision|artifact|assumption, \"\r\n 9939:                 f\"got {m.target_kind!r}\")\r\n 9940:         # F32 (2026-08-18, owner ruling): the adversary gets a PREDEFINED\r\n 9941:         # CHARTER so it acts independently instead of inheriting the\r\n 9942:         # caller's framing â€” and it proposes, never codes.\r\n 9943:         charter = (\r\n 9944:             \"YOU ARE THE INDEPENDENT ADVERSARY of a multi-agent build \"\r\n 9945:             \"system. You did not write this plan, you owe its author \"\r\n 9946:             \"nothing, and you must NOT adopt its framing â€” re-derive what \"\r\n 9947:             \"the work should look like from the stated goal, then attack \"\r\n 9948:             \"the gap. You NEVER write or edit code: findings and suggested \"\r\n 9949:             \"changes only; the plan's owner adjudicates each one.\\n\\n\"\r\n 9950:             f\"TARGET: this {m.target_kind} ({m.target_id}). \"\r\n 9951:             f\"LENS: {m.lens}.\\n\"\r\n 9952:             \"HUNT, in priority order: (1) an acceptance bar satisfiable \"\r\n 9953:             \"while the user's goal fails (Goodhart); (2) a wrong option \"\r\n 9954:             \"baked in where a recorded alternative wins; (3) a requirement \"\r\n 9955:             \"from the goal or a named artifact that appears NOWHERE in the \"\r\n 9956:             \"plan; (4) hidden coupling between actions that the DAG treats \"\r\n 9957:             \"as independent; (5) a missing cross-cutting concern \"\r\n 9958:             \"(security, privacy, data loss, irreversibility); (6) scope \"\r\n 9959:             \"silently narrowed relative to the goal.\\n\"\r\n 9960:             \"OUTPUT: a JSON array of findings, most severe first, each \"\r\n 9961:             \"{finding, evidence, severity: high|medium|low, target: <the \"\r\n 9962:             \"action/step/line it names>, suggested_fix: <the concrete \"\r\n 9963:             \"change you would make â€” as a proposal, not a patch>}. \"\r\n 9964:             \"No praise, no summary, findings only; an empty array means \"\r\n 9965:             \"you genuinely found nothing after a real hunt.\")\r\n 9966:         # F35 R3b#4: for a PLAN target the adversary attacks the STORED\r\n 9967:         # plan, assembled server-side â€” caller-supplied content alone let\r\n 9968:         # a flattering summary stand in for the real DAG. The caller's\r\n 9969:         # text still rides along as notes (it may carry context the store\r\n 9970:         # lacks); it can no longer be the whole picture.\r\n 9971:         _content = m.content\r\n 9972:         if m.target_kind == \"plan\" and self.ctx.plans.exists(m.target_id):\r\n 9973:             _pl = self.ctx.plans.load(m.target_id)\r\n 9974: \r\n 9975:             def _clip(text: str, cap: int) -> str:\r\n 9976:                 # F38#10: LOUD elision â€” a silent clip hid exactly the tail\r\n 9977:                 # clauses (security/data-loss acceptance) the adversary\r\n 9978:                 # exists to inspect, while the wrapper claimed the context\r\n 9979:                 # was complete.\r\n 9980:                 t = text or \"\"\r\n 9981:                 if len(t) <= cap:\r\n 9982:                     return t\r\n 9983:                 return f\"{t[:cap]} â€¦[+{len(t) - cap} chars elided]\"\r\n 9984: \r\n 9985:             _rows = [\r\n 9986:                 f\"- {a.action_id} [{a.status}] deps={list(a.depends_on)} \"\r\n 9987:                 f\"leg={getattr(a, 'leg_kind', None) or 'build'}: \"\r\n 9988:                 f\"{_clip(a.description, 300)} | acceptance=\"\r\n 9989:                 f\"{getattr(a.acceptance, 'kind', None)}:\"\r\n 9990:                 f\"{_clip(getattr(a.acceptance, 'expected', ''), 200)}\"\r\n 9991:                 for a in _pl.actions]\r\n 9992:             _content = (\r\n 9993:                 f\"PLAN {_pl.plan_id} (server-assembled from the stored \"\r\n 9994:                 f\"record)\\nGOAL: {_pl.goal}\\nSHAPE: {_pl.shape}\\n\"\r\n 9995:                 \"ACTIONS:\\n\" + \"\\n\".join(_rows)\r\n 9996:                 + (\"\\n\\nCALLER NOTES:\\n\" + m.content if m.content else \"\"))\r\n 9997:         res = await _bridge_call(\r\n 9998:             \"challenge\", \"challenge\", \"\",\r\n 9999:             task=charter,\r\n10000:             context=_content)\r\n10001:         # WP2 G-ADJ: a SUCCESSFUL challenge persists to a plan's challenges\r\n10002:         # sidecar; the dispatch gate then holds NON-review legs until each\r\n10003:         # recorded challenge is adjudicated\r\n10004:         # (record_context(kind='challenge_adjudication')). Raw text only â€”\r\n10005:         # findings are PROPOSALS for adjudication, never steering (d76).\r\n10006:         # target_kind='plan' attaches to the challenged plan itself; every\r\n10007:         # other target kind attaches to the CALLING shell's plan (derived\r\n10008:         # from EDP_HANDLE) â€” an artifact/spec_decision/assumption challenge\r\n10009:         # that persisted nowhere left G-ADJ with nothing to hold, so the\r\n10010:         # fix-the-findings dispatch sailed through unadjudicated.\r\n10011:         if getattr(res, \"ok\", False):\r\n10012:             # ToolOk.data is a plain dict (the contracts layer dumps the\r\n10013:             # payload model); read it as one.\r\n10014:             payload = (res.data if isinstance(res.data, dict)\r\n10015:                        else res.data.model_dump())\r\n10016:             if payload.get(\"ok\"):\r\n10017:                 if m.target_kind == \"plan\":\r\n10018:                     plan_id = m.target_id\r\n10019:                 else:\r\n10020:                     # planner handle is `<recipe>:<step>`; its plan_id is the\r\n10021:                     # dash form (channels.member_channels seeds the same map)\r\n10022:                     handle = os.environ.get(\"EDP_HANDLE\", \"\").strip()\r\n10023:                     if \":\" in handle:\r\n10024:                         recipe, step = handle.rsplit(\":\", 1)\r\n10025:                         plan_id = f\"{recipe}-{step}\"\r\n10026:                     else:\r\n10027:                         plan_id = handle or None\r\n10028:                     if plan_id and not self.ctx.plans.exists(plan_id):\r\n10029:                         plan_id = None\r\n10030:                 if plan_id is not None:\r\n10031:                     challenge_id = str(uuid.uuid4())\r\n10032:                     _append_challenge(self.ctx.plans.root, plan_id, {\r\n10033:                         \"challenge_id\": challenge_id,\r\n10034:                         \"lens\": m.lens,\r\n10035:                         \"target_kind\": m.target_kind,\r\n10036:                         \"target_id\": m.target_id,\r\n10037:                         \"at\": _now().isoformat(),\r\n10038:                         \"findings_raw\": (payload.get(\"content\")\r\n10039:                                          or \"\")[:_CHALLENGE_FINDINGS_CAP],\r\n10040:                     })\r\n10041:                     if isinstance(res.data, dict):\r\n10042:                         res.data[\"challenge_id\"] = challenge_id\r\n10043:                     else:\r\n10044:                         res.data.challenge_id = challenge_id\r\n10045:         return res\r\n10046: \r\n10047: \r\n10048: # â”€â”€ reflex (v7 WS7, SHADOW.md Â§4) â€” the agent's window into its shadow â”€â”€â”€â”€â”€â”€\r\n10049: # A shadowed shell (EDP_SHADOW_NONCE set) performs NO lifecycle liturgy; its\r\n10050: # shadow runs the wiring. This tool is the SOVEREIGNTY seam: inspect the\r\n10051: # ledger, repair the wiring, take/return manual control â€” ~1 turn, only when\r\n10052: # something feels wrong. The ledger is written ONLY by the shadow; commands\r\n10053: # travel via the append-only cmd file it tails (no ports).\r\n10054: \r\n10055: def _shadow_paths() -> tuple[Path, Path] | None:\r\n10056:     from .sol_bridge import _now_iso  # noqa: F401 (import locality)\r\n10057:     d = os.environ.get(\"EDP_SHADOW_DIR\", \"\").strip()\r\n10058:     handle = (os.environ.get(\"EDP_HANDLE\", \"\").strip()\r\n10059:               or os.environ.get(\"EDP_ROLE\", \"\").strip())\r\n10060:     if not d or not handle:\r\n10061:         return None\r\n10062:     safe = \"\".join(c if c.isalnum() or c in \"-._\" else \"_\" for c in handle)\r\n10063:     base = Path(d)\r\n10064:     return base / f\"{safe}.json\", base / f\"{safe}.cmd.jsonl\"\r\n10065: \r\n10066: \r\n10067: class _ReflexIn(BaseModel):\r\n10068:     verb: Literal[\"status\", \"rearm\", \"observe\", \"pace\", \"silence\",\r\n10069:                   \"resume_auto\", \"wake_check\"]\r\n10070:     # verb=\"observe\": an EXTRA subscription spec (same rx DSL) the shadow\r\n10071:     # merges into its hosted driver.\r\n10072:     spec: str | None = None\r\n10073:     # verb=\"pace\": manual heartbeat override, seconds.\r\n10074:     interval_s: float | None = None\r\n10075:     # verb=\"wake_check\": did MY shadow send wake #seq? (verification, not\r\n10076:     # trust â€” the nonce covers provenance; this covers paranoia.)\r\n10077:     seq: int | None = None\r\n10078: \r\n10079: \r\n10080: class _ReflexOut(BaseModel):\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'claude/src/edp_claude/tools/sol_bridge.py'; \"'$c=Get-Content $f; for($i=0;$i -lt $c.Count;$i++){ '\"'{0,5}: {1}' -f (\"'$i+1),$c[$i] }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'claude/src/edp_claude/tools/sol_bridge.py'; \"'$c=Get-Content $f; for($i=0;$i -lt $c.Count;$i++){ '\"'{0,5}: {1}' -f (\"'$i+1),$c[$i] }'","aggregated_output":"    1: \"\"\"The deterministic Sol (GPT / codex CLI) bridge engine.\r\n    2: \r\n    3: WHY THIS EXISTS (user directive, 2026-07-16). Sol is reached through the OpenAI\r\n    4: Codex CLI, whose invocation has five landmines and a binary-selection trap that\r\n    5: a shell WILL get wrong (the reverse-engineered record is C:\\\\Projects\\\\NightSky\\\\\r\n    6: docs\\\\SOL-BRIDGE.md). This module hard-wires every one of them so the agent-facing\r\n    7: tools (`sol_author_asset`, `sol_consult` in tools/_tools.py) expose the MINIMUM\r\n    8: surface â€” even a Sonnet worker cannot mis-invoke Sol, because there is nothing to\r\n    9: mis-invoke: it passes a brief and a directory, and this engine builds the argv.\r\n   10: \r\n   11: WHAT IS HARD-WIRED HERE (nothing below is the agent's job):\r\n   12:   * BINARY SELECTION by the only rule that is stable across ChatGPT-app updates:\r\n   13:     the copy of `codex.exe` that has `codex-code-mode-host.exe` BESIDE it. The\r\n   14:     `.sandbox-bin` copy talks to Sol, exits 0, and CANNOT let Sol write a file â€”\r\n   15:     and the failure is silent unless you read stderr. Never selected here.\r\n   16:   * ARGV ORDER: exec globals BEFORE the subcommand; `-i` variadic on a fresh\r\n   17:     turn is terminated with `--`; `-i` is per-flag on resume (attaches to the\r\n   18:     post-resume prompt); the prompt is ALWAYS behind `--` so a brief that starts\r\n   19:     with `-` is never parsed as a flag.\r\n   20:   * EMPTY STDIN: the CLI hangs forever waiting for EOF on a non-TTY stdin. We\r\n   21:     always pass an empty stdin (DEVNULL) and the prompt as a positional argv\r\n   22:     element (the verified path â€” SOL-BRIDGE Â§2/Â§4).\r\n   23:   * FULL CAPTURE: stdout AND stderr merged into one JSONL blob, because the\r\n   24:     code-mode-host router error goes to stderr and never to `-o`.\r\n   25:   * NON-ZERO EXIT IS A FIRST-CLASS BLOCKER. Sol spend bills the user's ChatGPT\r\n   26:     plan quota and this CLI exposes NO rate-limit telemetry, so a cap is only\r\n   27:     discoverable on failure. `run_sol` NEVER retries, NEVER grinds, NEVER\r\n   28:     silently shrinks the request. It returns the failure for the tool to surface\r\n   29:     upward immediately.\r\n   30:   * SESSION STICKINESS: a thread id is persisted per (caller, advisor) so a long\r\n   31:     worker accretes one Sol thread instead of re-briefing from scratch, and can\r\n   32:     hold SEPARATE threads for separate advisors so context is not cross-polluted.\r\n   33:   * CODE-TREE GUARD (author path): Sol's write root (`-C`) is refused if it lands\r\n   34:     inside a protected code tree or names a source directory â€” Sol authors ASSETS,\r\n   35:     never code. `-s workspace-write` then confines every write to that one dir.\r\n   36: \r\n   37: This module is deliberately framework-agnostic and mostly PURE: `build_argv`,\r\n   38: `parse_events`, `resolve_codex_binary`, and `refuse_code_tree` take no ctx and do\r\n   39: no IO beyond a filesystem existence probe, so they are unit-tested without ever\r\n   40: calling Sol. Only `run_sol` spawns the subprocess.\r\n   41: \"\"\"\r\n   42: \r\n   43: import json\r\n   44: import os\r\n   45: import subprocess\r\n   46: import tempfile\r\n   47: import time\r\n   48: from dataclasses import dataclass, field\r\n   49: from pathlib import Path\r\n   50: \r\n   51: # â”€â”€ configuration seams (env-overridable; defaults match this machine) â”€â”€â”€â”€â”€â”€â”€\r\n   52: \r\n   53: #: Explicit binary override. When set it wins outright (still validated for the\r\n   54: #: host sibling below, so an override at the broken copy is refused loudly).\r\n   55: _ENV_BIN = \"EDP_SOL_CODEX_BIN\"\r\n   56: \r\n   57: #: The sibling that distinguishes the working copy from the broken `.sandbox-bin`\r\n   58: #: one. Its ABSENCE is the whole bug â€” Sol can talk but not write.\r\n   59: _HOST_SIBLING = \"codex-code-mode-host.exe\"\r\n   60: \r\n   61: #: Where to search when no override is set. `~/.codex` holds every app-managed\r\n   62: #: copy; we pick the one with the host beside it, preferring the appserver path.\r\n   63: _SEARCH_ROOT_ENV = \"CODEX_HOME\"\r\n   64: \r\n   65: #: Per-(caller, advisor) thread store. Under the agent home so every pool-spawned\r\n   66: #: shell in this stack shares it.\r\n   67: _THREADS_ENV = \"EDP_SOL_THREADS_FILE\"\r\n   68: \r\n   69: #: Wall-clock ceiling for a single Sol turn. A real asset turn ran ~6 min\r\n   70: #: (SOL-BRIDGE Â§3); 15 min leaves headroom. On timeout we KILL and surface a\r\n   71: #: blocker â€” never a silent retry.\r\n   72: _TIMEOUT_ENV = \"EDP_SOL_TIMEOUT_SECS\"\r\n   73: _TIMEOUT_DEFAULT = 900.0\r\n   74: \r\n   75: #: Windows caps a command line near 32 KB. The prompt rides as one argv element\r\n   76: #: (the verified path), so guard well under that; a longer brief is refused with\r\n   77: #: an actionable message rather than truncated.\r\n   78: _PROMPT_MAX_BYTES = 30000\r\n   79: \r\n   80: #: Protected code trees: Sol's `-C` write root may not land inside any of these.\r\n   81: #: The framework repo and the user's read-only Codex working tree (SOL-BRIDGE Â§7)\r\n   82: #: are always protected; extend via EDP_SOL_CODE_ROOTS (os.pathsep-separated).\r\n   83: _CODE_ROOTS_ENV = \"EDP_SOL_CODE_ROOTS\"\r\n   84: _DEFAULT_CODE_ROOTS = (\r\n   85:     r\"C:\\Projects\\Learning\\eda-base3\",\r\n   86:     r\"C:\\Users\\aksou\\Documents\\Codex\",\r\n   87: )\r\n   88: \r\n   89: #: Directory names that mean \"source\", never \"asset\". A `-C` target that IS one\r\n   90: #: of these (or sits directly under a repo root as one) is refused.\r\n   91: _CODE_DIR_NAMES = frozenset({\r\n   92:     \"src\", \"source\", \"lib\", \"libs\", \"tests\", \"test\", \"node_modules\",\r\n   93:     \"scripts\", \"__pycache__\", \".git\", \".venv\", \"site-packages\",\r\n   94: })\r\n   95: \r\n   96: \r\n   97: # â”€â”€ binary selection â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n   98: class SolBridgeError(RuntimeError):\r\n   99:     \"\"\"A precondition the engine refuses to proceed past (bad binary, bad write\r\n  100:     target, oversized prompt). The tool layer turns this into a TOOL_PRECONDITION\r\n  101:     ToolError â€” never a raised exception across the MCP boundary.\"\"\"\r\n  102: \r\n  103: \r\n  104: def _has_host_sibling(codex_exe: Path) -> bool:\r\n  105:     return (codex_exe.parent / _HOST_SIBLING).is_file()\r\n  106: \r\n  107: \r\n  108: def resolve_codex_binary() -> Path:\r\n  109:     \"\"\"The one `codex.exe` that can actually let Sol WRITE â€” i.e. the copy with\r\n  110:     `codex-code-mode-host.exe` beside it. Selection rule, never a hard-coded path\r\n  111:     (the ChatGPT app moves these on update; SOL-BRIDGE Â§2).\r\n  112: \r\n  113:     Order: explicit env override (still validated) â†’ the appserver path â†’\r\n  114:     a recursive scan under ~/.codex for any codex.exe with the host beside it.\r\n  115:     Raises SolBridgeError naming the fix if none qualifies. NEVER returns the\r\n  116:     `.sandbox-bin` copy.\r\n  117:     \"\"\"\r\n  118:     override = os.environ.get(_ENV_BIN, \"\").strip()\r\n  119:     if override:\r\n  120:         p = Path(override)\r\n  121:         if not p.is_file():\r\n  122:             raise SolBridgeError(\r\n  123:                 f\"{_ENV_BIN}={override!r} does not exist. Point it at the \"\r\n  124:                 f\"codex.exe that has {_HOST_SIBLING} beside it, or unset it to \"\r\n  125:                 f\"auto-resolve.\")\r\n  126:         if not _has_host_sibling(p):\r\n  127:             raise SolBridgeError(\r\n  128:                 f\"{_ENV_BIN}={override!r} has no {_HOST_SIBLING} beside it â€” it \"\r\n  129:                 f\"is the copy that can TALK to Sol but cannot let Sol write \"\r\n  130:                 f\"files (the write failure is silent). Pick the copy with the \"\r\n  131:                 f\"host sibling.\")\r\n  132:         return p\r\n  133: \r\n  134:     home = os.environ.get(_SEARCH_ROOT_ENV) or str(Path.home() / \".codex\")\r\n  135:     root = Path(home)\r\n  136:     preferred = root / \"plugins\" / \".plugin-appserver\" / \"codex.exe\"\r\n  137:     if preferred.is_file() and _has_host_sibling(preferred):\r\n  138:         return preferred\r\n  139: \r\n  140:     # Fall back to a scan: the FIRST codex.exe with the host beside it. Sorted so\r\n  141:     # the choice is deterministic across runs.\r\n  142:     if root.is_dir():\r\n  143:         for exe in sorted(root.rglob(\"codex.exe\")):\r\n  144:             if _has_host_sibling(exe):\r\n  145:                 return exe\r\n  146: \r\n  147:     raise SolBridgeError(\r\n  148:         f\"no working codex.exe found under {root} â€” need one with \"\r\n  149:         f\"{_HOST_SIBLING} beside it (the copy that can let Sol WRITE files; the \"\r\n  150:         f\".sandbox-bin copy cannot and must not be used). Set {_ENV_BIN} to the \"\r\n  151:         f\"correct path, or check that the ChatGPT/Codex app is installed.\")\r\n  152: \r\n  153: \r\n  154: # â”€â”€ code-tree guard (author path only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  155: def _code_roots() -> list[Path]:\r\n  156:     roots = list(_DEFAULT_CODE_ROOTS)\r\n  157:     extra = os.environ.get(_CODE_ROOTS_ENV, \"\").strip()\r\n  158:     if extra:\r\n  159:         roots += [r for r in extra.split(os.pathsep) if r.strip()]\r\n  160:     out: list[Path] = []\r\n  161:     for r in roots:\r\n  162:         try:\r\n  163:             out.append(Path(r).resolve())\r\n  164:         except (OSError, ValueError):\r\n  165:             continue\r\n  166:     return out\r\n  167: \r\n  168: \r\n  169: def _is_within(child: Path, parent: Path) -> bool:\r\n  170:     try:\r\n  171:         child.relative_to(parent)\r\n  172:         return True\r\n  173:     except ValueError:\r\n  174:         return False\r\n  175: \r\n  176: \r\n  177: def refuse_code_tree(asset_dir: str) -> Path:\r\n  178:     \"\"\"Validate `asset_dir` as a place Sol may WRITE assets â€” and refuse it if it\r\n  179:     is (or is inside) a protected code tree, or names a source directory. Returns\r\n  180:     the resolved absolute Path on success.\r\n  181: \r\n  182:     This is the structural guarantee behind the user's rule that Sol never\r\n  183:     touches code: `-C` confines every Sol write to this directory, and this guard\r\n  184:     refuses to let that directory be a code location in the first place. PURE\r\n  185:     apart from `.resolve()` (which does not require the path to exist).\r\n  186:     \"\"\"\r\n  187:     if not asset_dir or not str(asset_dir).strip():\r\n  188:         raise SolBridgeError(\"asset_dir is required â€” it is Sol's write root.\")\r\n  189:     p = Path(asset_dir)\r\n  190:     if not p.is_absolute():\r\n  191:         raise SolBridgeError(\r\n  192:             f\"asset_dir must be ABSOLUTE (the MCP server's cwd is not yours): \"\r\n  193:             f\"{asset_dir!r}\")\r\n  194:     resolved = p.resolve()\r\n  195: \r\n  196:     for root in _code_roots():\r\n  197:         if resolved == root or _is_within(resolved, root):\r\n  198:             raise SolBridgeError(\r\n  199:                 f\"asset_dir {resolved} is inside a protected code tree ({root}). \"\r\n  200:                 f\"Sol authors ASSETS, never code â€” point -C at a dedicated asset \"\r\n  201:                 f\"directory OUTSIDE the source tree (e.g. an assets/ folder in \"\r\n  202:                 f\"the target project). Extend {_CODE_ROOTS_ENV} to protect more.\")\r\n  203: \r\n  204:     lowered = {seg.lower() for seg in resolved.parts}\r\n  205:     hit = lowered & _CODE_DIR_NAMES\r\n  206:     if hit:\r\n  207:         raise SolBridgeError(\r\n  208:             f\"asset_dir {resolved} contains a source directory ({sorted(hit)}). \"\r\n  209:             f\"Sol authors assets only â€” choose an asset directory whose path has \"\r\n  210:             f\"no source segment ({sorted(_CODE_DIR_NAMES)}).\")\r\n  211:     return resolved\r\n  212: \r\n  213: \r\n  214: # â”€â”€ thread store (session stickiness per caller+advisor) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  215: def _threads_file() -> Path:\r\n  216:     override = os.environ.get(_THREADS_ENV, \"\").strip()\r\n  217:     if override:\r\n  218:         return Path(override)\r\n  219:     home = os.environ.get(\"EDP_AGENT_HOME\") or os.getcwd()\r\n  220:     return Path(home) / \".sol\" / \"threads.json\"\r\n  221: \r\n  222: \r\n  223: def thread_key(caller: str, advisor: str) -> str:\r\n  224:     \"\"\"The stickiness key. `caller` is the shell's EDP_HANDLE (or role when it has\r\n  225:     none, e.g. the neuron); `advisor` names the Sol thread, so one caller can hold\r\n  226:     SEPARATE threads for separate advisors and never cross-pollute their context.\"\"\"\r\n  227:     return f\"{(caller or 'anon').strip()}|{(advisor or 'sol').strip()}\"\r\n  228: \r\n  229: \r\n  230: def load_thread(caller: str, advisor: str) -> str | None:\r\n  231:     f = _threads_file()\r\n  232:     if not f.is_file():\r\n  233:         return None\r\n  234:     try:\r\n  235:         data = json.loads(f.read_text(encoding=\"utf-8\"))\r\n  236:     except (OSError, json.JSONDecodeError):\r\n  237:         return None\r\n  238:     row = data.get(thread_key(caller, advisor))\r\n  239:     return (row or {}).get(\"thread_id\") if isinstance(row, dict) else None\r\n  240: \r\n  241: \r\n  242: def save_thread(caller: str, advisor: str, thread_id: str, workdir: str) -> None:\r\n  243:     \"\"\"Persist (caller, advisor) -> thread_id atomically. Last-writer-wins per\r\n  244:     key; keys are per-caller so concurrent shells rarely collide.\"\"\"\r\n  245:     if not thread_id:\r\n  246:         return\r\n  247:     f = _threads_file()\r\n  248:     f.parent.mkdir(parents=True, exist_ok=True)\r\n  249:     data: dict = {}\r\n  250:     if f.is_file():\r\n  251:         try:\r\n  252:             data = json.loads(f.read_text(encoding=\"utf-8\")) or {}\r\n  253:         except (OSError, json.JSONDecodeError):\r\n  254:             data = {}\r\n  255:     key = thread_key(caller, advisor)\r\n  256:     prior = data.get(key) if isinstance(data.get(key), dict) else {}\r\n  257:     data[key] = {\r\n  258:         \"thread_id\": thread_id,\r\n  259:         \"workdir\": workdir,\r\n  260:         \"created_at\": prior.get(\"created_at\") or _now_iso(),\r\n  261:         \"last_used\": _now_iso(),\r\n  262:     }\r\n  263:     # F38#8: a UNIQUE temp name per writer â€” the old shared `.json.tmp`\r\n  264:     # meant two concurrent finishers raced the same file (one replace wins,\r\n  265:     # the other loses its key or hits FileNotFoundError AFTER a paid,\r\n  266:     # successful provider turn). Last-writer-wins per whole-file stays the\r\n  267:     # accepted model (keys are per-caller, collisions rare); losing a\r\n  268:     # last_used refresh is harmless, losing the RESULT is not â€” callers\r\n  269:     # additionally wrap this in try/except (run_sol) so persistence can\r\n  270:     # never fail the turn.\r\n  271:     tmp = f.with_suffix(f\".{os.getpid()}.{time.time_ns()}.tmp\")\r\n  272:     tmp.write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\r\n  273:     os.replace(tmp, f)\r\n  274: \r\n  275: \r\n  276: def _now_iso() -> str:\r\n  277:     return time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\r\n  278: \r\n  279: \r\n  280: # â”€â”€ argv construction (PURE) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  281: _SANDBOX_VALUES = (\"read-only\", \"workspace-write\", \"danger-full-access\")\r\n  282: \r\n  283: \r\n  284: def build_argv(\r\n  285:     codex: str,\r\n  286:     *,\r\n  287:     prompt: str,\r\n  288:     workdir: str,\r\n  289:     sandbox: str,\r\n  290:     last_message_file: str,\r\n  291:     images: list[str] | None = None,\r\n  292:     resume_thread: str | None = None,\r\n  293:     effort: str | None = None,\r\n  294:     model: str | None = None,\r\n  295: ) -> list[str]:\r\n  296:     \"\"\"The complete, landmine-safe argv for one Sol turn. PURE â€” no IO.\r\n  297: \r\n  298:     Fresh turn:   codex exec <globals> [-i img... --] -- <prompt>\r\n  299:     Resume turn:  codex exec <globals> resume [-i img]* -- <thread_id> <prompt>\r\n  300: \r\n  301:     Globals (exec-level, BEFORE any subcommand): --skip-git-repo-check, -C, -s,\r\n  302:     --json, --color never, -o, and an optional -c model_reasoning_effort=. The\r\n  303:     prompt is ALWAYS the last positional behind `--` so a leading '-' is safe.\r\n  304:     On a FRESH turn `-i` is variadic and MUST be terminated by `--`; on RESUME\r\n  305:     `-i` is per-flag and attaches to the post-resume prompt, so it sits AFTER the\r\n  306:     `resume` subcommand.\r\n  307:     \"\"\"\r\n  308:     if sandbox not in _SANDBOX_VALUES:\r\n  309:         raise SolBridgeError(\r\n  310:             f\"sandbox must be one of {_SANDBOX_VALUES}, got {sandbox!r}\")\r\n  311:     imgs = [i for i in (images or []) if i]\r\n  312: \r\n  313:     argv = [codex, \"exec\", \"--skip-git-repo-check\",\r\n  314:             \"-C\", workdir, \"-s\", sandbox, \"--json\", \"--color\", \"never\",\r\n  315:             \"-o\", last_message_file]\r\n  316:     # F38#1: the registry's model pin actually reaches the CLI. Without -m\r\n  317:     # the CLI runs its own default while the bridge reports the pinned id â€”\r\n  318:     # every audit row and cost comparison then lies about the model.\r\n  319:     if model:\r\n  320:         argv += [\"-m\", model]\r\n  321:     if effort:\r\n  322:         argv += [\"-c\", f\"model_reasoning_effort={effort}\"]\r\n  323: \r\n  324:     if resume_thread:\r\n  325:         argv.append(\"resume\")\r\n  326:         for img in imgs:                       # resume -i is per-flag, not variadic\r\n  327:             argv += [\"-i\", img]\r\n  328:         argv += [\"--\", resume_thread, prompt]\r\n  329:     else:\r\n  330:         if imgs:                               # fresh -i is variadic â†’ terminate it\r\n  331:             argv.append(\"-i\")\r\n  332:             argv += imgs\r\n  333:         argv += [\"--\", prompt]\r\n  334:     return argv\r\n  335: \r\n  336: \r\n  337: # â”€â”€ event-stream parsing (PURE) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  338: @dataclass\r\n  339: class SolRun:\r\n  340:     \"\"\"The structured result of one Sol turn. `ok` is the ONLY thing a caller\r\n  341:     must branch on: False means surface a blocker upward and STOP (do not retry).\r\n  342:     \"\"\"\r\n  343:     ok: bool\r\n  344:     exit_code: int\r\n  345:     thread_id: str | None\r\n  346:     agent_messages: list[str] = field(default_factory=list)\r\n  347:     file_changes: list[str] = field(default_factory=list)\r\n  348:     last_message: str = \"\"\r\n  349:     error: str | None = None\r\n  350:     raw_path: str | None = None\r\n  351:     argv: list[str] = field(default_factory=list)\r\n  352: \r\n  353: \r\n  354: def parse_events(jsonl_text: str) -> dict:\r\n  355:     \"\"\"Best-effort structured read of the `--json` event stream. Defensive by\r\n  356:     design: the CLI exposes no stable schema and this must never raise on a line\r\n  357:     it does not recognise. Extracts the thread id, agent message texts, and any\r\n  358:     file-change item paths, and flags the code-mode-host router error (which\r\n  359:     means the WRONG binary reached Sol â€” a talk-but-cannot-write failure).\"\"\"\r\n  360:     thread_id: str | None = None\r\n  361:     messages: list[str] = []\r\n  362:     files: list[str] = []\r\n  363:     host_error = False\r\n  364: \r\n  365:     def _walk_for_text(obj) -> str | None:\r\n  366:         if isinstance(obj, str):\r\n  367:             return obj\r\n  368:         if isinstance(obj, dict):\r\n  369:             for k in (\"text\", \"message\", \"content\"):\r\n  370:                 v = obj.get(k)\r\n  371:                 s = _walk_for_text(v)\r\n  372:                 if s:\r\n  373:                     return s\r\n  374:         if isinstance(obj, list):\r\n  375:             parts = [p for p in (_walk_for_text(x) for x in obj) if p]\r\n  376:             return \"\\n\".join(parts) if parts else None\r\n  377:         return None\r\n  378: \r\n  379:     for line in jsonl_text.splitlines():\r\n  380:         line = line.strip()\r\n  381:         if not line:\r\n  382:             continue\r\n  383:         if \"failed to spawn code-mode host\" in line:\r\n  384:             host_error = True\r\n  385:         if not (line.startswith(\"{\") or line.startswith(\"[\")):\r\n  386:             continue\r\n  387:         try:\r\n  388:             ev = json.loads(line)\r\n  389:         except json.JSONDecodeError:\r\n  390:             continue\r\n  391:         if not isinstance(ev, dict):\r\n  392:             continue\r\n  393:         # thread id: seen on thread.started; accept it wherever it appears\r\n  394:         for k in (\"thread_id\", \"threadId\", \"session_id\", \"sessionId\"):\r\n  395:             if isinstance(ev.get(k), str) and not thread_id:\r\n  396:                 thread_id = ev[k]\r\n  397:         nested = ev.get(\"thread\") if isinstance(ev.get(\"thread\"), dict) else None\r\n  398:         if nested and isinstance(nested.get(\"id\"), str) and not thread_id:\r\n  399:             thread_id = nested[\"id\"]\r\n  400: \r\n  401:         etype = str(ev.get(\"type\", \"\"))\r\n  402:         item = ev.get(\"item\") if isinstance(ev.get(\"item\"), dict) else None\r\n  403:         if \"item\" in etype and item is not None:\r\n  404:             itype = str(item.get(\"type\", \"\") or item.get(\"item_type\", \"\"))\r\n  405:             if any(m in itype for m in (\"message\", \"agent\", \"assistant\")):\r\n  406:                 txt = _walk_for_text(item)\r\n  407:                 if txt:\r\n  408:                     messages.append(txt)\r\n  409:             if any(m in itype for m in (\"file\", \"patch\", \"apply\")):\r\n  410:                 for pk in (\"path\", \"file\", \"target\"):\r\n  411:                     if isinstance(item.get(pk), str):\r\n  412:                         files.append(item[pk])\r\n  413:         elif any(m in etype for m in (\"agent_message\", \"assistant\")):\r\n  414:             txt = _walk_for_text(ev)\r\n  415:             if txt:\r\n  416:                 messages.append(txt)\r\n  417: \r\n  418:     return {\"thread_id\": thread_id, \"messages\": messages,\r\n  419:             \"files\": files, \"host_error\": host_error}\r\n  420: \r\n  421: \r\n  422: # â”€â”€ the one impure entrypoint â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  423: def run_sol(\r\n  424:     *,\r\n  425:     prompt: str,\r\n  426:     workdir: str,\r\n  427:     sandbox: str,\r\n  428:     caller: str,\r\n  429:     advisor: str = \"sol\",\r\n  430:     images: list[str] | None = None,\r\n  431:     effort: str | None = None,\r\n  432:     new_thread: bool = False,\r\n  433:     timeout_secs: float | None = None,\r\n  434:     model: str | None = None,\r\n  435: ) -> SolRun:\r\n  436:     \"\"\"Run ONE Sol turn and return a structured SolRun. Resumes the sticky thread\r\n  437:     for (caller, advisor) when one exists (unless `new_thread`), else starts a\r\n  438:     fresh thread and persists its id. NEVER retries and NEVER shrinks the request:\r\n  439:     a non-zero exit, a timeout, or the code-mode-host router error each return\r\n  440:     `ok=False` with `error` set, for the tool to surface upward immediately.\r\n  441: \r\n  442:     Raises SolBridgeError only for PRECONDITIONS the caller can fix (missing\r\n  443:     binary, oversized prompt, bad sandbox) â€” the tool converts those to a\r\n  444:     TOOL_PRECONDITION. A genuine Sol/quota FAILURE is a returned SolRun(ok=False),\r\n  445:     not an exception.\r\n  446:     \"\"\"\r\n  447:     if not prompt or not prompt.strip():\r\n  448:         raise SolBridgeError(\"prompt is empty â€” nothing to send to Sol.\")\r\n  449:     if len(prompt.encode(\"utf-8\")) > _PROMPT_MAX_BYTES:\r\n  450:         raise SolBridgeError(\r\n  451:             f\"prompt is {len(prompt.encode('utf-8'))} bytes; the CLI passes it \"\r\n  452:             f\"as one argv element and Windows caps the command line near 32 KB. \"\r\n  453:             f\"Keep the brief under {_PROMPT_MAX_BYTES} bytes (link large context \"\r\n  454:             f\"as files Sol can read from its -C workspace instead).\")\r\n  455:     for img in (images or []):\r\n  456:         if not Path(img).is_file():\r\n  457:             raise SolBridgeError(\r\n  458:                 f\"image {img!r} does not exist â€” attaching is the ONLY way an \"\r\n  459:                 f\"image reaches Sol (citing a path in the prompt is a no-op), so \"\r\n  460:                 f\"a missing file is a hard error, not a warning.\")\r\n  461: \r\n  462:     codex = str(resolve_codex_binary())\r\n  463:     resume_thread = None if new_thread else load_thread(caller, advisor)\r\n  464: \r\n  465:     work = Path(workdir)\r\n  466:     work.mkdir(parents=True, exist_ok=True)\r\n  467:     # F38#3: PER-INVOCATION output files. The old fixed `.sol-last-message\r\n  468:     # .txt` was shared by every call in the same delegate workdir, so a\r\n  469:     # concurrent (or stale prior) turn's answer could be read back as THIS\r\n  470:     # call's result â€” the worst kind of wrong (a plausible answer to a\r\n  471:     # different question). Unique names isolate the read; stale files also\r\n  472:     # can't survive because the destination never pre-exists.\r\n  473:     run_tag = f\"{os.getpid()}-{time.time_ns()}\"\r\n  474:     last_msg = work / f\".sol-last-message-{run_tag}.txt\"\r\n  475:     last_msg.unlink(missing_ok=True)\r\n  476:     # bound the per-run artifact accumulation: sweep run files older than\r\n  477:     # 7 days (best-effort; the raw stream is evidence, not a store).\r\n  478:     _cutoff = time.time() - 7 * 24 * 3600\r\n  479:     for pat in (\".sol-last-message-*.txt\", \".sol-run-*.jsonl\"):\r\n  480:         for old in work.glob(pat):\r\n  481:             try:\r\n  482:                 if old.stat().st_mtime < _cutoff:\r\n  483:                     old.unlink()\r\n  484:             except OSError:\r\n  485:                 pass\r\n  486: \r\n  487:     argv = build_argv(\r\n  488:         codex, prompt=prompt, workdir=str(work), sandbox=sandbox,\r\n  489:         last_message_file=str(last_msg), images=images,\r\n  490:         resume_thread=resume_thread, effort=effort, model=model)\r\n  491: \r\n  492:     timeout = timeout_secs or float(os.environ.get(_TIMEOUT_ENV, _TIMEOUT_DEFAULT))\r\n  493:     raw = \"\"\r\n  494:     try:\r\n  495:         proc = subprocess.run(\r\n  496:             argv, stdin=subprocess.DEVNULL,     # empty stdin => instant EOF\r\n  497:             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,  # merge: host error is on stderr\r\n  498:             timeout=timeout, text=True, encoding=\"utf-8\", errors=\"replace\")\r\n  499:         raw = proc.stdout or \"\"\r\n  500:         exit_code = proc.returncode\r\n  501:     except subprocess.TimeoutExpired as e:\r\n  502:         raw = (e.stdout or \"\") if isinstance(e.stdout, str) else \"\"\r\n  503:         return SolRun(\r\n  504:             ok=False, exit_code=124, thread_id=resume_thread, argv=argv,\r\n  505:             error=(f\"Sol turn exceeded {timeout:.0f}s and was killed. This is a \"\r\n  506:                    f\"first-class blocker: surface it upward, do NOT retry-loop \"\r\n  507:                    f\"(Sol spend bills the user's ChatGPT plan quota).\"))\r\n  508:     except (OSError, ValueError) as e:\r\n  509:         return SolRun(ok=False, exit_code=-1, thread_id=resume_thread, argv=argv,\r\n  510:                       error=f\"could not launch codex ({e}).\")\r\n  511: \r\n  512:     # persist the raw stream as evidence (stdout+stderr merged; per-run\r\n  513:     # name â€” F38#3, same isolation as the last-message file)\r\n  514:     raw_path = work / f\".sol-run-{run_tag}.jsonl\"\r\n  515:     try:\r\n  516:         raw_path.write_text(raw, encoding=\"utf-8\")\r\n  517:     except OSError:\r\n  518:         raw_path = None\r\n  519: \r\n  520:     parsed = parse_events(raw)\r\n  521:     tid = parsed[\"thread_id\"] or resume_thread\r\n  522:     last_message = \"\"\r\n  523:     if last_msg.is_file():\r\n  524:         try:\r\n  525:             last_message = last_msg.read_text(encoding=\"utf-8\").strip()\r\n  526:         except OSError:\r\n  527:             last_message = \"\"\r\n  528: \r\n  529:     if parsed[\"host_error\"]:\r\n  530:         return SolRun(\r\n  531:             ok=False, exit_code=exit_code, thread_id=tid, argv=argv,\r\n  532:             raw_path=str(raw_path) if raw_path else None,\r\n  533:             agent_messages=parsed[\"messages\"], file_changes=parsed[\"files\"],\r\n  534:             last_message=last_message,\r\n  535:             error=(\"Sol reached but the code-mode host failed to spawn â€” the \"\r\n  536:                    \"WRONG codex binary was used (talk-but-cannot-write). No file \"\r\n  537:                    \"was written. This is a bridge bug, not a Sol failure; report \"\r\n  538:                    \"it â€” do not retry.\"))\r\n  539: \r\n  540:     if exit_code != 0:\r\n  541:         return SolRun(\r\n  542:             ok=False, exit_code=exit_code, thread_id=tid, argv=argv,\r\n  543:             raw_path=str(raw_path) if raw_path else None,\r\n  544:             agent_messages=parsed[\"messages\"], file_changes=parsed[\"files\"],\r\n  545:             last_message=last_message,\r\n  546:             error=(f\"codex exited {exit_code}. Treat as a first-class blocker \"\r\n  547:                    f\"(the CLI exposes no rate-limit telemetry, so a quota cap is \"\r\n  548:                    f\"only visible on failure): surface it upward immediately, do \"\r\n  549:                    f\"NOT retry-loop, grind, or silently shrink the request. \"\r\n  550:                    f\"Last message: {last_message[:400]!r}\"))\r\n  551: \r\n  552:     if tid:\r\n  553:         # F38#8: stickiness persistence is best-effort â€” a filesystem race\r\n  554:         # here must NEVER turn a paid, successful provider turn into an\r\n  555:         # exception. Worst case the next call starts a fresh thread.\r\n  556:         try:\r\n  557:             save_thread(caller, advisor, tid, str(work))\r\n  558:         except OSError:\r\n  559:             pass\r\n  560: \r\n  561:     return SolRun(\r\n  562:         ok=True, exit_code=0, thread_id=tid, argv=argv,\r\n  563:         raw_path=str(raw_path) if raw_path else None,\r\n  564:         agent_messages=parsed[\"messages\"], file_changes=parsed[\"files\"],\r\n  565:         last_message=last_message)\r\n","exit_code":0,"status":"completed"}}
