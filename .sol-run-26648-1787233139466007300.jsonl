{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'claude/tests/test_f38_round6.py'; \"'$c=Get-Content $f; for($i=0;$i -lt $c.Count;$i++){'\"'{0,4}: {1}' -f (\"'$i+1),$c[$i]}; $f='\"'claude/tests/test_bridge.py'; \"'$c=Get-Content $f; for($i=140;$i -lt [Math]::Min(175,$c.Count);$i++){'\"'{0,4}: {1}' -f (\"'$i+1),$c[$i]}'","aggregated_output":"   1: \"\"\"F38 (2026-08-18) â€” campaign Round 6 (delegation bridge & external seams).\r\n   2: \r\n   3: Pins the confirmed fixes: model-pin threading (-m), route-authorized\r\n   4: overrides, slot-lock liveness + ownership, recipe-scoped budget\r\n   5: attribution, findings-contract enforcement, CLI byte-cap preflight,\r\n   6: failed-call cost honesty, and seat-registry model governance.\r\n   7: \"\"\"\r\n   8: \r\n   9: import json\r\n  10: import os\r\n  11: import time\r\n  12: from pathlib import Path\r\n  13: \r\n  14: import pytest\r\n  15: \r\n  16: from edp_claude.tools import bridge as B\r\n  17: from edp_claude.tools import sol_bridge as SB\r\n  18: from edp_claude.tools._tools import (\r\n  19:     _bridge_delegate_for,\r\n  20:     _caller_recipe,\r\n  21:     _delegate_actuals,\r\n  22:     _registry_models,\r\n  23: )\r\n  24: \r\n  25: \r\n  26: # â”€â”€ #1 â€” the registry model pin reaches the CLI argv â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  27: def test_build_argv_threads_model_flag():\r\n  28:     argv = SB.build_argv(\r\n  29:         \"codex.exe\", prompt=\"p\", workdir=\"w\", sandbox=\"read-only\",\r\n  30:         last_message_file=\"o.txt\", model=\"gpt-5.6\")\r\n  31:     i = argv.index(\"-m\")\r\n  32:     assert argv[i + 1] == \"gpt-5.6\"\r\n  33:     # absent model â†’ no flag (the pool-config default governs)\r\n  34:     argv2 = SB.build_argv(\r\n  35:         \"codex.exe\", prompt=\"p\", workdir=\"w\", sandbox=\"read-only\",\r\n  36:         last_message_file=\"o.txt\")\r\n  37:     assert \"-m\" not in argv2\r\n  38: \r\n  39: \r\n  40: # â”€â”€ #2 â€” a delegate override must be routed for the caller's role â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  41: def _fake_config(monkeypatch):\r\n  42:     d = {\"sol\": B.Delegate(name=\"sol\", backend=\"cli\", model=\"gpt-5.6\"),\r\n  43:          \"costly\": B.Delegate(name=\"costly\", backend=\"http\",\r\n  44:                               model=\"x\", base_url=\"http://h\",\r\n  45:                               api_key_env=\"K\")}\r\n  46:     routes = {\"worker:generate\": \"sol\"}\r\n  47:     monkeypatch.setattr(B, \"load_config\", lambda: (d, routes))\r\n  48: \r\n  49: \r\n  50: def test_override_refused_when_not_routed_for_role(monkeypatch):\r\n  51:     _fake_config(monkeypatch)\r\n  52:     monkeypatch.setenv(\"EDP_ROLE\", \"worker\")\r\n  53:     with pytest.raises(B.BridgeError, match=\"not routed for role\"):\r\n  54:         _bridge_delegate_for(\"generate\", \"costly\")\r\n  55:     # a routed delegate may be named explicitly\r\n  56:     assert _bridge_delegate_for(\"generate\", \"sol\") == \"sol\"\r\n  57:     # the role-less operator console stays unconstrained\r\n  58:     monkeypatch.delenv(\"EDP_ROLE\", raising=False)\r\n  59:     assert _bridge_delegate_for(\"generate\", \"costly\") == \"costly\"\r\n  60: \r\n  61: \r\n  62: # â”€â”€ #4 â€” slot lock: staleness ceiling, dead-only reap, ownership nonce â”€â”€â”€â”€â”€\r\n  63: def test_slot_stale_threshold_exceeds_max_delegate_timeout():\r\n  64:     assert B._CLI_SLOT_STALE_S > 1800.0\r\n  65: \r\n  66: \r\n  67: def test_slot_release_honors_ownership_nonce(tmp_path, monkeypatch):\r\n  68:     monkeypatch.setenv(\"EDP_AGENT_HOME\", str(tmp_path))\r\n  69:     acquired = B._cli_slot_acquire()\r\n  70:     assert acquired is not None\r\n  71:     slot, nonce = acquired\r\n  72:     # a stale-holder release with the WRONG nonce must not remove the slot\r\n  73:     B._cli_slot_release(slot, \"someone-elses-nonce\")\r\n  74:     assert slot.is_dir()\r\n  75:     B._cli_slot_release(slot, nonce)\r\n  76:     assert not slot.exists()\r\n  77: \r\n  78: \r\n  79: def test_slot_reap_spares_aged_but_alive_owner(tmp_path, monkeypatch):\r\n  80:     monkeypatch.setenv(\"EDP_AGENT_HOME\", str(tmp_path))\r\n  81:     monkeypatch.setenv(B._CLI_MAX_ENV, \"1\")\r\n  82:     slots = tmp_path / \".bridge\" / \"cli-slots\"\r\n  83:     slots.mkdir(parents=True)\r\n  84:     slot = slots / \"slot-0.lock\"\r\n  85:     slot.mkdir()\r\n  86:     (slot / \"pid\").write_text(str(os.getpid()))   # alive: this process\r\n  87:     old = time.time() - B._CLI_SLOT_STALE_S - 60\r\n  88:     os.utime(slot, (old, old))\r\n  89:     monkeypatch.setattr(B, \"_CLI_SLOT_WAIT_S\", 0.1)\r\n  90:     assert B._cli_slot_acquire() is None          # aged AND alive â†’ not stolen\r\n  91:     (slot / \"pid\").write_text(\"999999999\")        # dead pid â†’ reapable\r\n  92:     os.utime(slot, (old, old))                    # rewrite refreshed dir mtime\r\n  93:     assert B._cli_slot_acquire() is not None\r\n  94: \r\n  95: \r\n  96: # â”€â”€ #5 â€” recipe-scoped budget attribution â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  97: def test_caller_recipe_derivation():\r\n  98:     assert _caller_recipe(\"r9-s1:a1\") == \"r9\"       # worker handle\r\n  99:     assert _caller_recipe(\"r9:s1\") == \"r9\"          # planner handle\r\n 100:     # F38 review: NO lineage shape â†’ unattributable, never a phantom recipe\r\n 101:     assert _caller_recipe(\"neuron\") is None          # role-name caller\r\n 102:     assert _caller_recipe(\"acceptor-369ca226\") is None\r\n 103:     assert _caller_recipe(\"curiosity-ab12cd34\") is None\r\n 104:     assert _caller_recipe(\"\") is None\r\n 105: \r\n 106: \r\n 107: def test_delegate_actuals_scopes_to_recipe(tmp_path):\r\n 108:     bdir = tmp_path / \".bridge\"\r\n 109:     bdir.mkdir(