nner\":\r\n11164:         # planner's inbox is its plan_id (dash form), not its EDP_HANDLE.\r\n11165:         return f\"{parent}-{tail}\", parent\r\n11166:     return handle, parent\r\n11167: \r\n11168: \r\n11169: def _sender_plan_id() -> str | None:\r\n11170:     \"\"\"The plan whose worklog should record an outbound message.\r\n11171:     planner â†’ its own plan_id; worker â†’ its plan_id (handle prefix);\r\n11172:     neuron â†’ None (no plan worklog; the receiver captures it on\r\n11173:     delivery). Used to make inter-shell comms VISIBLE in the worklog\r\n11174:     (2026-05-22: messages were invisible in scattered broker inboxes).\"\"\"\r\n11175:     role = os.environ.get(\"EDP_ROLE\", \"\").strip()\r\n11176:     me, parent = _self_and_parent_addresses()\r\n11177:     if role == \"planner\":\r\n11178:         return me       # plan_id (dash form)\r\n11179:     if role == \"worker\":\r\n11180:         return parent   # plan_id (handle prefix)\r\n11181:     return None\r\n11182: \r\n11183: \r\n11184: def _worklog_outbound(ctx, msg_kind: str, to: str, body: dict) -> None:\r\n11185:     pid = _sender_plan_id()\r\n11186:     if not pid:\r\n11187:         return  # neuron / unknown â€” captured on the receiver's side\r\n11188:     role = os.environ.get(\"EDP_ROLE\", \"\").strip() or \"unknown\"\r\n11189:     ctx.plans.append_worklog(pid, {\r\n11190:         \"kind\": \"message_sent\", \"agent_role\": role,\r\n   1: \"\"\"F39 (2026-08-20) â€” live pain report: the acceptor seat had no wiring\r\n   2: profile, so its card-mandated arm_wiring() refused and the whole acceptance\r\n   3: pass ran deaf (ask_above answers could never wake it).\r\n   4: \r\n   5: Pins the fix AND the class: every role whose toolset grants arm_wiring must\r\n   6: have a wiring spec + (non-reconcile roles) a reflex prompt.\r\n   7: \"\"\"\r\n   8: \r\n   9: import pytest\r\n  10: \r\n  11: from edp_claude.server import make_context\r\n  12: from edp_claude.tools import build_registry\r\n  13: from edp_claude.tools._tools import _WIRING_REFLEX_PROMPTS, _WIRING_SPECS\r\n  14: from edp_claude.tools.roles import ROLE_TOOLSETS\r\n  15: \r\n  16: pytestmark = pytest.mark.anyio\r\n  17: \r\n  18: \r\n  19: @pytest.fixture\r\n  20: def anyio_backend():\r\n  21:     return \"asyncio\"\r\n  22: \r\n  23: \r\n  24: def test_every_arm_wiring_role_has_a_wiring_profile():\r\n  25:     # the drift gate: granting the verb without the profile is exactly the\r\n  26:     # F39 deaf-acceptor defect.\r\n  27:     for role, toolset in ROLE_TOOLSETS.items():\r\n  28:         if \"arm_wiring\" not in toolset:\r\n  29:             continue\r\n  30:         assert role in _WIRING_SPECS, (\r\n  31:             f\"role {role!r} holds arm_wiring but _WIRING_SPECS has no \"\r\n  32:             \"profile â€” its card-mandated boot wiring would refuse and the \"\r\n  33:             \"shell runs deaf (the F39 acceptor defect).\")\r\n  34:         if role not in (\"neuron\", \"planner\"):    # reconcile roles use the\r\n  35:             assert role in _WIRING_REFLEX_PROMPTS, (   # canonical prompt\r\n  36:                 f\"role {role!r} has a wiring spec but no reflex cron \"\r\n  37:                 \"prompt â€” arm_wiring would KeyError composing cron_prompt.\")\r\n  38: \r\n  39: \r\n  40: async def test_acceptor_arm_wiring_returns_live_wiring(tmp_path, monkeypatch):\r\n  41:     monkeypatch.setenv(\"EDP_ROLE\", \"acceptor\")\r\n  42:     monkeypatch.setenv(\"EDP_HANDLE\", \"acceptor-deadbeef\")\r\n  43:     monkeypatch.setenv(\"EDP_ROLE_SCOPE\", \"enforce\")\r\n  44:     ctx = make_context(tmp_path)\r\n  45:     t = {x.name: x for x in build_registry(ctx)}\r\n  46:     res = await t[\"arm_wiring\"].run({})\r\n  47:     assert getattr(res, \"ok\", False), res\r\n  48:     d = res.data if isinstance(res.data, dict) else res.data.model_dump()\r\n  49:     assert d[\"spec\"] == \"rx.broker(me)\"\r\n  50:     assert d[\"monitor_cmd\"]\r\n  51:     assert \"check_inbox\" in d[\"cron_prompt\"]\r\n","exit_code":0,"status":"completed"}}
