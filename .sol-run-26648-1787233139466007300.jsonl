ately as `unattributed_cost_usd`, never\r\n10275:     charged to every recipe (the old fleet-global sum let recipe A's spend\r\n10276:     refuse recipe B's spawns). F38#7 â€” `audit_errors` counts unreadable\r\n10277:     sidecars so no caller can call the total complete after a read error.\"\"\"\r\n10278:     agg = {\"calls\": 0, \"tokens_in\": 0, \"tokens_out\": 0,\r\n10279:            \"cost_usd\": 0.0, \"failures\": 0, \"audit_errors\": 0,\r\n10280:            \"unattributed_cost_usd\": 0.0}\r\n10281:     try:\r\n10282:         files = sorted((home / \".bridge\").glob(\"audit-*.jsonl\"))\r\n10283:     except OSError:\r\n10284:         agg[\"audit_errors\"] += 1\r\n10285:         files = []\r\n10286:     for f in files:\r\n10287:         try:\r\n10288:             lines = f.read_text(encoding=\"utf-8\").splitlines()\r\n10289:         except OSError:\r\n10290:             agg[\"audit_errors\"] += 1\r\n10291:             continue\r\n10292:         for line in lines:\r\n10293:             try:\r\n10294:                 row = json.loads(line)\r\n10295:             except json.JSONDecodeError:\r\n10296:                 continue\r\n10297:             row_recipe = _caller_recipe(str(row.get(\"caller\") or \"\"))\r\n10298:             if recipe_id is not None:\r\n10299:                 if row_recipe is None:\r\n10300:                     agg[\"unattributed_cost_usd\"] += float(\r\n10301:                         row.get(\"cost_usd\", 0.0))\r\n10302:                     continue\r\n10303:                 if row_recipe != recipe_id:\r\n10304:                     continue\r\n10305:             agg[\"calls\"] += 1\r\n10306:             agg[\"tokens_in\"] += int(row.get(\"tokens_in\", 0))\r\n10307:             agg[\"tokens_out\"] += int(row.get(\"tokens_out\", 0))\r\n10308:             agg[\"cost_usd\"] += float(row.get(\"cost_usd\", 0.0))\r\n10309:             if not row.get(\"ok\", True):\r\n10310:                 agg[\"failures\"] += 1\r\n10311:     agg[\"cost_usd\"] = round(agg[\"cost_usd\"], 4)\r\n10312:     agg[\"unattributed_cost_usd\"] = round(agg[\"unattributed_cost_usd\"], 4)\r\n10313:     return agg\r\n10314: \r\n10315: \r\n10316: # WP2 G-BUDGET: the warn threshold â€” >=80% of either measurable bound.\r\n10317: _BUDGET_WARN_FRACTION = 0.8\r\n10318: \r\n10319: \r\n10320: def _budget_check(ctx, recipe_id: str) -> dict:\r\n10321:     \"\"\"WP2 G-BUDGET â€” {level: 'ok'|'warn'|'exceeded', detail} for a recipe's\r\n10322:     MEASURABLE budget bounds: delegate USD (vs the .bridge audit sums â€”\r\n10323:     BudgetStatus's own aggregation) and wall-clock hours (vs created_atâ†’now).\r\n10324:     claude_tokens is deliberately NOT judged here â€” it is unmeasured without\r\n10325:     the telemetry backend, and a gate on a number nobody measured would be a\r\n10326:     lie (the BudgetStatus honesty-field doctrine). No budget on the recipe â†’\r\n10327:     'ok' (legacy). Deterministic; code only.\"\"\"\r\n10328:     try:\r\n10329:         if not (recipe_id and ctx.recipes.exists(recipe_id)):\r\n10330:             return {\"level\": \"ok\", \"detail\": \"\"}\r\n10331:         r = ctx.recipes.load(recipe_id)\r\n10332:     except Exception:  # noqa: BLE001 â€” an unreadable recipe is not a gate\r\n10333:         return {\"level\": \"ok\", \"detail\": \"\"}\r\n10334:     budget = r.budget or {}\r\n10335:     used: list[tuple[str, float, float]] = []   # (name, spent, bound)\r\n","exit_code":0,"status":"completed"}}
