{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'claude/src/edp_claude/objects.py'; \"'$c=Get-Content $f; Select-String -Path $f -Pattern '\"'\"'^async def create_object|''^async def update_object|''^async def delete_object|def _create|if obj_type == \"action\"|if type == \"action\"'\"' | ForEach-Object {\\\"\"'$($_.LineNumber):$($_.Line)\"}; for($i=330;$i -lt 520;$i++){'\"'{0,5}: {1}' -f (\"'$i+1),$c[$i]}'","aggregated_output":"631:    if obj_type == \"action\":\r\n836:    if obj_type == \"action\":\r\n990:async def create_object(ctx, obj_type: str, fields: dict | None = None) -> dict:\r\n1005:    if obj_type == \"action\":\r\n1028:async def update_object(ctx, obj_type: str, ids: dict | None = None,\r\n1047:    if obj_type == \"action\":\r\n1344:async def delete_object(ctx, obj_type: str, ids: dict | None = None,\r\n1354:    if obj_type == \"action\":\r\n  331:         \"READ the owning object (`read_object` / `query_objects` / \"\r\n  332:         \"`reconcile`); never assert it from assumption or stale memory. \"\r\n  333:         \"Targeted, NOT a poll: only the few load-bearing claims, where one \"\r\n  334:         \"cheap read is the ground truth (so it never burns tokens on every \"\r\n  335:         \"claim). The read-side twin of settled decisions reaching the worker \"\r\n  336:         \"(see `action.injected_context`).\",\r\n  337:         \"\",\r\n  338:         \"**\\\"Is my worker alive / queued / done / dead?\\\"** No single field \"\r\n  339:         \"says it â€” COMPOSE (this is the exact thing not to re-derive by \"\r\n  340:         \"hand every wait):\",\r\n  341:         \"- done/failed â†’ the `action`'s `status` (+ its `acceptance_\"\r\n  342:         \"verified` worklog line). `rx.worklog` WAKES you on it.\",\r\n  343:         \"- alive-and-working â†’ action `in_progress` + `session` \"\r\n  344:         \"`liveness=alive` (writes nothing for minutes during a reasoning \"\r\n  345:         \"block â€” that is NOT hung; never force-fail it).\",\r\n  346:         \"- dead â†’ session `liveness=dead` â†’ reap; the FSM re-dispatches.\",\r\n  347:         \"- queued-on-capacity â†’ action back to `pending` right after you \"\r\n  348:         \"dispatched it (the pool was full; the spawn rolled back). NOT a \"\r\n  349:         \"phantom, NOT a stall â€” it dispatches when a slot frees, so a \"\r\n  350:         \"`wait` here is legitimate. `rx.pool(scope=you)` WAKES you on the \"\r\n  351:         \"lock-release that frees the slot.\",\r\n  352:         \"Use rx.pool (scoped) + rx.worklog to be WOKEN on these flips â€” \"\r\n  353:         \"don't re-poll inspect_worker on every heartbeat.\",\r\n  354:         \"\",\r\n  355:         \"- `read_object(type, **ids)` â†’ one object (or null)\",\r\n  356:         \"- `query_objects(type, where={â€¦}, **scope)` â†’ filtered list\",\r\n  357:         \"- `create_object(type, fields={â€¦})` / \"\r\n  358:         \"`update_object(type, ids={â€¦}, patch={â€¦})` â†’ mutate via the \"\r\n  359:         \"object's own invariants\",\r\n  360:         \"- `describe_objects(name)` â†’ that object's schema + `ops` (the \"\r\n  361:         \"verbs it REALLY supports â€” not every object takes every verb)\",\r\n  362:         \"\",\r\n  363:         \"MUTATE objects (state you change):\",\r\n  364:     ]\r\n  365:     for n, e in _CATALOG.items():\r\n  366:         if e[\"cls\"] == \"mutate\":\r\n  367:             lines.append(f\"  - `{n}` [{e['ops']}] â€” {e['what']}\")\r\n  368:     lines.append(\"\")\r\n  369:     lines.append(\"INSPECT-ONLY objects (read/query only; lifecycle is the \"\r\n  370:                  \"spawn/reap/publish action tools):\")\r\n  371:     for n, e in _CATALOG.items():\r\n  372:         if e[\"cls\"] == \"inspect\":\r\n  373:             lines.append(f\"  - `{n}` [{e['ops']}] â€” {e['what']}\")\r\n  374:     lines.append(\"\")\r\n  375:     lines.append(\"Vocabulary (system objects, first-class): \" +\r\n  376:                  \", \".join(f\"`{n}`\" for n in _CATALOG))\r\n  377:     lines.append(\"Call describe_objects(name='<obj>') for fields, ops + \"\r\n  378:                  \"examples.\")\r\n  379:     return \"\\n\".join(lines)\r\n  380: \r\n  381: \r\n  382: # â”€â”€ readers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  383: \r\n  384: def _need(ids: dict, *keys) -> None:\r\n  385:     missing = [k for k in keys if not ids.get(k)]\r\n  386:     if missing:\r\n  387:         # 2026-08-13 (s3 friction P2): \"needs id(s): ['plan_id']\" never named\r\n  388:         # WHERE the ids go, so callers retried with top-level params. Show the\r\n  389:         # call shape, not just the missing keys.\r\n  390:         raise ObjectError(\r\n  391:             f\"this object needs id(s): {missing} â€” pass them in the `ids` \"\r\n  392:             f\"mapping, e.g. ids={{{', '.join(f'{k!r}: <{k}>' for k in keys)}}}\")\r\n  393: \r\n  394: \r\n  395: def _resolve_action_injected(d: dict, plan) -> dict:\r\n  396:     \"\"\"s17 RP-A â€” resolve an action's by-id `injected_context_ids` pointers to\r\n  397:     full TEXT at READ time, against the plan's store-once `injected_context`\r\n  398:     by-id map, so a worker calling read_object('action') receives the SAME\r\n  399:     full-text grounding dict it did pre-RP-A (byte-identical), with NO\r\n  400:     per-action text duplication on disk.\r\n  401: \r\n  402:     Shape produced (identical to the legacy stamp):\r\n  403:         {\"load_bearing_decisions\": [textâ€¦], \"banned_options\": [textâ€¦]}\r\n  404: \r\n  405:     Back-compat: an OLD action (pre-RP-A) carries full-text `injected_context`\r\n  406:     and NO `injected_context_ids` â€” it passes straight through unchanged. The\r\n  407:     resolved `injected_context_ids` pointer is removed from the read view (it is\r\n  408:     an internal storage detail; the worker never needs the raw ids).\"\"\"\r\n  409:     from .tools._bounds import budget_report\r\n  410:     ids = d.pop(\"injected_context_ids\", None)\r\n  411:     if not ids:\r\n  412:         # No pointer â†’ legacy full-text injected_context (if any) passes\r\n  413:         # through â€” but self-labels when oversize (context-diet Phase 1a: a\r\n  414:         # pre-budget action can still carry a ~47k-token full-text stamp, and\r\n  415:         # the reader must at least be told it is holding one).\r\n  416:         legacy = d.get(\"injected_context\")\r\n  417:         if legacy:\r\n  418:             report = budget_report(legacy)\r\n  419:             if report[\"oversize\"]:\r\n  420:                 d[\"injected_context_report\"] = report\r\n  421:         return d\r\n  422:     pmap = getattr(plan, \"injected_context\", None) or {}\r\n  423:     resolved: dict = {}\r\n  424:     for bucket, idlist in ids.items():\r\n  425:         texts = [pmap[i] for i in idlist if i in pmap]\r\n  426:         if texts:\r\n  427:             resolved[bucket] = texts\r\n  428:     if resolved:\r\n  429:         d[\"injected_context\"] = resolved\r\n  430:         report = budget_report(resolved)\r\n  431:         if report[\"oversize\"]:\r\n  432:             d[\"injected_context_report\"] = report\r\n  433:     return d\r\n  434: \r\n  435: \r\n  436: def _trim(text: Any, limit: int = 160) -> str:\r\n  437:     \"\"\"First-line, length-capped projection for digest views.\"\"\"\r\n  438:     s = str(text or \"\").strip().splitlines()\r\n  439:     first = s[0].strip() if s else \"\"\r\n  440:     return (first[:limit].rstrip() + \"â€¦\") if len(first) > limit else first\r\n  441: \r\n  442: \r\n  443: def _full_hint(obj_type: str, ids_hint: str) -> str:\r\n  444:     return f\"read_object(type='{obj_type}', ids={{{ids_hint}}}, detail='full')\"\r\n  445: \r\n  446: \r\n  447: def _digest_recipe(d: dict) -> dict:\r\n  448:     \"\"\"P1 digest projection: scalars + state + counts stay; the long texts\r\n  449:     (decision bodies, step descriptions, outcome descriptions) become\r\n  450:     trimmed rows. Self-labels as a digest so it is never mistaken for the\r\n  451:     whole object.\"\"\"\r\n  452:     from .fsm.recipe_fsm import _decision_title\r\n  453:     from .tools._bounds import windowed\r\n  454:     ctxd = d.get(\"context\") or {}\r\n  455:     out = {\r\n  456:         k: v for k, v in d.items()\r\n  457:         if k in (\"recipe_id\", \"user_goal_distilled\", \"domain\", \"state\",\r\n  458:                  \"final_outcome\", \"version\", \"created_at\", \"updated_at\")\r\n  459:     }\r\n  460:     comp = d.get(\"comprehension\") or {}\r\n  461:     out[\"comprehension\"] = {\r\n  462:         \"curiosity_cleared\": comp.get(\"curiosity_cleared\"),\r\n  463:         \"user_signoff\": comp.get(\"user_signoff\"),\r\n  464:         \"baseline\": comp.get(\"baseline\"),\r\n  465:         \"expected_outcomes\": [\r\n  466:             {\"id\": o.get(\"id\"), \"met\": o.get(\"met\"),\r\n  467:              \"description\": _trim(o.get(\"description\"))}\r\n  468:             for o in comp.get(\"expected_outcomes\", [])\r\n  469:         ],\r\n  470:     }\r\n  471:     # a3: window the steps + decisions rows (<=WINDOW + cursor) so a recipe\r\n  472:     # with hundreds of either can't unbound the digest. The projections STAY\r\n  473:     # JSON lists (only capped) with a count/cursor sibling â€” full fidelity is\r\n  474:     # one detail='full' read away (the _full hint below).\r\n  475:     steps_rows = [\r\n  476:         {\"step_id\": s.get(\"step_id\"), \"status\": s.get(\"status\"),\r\n  477:          \"kind\": s.get(\"kind\"), \"description\": _trim(s.get(\"description\")),\r\n  478:          \"depends_on\": s.get(\"depends_on\"), \"plan_ref\": s.get(\"plan_ref\"),\r\n  479:          \"attempt\": s.get(\"attempt\")}\r\n  480:         for s in d.get(\"steps\", [])\r\n  481:     ]\r\n  482:     sw = windowed(steps_rows)\r\n  483:     out[\"steps\"] = sw[\"items\"]\r\n  484:     out[\"steps_count\"] = sw[\"count\"]\r\n  485:     out[\"steps_cursor\"] = sw[\"cursor\"]\r\n  486:     dec_rows = [\r\n  487:         {\"id\": x.get(\"id\"), \"title\": _decision_title(x.get(\"text\", \"\")),\r\n  488:          \"load_bearing\": x.get(\"load_bearing\", False),\r\n  489:          \"status\": x.get(\"status\", \"active\")}\r\n  490:         for x in ctxd.get(\"decisions\", [])\r\n  491:     ]\r\n  492:     dw = windowed(dec_rows)\r\n  493:     out[\"context\"] = {\r\n  494:         \"decisions\": dw[\"items\"],\r\n  495:         \"decisions_count\": dw[\"count\"],\r\n  496:         \"decisions_cursor\": dw[\"cursor\"],\r\n  497:         \"assumptions\": len(ctxd.get(\"assumptions\", [])),\r\n  498:         \"rejected_options\": len(ctxd.get(\"rejected_options\", [])),\r\n  499:         \"open_questions\": len(ctxd.get(\"open_questions\", [])),\r\n  500:     }\r\n  501:     out[\"_detail\"] = \"digest\"\r\n  502:     out[\"_full\"] = _full_hint(\"recipe\", f\"'recipe_id': '{d.get('recipe_id')}'\")\r\n  503:     return out\r\n  504: \r\n  505: \r\n  506: def _digest_plan(d: dict) -> dict:\r\n  507:     \"\"\"P1 digest projection: drops the injected_context map and per-action\r\n  508:     evidence blobs; actions become status rows.\"\"\"\r\n  509:     out = {\r\n  510:         k: v for k, v in d.items()\r\n  511:         if k in (\"plan_id\", \"recipe_id\", \"recipe_step_id\", \"domain\",\r\n  512:                  \"shape\", \"state\", \"terminal_status\", \"version\")\r\n  513:     }\r\n  514:     out[\"goal\"] = _trim(d.get(\"goal\"), 240)\r\n  515:     out[\"actions\"] = [\r\n  516:         {\"action_id\": a.get(\"action_id\"), \"status\": a.get(\"status\"),\r\n  517:          \"description\": _trim(a.get(\"description\")),\r\n  518:          \"depends_on\": a.get(\"depends_on\"),\r\n  519:          \"spec_ids\": a.get(\"spec_ids\") or (\r\n  520:              [a[\"spec_id\"]] if a.get(\"spec_id\") else []),\r\n","exit_code":0,"status":"completed"}}
