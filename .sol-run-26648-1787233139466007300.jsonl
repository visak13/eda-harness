e. THE KEY IS THE UNDERSCORE FORM, from\r\n  534: # `http_pool.py`; `test_every_pool_spawned_role_has_a_toolset` derives the\r\n  535: # keys from that source so a mismatched key cannot silently do nothing.\r\n  536: # The set is the union of the verbs the role's OWN command file calls, plus\r\n  537: # `pool_close_self`. Read-only: no authoring, no spawn, no mutation.\r\n  538: # (goal_keeper / pattern_observer, the other two advisory roles this block\r\n  539: # once defined, are DEAD â€” owner ruling 2026-08-04; see below.)\r\n  540: _CURIOSITY: frozenset[str] = frozenset({\r\n  541:     \"check_inbox\", \"get_guide\", \"notify_above\", \"observe\", \"arm_wiring\", \"list_subscriptions\", \"unobserve\", \"read_object\",\r\n  542:     \"reply\",\r\n  543:     # v7 WS1 (2026-08-05) â€” the curiosity role's PURPOSE is bias removal; a\r\n  544:     # cross-provider verdict makes that structural (a different model family\r\n  545:     # audits the same evidence). Read-only advisory posture unchanged;\r\n  546:     # route-gated in .bridge.json (unrouted = refuse).\r\n  547:     \"consult_external\",\r\n  548:     # v7 WS7 (SHADOW.md Â§4) â€” the shadowed shell's sovereignty seam:\r\n  549:     # inspect/repair/override the sidecar that runs your wiring. Reads a\r\n  550:     # ledger file + appends commands; no object reach. Refuses outright in\r\n  551:     # an unshadowed shell, so the grant is inert on the legacy path.\r\n  552:     \"reflex\",\r\n  553:     \"pool_close_self\",\r\n  554: })\r\n  555: \r\n  556: # OWNER RULING (2026-08-04): goal_keeper and pattern_observer are DEAD roles â€”\r\n  557: # rows, toolsets, tool classes, activator cards and spawn paths all deleted\r\n  558: # (history at 18cac3f). `test_every_pool_spawned_role_has_a_toolset` derives\r\n  559: # its keys from http_pool.py, whose spawn methods went with them.\r\n  560: \r\n  561: # â”€â”€ F31 (2026-08-18, owner ruling): the ACCEPTOR â€” the final goal-vs-\r\n  562: # delivery pass, run by the advisor seat (Fable) in ITS OWN shell. It\r\n  563: # verifies the whole delivery against the VERBATIM goal + any artifact the\r\n  564: # goal names, fixes what it safely can (file edits ride the harness tools,\r\n  565: # not MCP verbs), and records the verdict via emit_recipe_event(kind=\r\n  566: # 'acceptance_verdict') â€” the artifact G-ACCEPT gates close on. This closes\r\n  567: # the Sol-review #2 hole: the checker fetches its OWN evidence instead of\r\n  568: # grading what the neuron hands it. Read-only over the object graph; its\r\n  569: # only \"writes\" are the verdict event, context notes, and test lineage for\r\n  570: # tests it adds while fixing.\r\n  571: _ACCEPTOR: frozenset[str] = frozenset({\r\n  572:     \"whoami\", \"check_inbox\", \"reply\", \"notify_above\", \"ask_above\",\r\n  573:     \"emit_recipe_event\",\r\n  574:     \"get_guide\",\r\n  575:     \"read_object\", \"query_objects\", \"describe_objects\",\r\n  576:     \"observe\", \"arm_wiring\", \"list_subscriptions\", \"unobserve\",\r\n  577:     RECORD_CONTEXT, \"recall\", \"search_context\", \"read_worklog\",\r\n  578:     \"get_recipe_digest\", \"get_specialist_docs\", \"assemble_ruleset\",\r\n  579:     \"test_lineage_report\", \"record_test_lineage\",\r\n  580:     # cross-family second opinion on a close call â€” never the verdict itself\r\n  581:     \"consult_external\", \"delegate_review\",\r\n  582:     \"status_ping\", \"reflex\",\r\n  583:     \"pool_close_self\",\r\n  584: })\r\n  585: \r\n  586: ROLE_TOOLSETS: dict[str, frozenset[str]] = {\r\n  587:     \"worker\": _WORKER,\r\n  588:     \"planner\": _PLANNER,\r\n  589:     \"reviewer\": _REVIEWER,\r\n  590:     \"specialist\": _SPECIALIST,\r\n  591:     \"neuron\": _NEURON,\r\n  592:     \"curiosity\": _CURIOSITY,\r\n  593:     \"acceptor\": _ACCEPTOR,\r\n  594: }\r\n  595: \r\n  596: \r\n  597: def toolset_for_role(role: str | None) -> frozenset[str] | None:\r\n  598:     \"\"\"The scoped tool-name surface for `role`, or None when the role is\r\n  599:     absent/unknown. F37#5: the seam (mcp_server.build_mcp) now fails CLOSED\r\n  600:     on None â€” full registry only for a role-less NON-spawned operator\r\n  601:     console; unknown role or spawned-without-role refuses to build.\"\"\"\r\n  602:     if not role:\r\n  603:         return None\r\n  604:     return ROLE_TOOLSETS.get(role)\r\n  605: \r\n  606: \r\n  607: # â”€â”€ spawn model resolution (v7 WS4 seat registry) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  608: # DEAD-SURFACE RETIREMENT (2026-08-12): the DESIGN-v6 W10b MODEL_TIERS table\r\n  609: # and its lookups (`resolve_model_tier`, `HOST_DEFAULT_MODEL`, `SONNET` /\r\n  610: # EDP_WORKER_SONNET_MODEL, `DEFAULT_TASK_CLASS`) are DELETED. The seat\r\n--- 650-720 ---\r\n  650: # â”€â”€ per-role object-CRUD object-type scope (tables-as-data, DESIGN-v6 W4) â”€â”€â”€â”€\r\n  651: # The generic object-mutation verbs (create_object / update_object /\r\n  652: # delete_object) are governed PER ROLE and PER OBJECT-TYPE â€” restoring the\r\n  653: # verb to a role (planner regains update/delete above) is NOT the same as\r\n  654: # letting it mutate ARBITRARY objects. A role's value here is the exact set of\r\n  655: # object-types it may create/update/delete through those verbs. Mirrors\r\n  656: # docs/design/v6-audit/role-toolsets-derived.md CRUD lines: planner = plan +\r\n  657: # action ONLY (line 24); the neuron additionally recipe/step/north_star\r\n  658: # (the recipe owner); every other role is read-only over the generic verbs\r\n  659: # (they mutate state only through their own role verbs â€” worker via\r\n  660: # record_action_status, specialist via the SPECIALIST_ONLY authoring verbs).\r\n  661: # Reading conventions used by `crud_scope_violation`:\r\n  662: #   role PRESENT, object_type in the set  â†’ allowed\r\n  663: #   role PRESENT, object_type NOT in set  â†’ violation (incl. an empty set =\r\n  664: #                                           read-only role: every type refused)\r\n  665: #   role ABSENT from the table / EDP_ROLE unset/unknown â†’ UNCONSTRAINED\r\n  666: #     (fail-open: the human foreground shell keeps full CRUD, matching the\r\n  667: #     build_mcp absent-role full-set rule).\r\n  668: CRUD_OBJECT_SCOPE: dict[str, frozenset[str]] = {\r\n  669:     \"planner\": frozenset({\"plan\", \"action\"}),\r\n  670:     \"neuron\": frozenset({\"plan\", \"action\", \"recipe\", \"step\", \"north_star\"}),\r\n  671:     \"worker\": frozenset(),\r\n  672:     \"reviewer\": frozenset(),\r\n  673:     \"specialist\": frozenset(),\r\n  674:     # (\"consult\" row deleted with its role â€” 2026-08-12 dead-surface sweep.)\r\n  675:     # s25/a4: the advisory role is read-only over the generic verbs, closing\r\n  676:     # the same fail-open hole `crud_scope_violation` had for it (an ABSENT\r\n  677:     # role returns None = UNCONSTRAINED full CRUD). goal_keeper /\r\n  678:     # pattern_observer rows deleted with their roles (owner ruling 2026-08-04).\r\n  679:     \"curiosity\": frozenset(),\r\n  680:     # F31: the acceptor judges and fixes FILES (harness tools), never the\r\n  681:     # object graph â€” read-only over the generic CRUD verbs.\r\n  682:     \"acceptor\": frozenset(),\r\n  683: }\r\n  684: \r\n  685: \r\n  686: def crud_scope_violation(role: str | None, object_type: str) -> str | None:\r\n  687:     \"\"\"PURE predicate (no I/O, no env read). None when `role` may mutate\r\n  688:     `object_type` through the generic object-CRUD verbs; otherwise a\r\n  689:     refuse-and-explain message naming the role and its allowed object-types.\r\n  690: \r\n  691:     An absent/unknown role is unconstrained (the human foreground shell keeps\r\n  692:     full CRUD) â†’ None. A KNOWN role with an empty grant is read-only â†’ every\r\n  693:     object-type is a violation. The CALLER (tools/_tools.py) decides warn-log\r\n  694:     vs enforce-refuse via EDP_ROLE_SCOPE; this only says whether the (role,\r\n  695:     object_type) pair is on-scope.\"\"\"\r\n  696:     if not role:\r\n  697:         return None\r\n  698:     allowed = CRUD_OBJECT_SCOPE.get(role)\r\n  699:     if allowed is None:\r\n  700:         return None  # role not governed here â†’ fail-open (full CRUD)\r\n  701:     if object_type in allowed:\r\n  702:         return None\r\n  703:     shown = \", \".join(sorted(allowed)) if allowed else \"none (read-only role)\"\r\n  704:     return (\r\n  705:         f\"role {role!r} may not mutate object-type {object_type!r} via the \"\r\n  706:         f\"generic object-CRUD verbs; allowed object-types: {shown}\"\r\n  707:     )\r\n  708: \r\n  709: \r\n  710: __all__ = [\r\n  711:     \"SPECIALIST_ONLY\", \"RETIRED_VERBS\", \"UNSCOPED_OK\", \"ROLE_TOOLSETS\",\r\n  712:     \"toolset_for_role\",\r\n  713:     \"CRUD_OBJECT_SCOPE\", \"crud_scope_violation\",\r\n  714:     \"spawn_model_for\",\r\n  715: ]\r\n","exit_code":0,"status":"completed"}}
