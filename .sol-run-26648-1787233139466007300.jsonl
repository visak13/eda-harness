cordOutcome\", **fields)\r\n 1011:     if obj_type == \"neuron\":\r\n 1012:         return await _run_intent(ctx, \"CreateSpecialization\", **fields)\r\n 1013:     if obj_type == \"spec\":\r\n 1014:         # a spec is created with its neuron (create_specialization);\r\n 1015:         # entries are appended via add_spec_entry.\r\n 1016:         return await _run_intent(ctx, \"AddSpecEntry\", **fields)\r\n 1017:     if obj_type == \"memory\":\r\n 1018:         # create = remember(fact, domain). `domain` is pulled from\r\n 1019:         # fields; the rest IS the fact. The kg_filter gate may reject it\r\n 1020:         # (returned `stored: false`) â€” that's a valid outcome, not an\r\n 1021:         # error.\r\n 1022:         f = dict(fields)\r\n 1023:         domain = f.pop(\"domain\", \"generic\")\r\n 1024:         return await _run_intent(ctx, \"Remember\", fact=f, domain=domain)\r\n 1025:     raise ObjectError(f\"create not supported for {obj_type!r}\")\r\n 1026: \r\n 1027: \r\n 1028: async def update_object(ctx, obj_type: str, ids: dict | None = None,\r\n 1029:                         patch: dict | None = None, *,\r\n 1030:                         override_ref: str | None = None) -> dict:\r\n 1031:     \"\"\"Patch a domain object through its encapsulated validation.\r\n 1032:     Refused for inspect-only objects. `override_ref` (WP1) is a recorded\r\n 1033:     user_gate_answer id, consumed by gated patches (G-STEP step done-flip;\r\n 1034:     G-SKIP action skip).\"\"\"\r\n 1035:     ids = ids or {}\r\n 1036:     patch = patch or {}\r\n 1037:     if obj_type not in _CATALOG:\r\n 1038:         raise ObjectError(\r\n 1039:             f\"unknown object {obj_type!r}; known: {sorted(_CATALOG)}\")\r\n 1040:     if _CATALOG[obj_type][\"cls\"] != \"mutate\":\r\n 1041:         raise ObjectError(\r\n 1042:             f\"`{obj_type}` is inspect-only â€” cannot update. Use the action \"\r\n 1043:             \"tools (reap a session, etc.), not update_object.\")\r\n 1044:     if not patch:\r\n 1045:         raise ObjectError(\"update_object needs a non-empty `patch`\")\r\n 1046: \r\n 1047:     if obj_type == \"action\":\r\n 1048:         _need(ids, \"plan_id\", \"action_id\")\r\n 1049:         # status change â†’ record_action_status (d30 pure write: records\r\n 1050:         # status + evidence, runs no gate; a `done` lands as done directly).\r\n 1051:         if \"status\" in patch:\r\n 1052:             kw: dict = dict(\r\n 1053:                 plan_id=ids[\"plan_id\"], action_id=ids[\"action_id\"],\r\n 1054:                 status=patch[\"status\"], evidence=patch.get(\"evidence\"))\r\n 1055:             # WP1 G-SKIP / G-RUNS: thread the recorded override + runs\r\n 1056:             # ledger through to record_action_status (the gate owner).\r\n 1057:             if override_ref is not None:\r\n 1058:                 kw[\"override_ref\"] = override_ref\r\n 1059:             if patch.get(\"runs\"):\r\n 1060:                 kw[\"runs\"] = patch[\"runs\"]\r\n 1061:             return await _run_intent(ctx, \"RecordActionStatus\", **kw)\r\n 1062:         # correctable verify / description (friction #4): a targeted edit\r\n 1063:         # of a single action field, allowed even while dispatching â€” it's\r\n 1064:         # a CORRECTION, the gate still actually checks afterward.\r\n 1065:         return await _update_action_fields(ctx, ids[\"plan_id\"],\r\n 1066:                                            ids[\"action_id\"], patch)\r\n 1067: \r\n 1068:     if obj_type == \"step\":\r\n 1069:         # P3: steps are editable (advisory-guarded) â€” see _update_step_fields.\r\n 1070:         _need(ids, \"recipe_id\", \"step_id\")\r\n","exit_code":0,"status":"completed"}}
