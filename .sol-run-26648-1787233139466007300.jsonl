:     (worker `plan:action`) and other chars illegal on Windows, so sanitize\r\n12379:     to an alnum/._- slug (truncated for MAX_PATH safety) and append a short\r\n12380:     sha1 of the FULL recipient to guarantee no two distinct recipients\r\n12381:     collide onto one file.\"\"\"\r\n12382:     safe = re.sub(r\"[^A-Za-z0-9._-]\", \"_\", recipient)[:80]\r\n12383:     digest = hashlib.sha1(recipient.encode(\"utf-8\")).hexdigest()[:12]\r\n12384:     return _inbox_cursor_root(ctx) / f\"{safe}.{digest}.ts\"\r\n12385: \r\n12386: \r\n12387: def _load_persisted_cursor(ctx, recipient: str) -> datetime | None:\r\n12388:     \"\"\"Read the on-disk cursor for `recipient`; None if absent/unreadable.\r\n12389:     Best-effort: a missing/corrupt file degrades to the pre-RP-C behavior\r\n12390:     (poll from None) rather than erroring the agent's inbox read.\"\"\"\r\n12391:     try:\r\n12392:         raw = _inbox_cursor_file(ctx, recipient).read_text(\r\n12393:             encoding=\"utf-8\"\r\n12394:         ).strip()\r\n12395:     except (FileNotFoundError, OSError):\r\n12396:         return None\r\n12397:     if not raw:\r\n12398:         return None\r\n12399:     try:\r\n12400:         return datetime.fromisoformat(raw)\r\n12401:     except ValueError:\r\n12402:         return None\r\n12403: \r\n12404: \r\n12405: def _save_persisted_cursor(ctx, recipient: str, ts: datetime) -> None:\r\n12406:     \"\"\"Write the recipient's cursor atomically-ish (write tmp + replace).\r\n12407:     Best-effort: the in-process dict remains authoritative for this shell,\r\n12408:     so a write failure never breaks inbox delivery â€” it only means the NEXT\r\n12409:     fresh shell falls back to a wider poll.\"\"\"\r\n12410:     try:\r\n\r\n  claude\\tests\\test_f37_round5.py:1:\"\"\"F37 (2026-08-18) — campaign Round 5 (role surfaces & trust) fixes.\r\n  claude\\tests\\test_f37_round5.py:2:\r\n  claude\\tests\\test_f37_round5.py:3:Covers the seven confirmed agent-safety findings plus the cheap halves of\r\n> claude\\tests\\test_f37_round5.py:4:#4 (message provenance) and #8 (secret redaction). Threat model per the\r\n  claude\\tests\\test_f37_round5.py:5:owner ruling: a single-operator local fleet — the adversary is a confused\r\n  claude\\tests\\test_f37_round5.py:6:or prompt-injected AGENT, not a hostile process; multi-tenant auth for the\r\n  claude\\tests\\test_f37_round5.py:7:pool/broker was REJECTED as out-of-scope (ledger F37).\r\n  claude\\tests\\test_f37_round5.py:8:\r\n  claude\\tests\\test_f37_round5.py:9:ENV DISCIPLINE (d7/d8): every test controls EDP_ROLE / EDP_HANDLE /\r\n  claude\\tests\\test_f37_round5.py:10:EDP_ROLE_SCOPE explicitly via monkeypatch.\r\n  claude\\tests\\test_f37_round5.py:11:\"\"\"\r\n  claude\\tests\\test_f37_round5.py:12:\r\n  claude\\tests\\test_f37_round5.py:13:from datetime import datetime, timezone\r\n  claude\\tests\\test_f37_round5.py:14:\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
