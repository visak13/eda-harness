{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'edp-pool/src/edp_pool/pty_launcher.py';\"'$c=Get-Content $f;for($i=438;$i -lt 505;$i++){'\"'{0,4}: {1}' -f (\"'$i+1),$c[$i]}; $f='\"'edp-pool/tests/test_f37_spawn_secret_hygiene.py';\"'$c=Get-Content $f;for($i=20;$i -lt 43;$i++){'\"'{0,4}: {1}' -f (\"'$i+1),$c[$i]}'","aggregated_output":" 439: # was copied WHOLE into every shell, so any provider key the operator had\r\n 440: # exported (for the bridge, for unrelated tooling) reached every worker.\r\n 441: # We strip vars whose NAMES look like credentials, keeping the families the\r\n 442: # stack itself needs (EDP_* config, ANTHROPIC_*/CLAUDE_* for the harness).\r\n 443: # EDP_SPAWN_ENV_KEEP=NAME1,NAME2 is the operator's explicit pass-through\r\n 444: # for a secret a shell genuinely needs. A name-pattern DENYLIST (not a\r\n 445: # full allowlist) because a Windows shell needs dozens of ambient vars\r\n 446: # (PATH/SystemRoot/APPDATA/â€¦) an allowlist would inevitably miss.\r\n 447: _SECRET_NAME_MARKERS = (\"API_KEY\", \"APIKEY\", \"SECRET\", \"TOKEN\", \"PASSWORD\",\r\n 448:                         \"CREDENTIAL\", \"PRIVATE_KEY\")\r\n 449: _SECRET_KEEP_PREFIXES = (\"EDP_\", \"ANTHROPIC_\", \"CLAUDE_\")\r\n 450: \r\n 451: \r\n 452: def _strip_foreign_secrets(env: dict) -> dict:\r\n 453:     keep = {n.strip().upper() for n in\r\n 454:             os.environ.get(\"EDP_SPAWN_ENV_KEEP\", \"\").split(\",\") if n.strip()}\r\n 455:     out = {}\r\n 456:     for name, value in env.items():\r\n 457:         upper = name.upper()\r\n 458:         if (any(m in upper for m in _SECRET_NAME_MARKERS)\r\n 459:                 and not upper.startswith(_SECRET_KEEP_PREFIXES)\r\n 460:                 and upper not in keep):\r\n 461:             continue\r\n 462:         out[name] = value\r\n 463:     return out\r\n 464: \r\n 465: \r\n 466: def build_env(session_id: str, role: str, handle: str,\r\n 467:               broker_url: str | None, *,\r\n 468:               pool_url: str | None = None,\r\n 469:               agent_home: str | None = None,\r\n 470:               log_dir: str | None = None,\r\n 471:               defaults: dict | None = None) -> dict:\r\n 472:     \"\"\"Our env contract (NOT the old protocol). The activator reads these\r\n 473:     and drives itself via the edp-broker MCP tools.\r\n 474: \r\n 475:     2026-05-28 stack-pinning fix: the spawned shell's ENTIRE stack is\r\n 476:     pinned to the POOL's own config â€” never inherited piecemeal from the\r\n 477:     launching shell. Before this, only EDP_BROKER_URL was overridden, so\r\n 478:     a clone (eda-base3) whose pool was started from a shell still carrying\r\n 479:     eda-base's env spawned shells that talked to the OLD pool (EDP_POOL_URL\r\n 480:     inherited), loaded the OLD skills (EDP_AGENT_HOME inherited â†’ wrong\r\n 481:     cwd/.mcp.json), and logged to the OLD dir (EDP_LOG_DIR inherited) â€”\r\n 482:     while replying on the NEW broker. A mixed stack: pool_close_self hit\r\n 483:     the wrong pool, liveness lied, follow-ups dead-lettered. Now all four\r\n 484:     are set explicitly so the shell runs entirely on the pool's stack.\r\n 485: \r\n 486:     W12 `defaults`: the pool-side `spawn_defaults.json`, loaded from disk when\r\n 487:     None. It may set `rtk`. It may NOT set `EDP_SKIP_PERMISSIONS` â€” see\r\n 488:     `spawn_defaults.BANNED_KEYS`.\"\"\"\r\n 489:     from .spawn_defaults import load_spawn_defaults\r\n 490:     d = load_spawn_defaults() if defaults is None else defaults\r\n 491:     env = _strip_foreign_secrets(os.environ.copy())\r\n 492:     env[\"EDP_SPAWN_SESSION_ID\"] = session_id  # correlation (kept from old)\r\n 493:     env[\"EDP_ROLE\"] = role\r\n 494:     env[\"EDP_HANDLE\"] = handle\r\n 495:     # 2026-07-21: which HARNESS this shell runs under. Behaviour that is an\r\n 496:     # affordance of one harness and a defect in the other keys off this\r\n 497:     # rather than sniffing claude-only env keys. build_env is the CLAUDE\r\n 498:     # spawner's path; build_env_opencode overrides it after calling us.\r\n 499:     # Consumed MCP-side by _park_hint (park/resume is opencode-only: there a\r\n 500:     # park keeps the TUI window, here it closes the shell outright).\r\n 501:     env[\"EDP_HARNESS\"] = \"claude\"\r\n 502:     # W14: prevent, don't just repair â€” a mid-flight auto-update must not\r\n 503:     # break a running planner/worker (it also invalidates the prompt cache\r\n 504:     # on resume). Updates then happen only when the USER updates their own\r\n 505:     # foreground install; the pre-spawn health check catches any residue.\r\n  21:                  \"AWS_CREDENTIALS\", \"SSH_PRIVATE_KEY\"):\r\n  22:         assert gone not in env\r\n  23: \r\n  24: \r\n  25: def test_strip_keeps_stack_families_and_explicit_keep(monkeypatch):\r\n  26:     monkeypatch.setenv(\"EDP_SPAWN_ENV_KEEP\", \"OPENAI_API_KEY\")\r\n  27:     env = _strip_foreign_secrets({\r\n  28:         \"EDP_BRIDGE_TOKEN_THING\": \"stack\", \"ANTHROPIC_API_KEY\": \"harness\",\r\n  29:         \"CLAUDE_CODE_OAUTH_TOKEN\": \"harness\", \"OPENAI_API_KEY\": \"kept\",\r\n  30:         \"COHERE_API_KEY\": \"dropped\",\r\n  31:     })\r\n  32:     assert env[\"EDP_BRIDGE_TOKEN_THING\"] == \"stack\"\r\n  33:     assert env[\"ANTHROPIC_API_KEY\"] == \"harness\"\r\n  34:     assert env[\"CLAUDE_CODE_OAUTH_TOKEN\"] == \"harness\"\r\n  35:     assert env[\"OPENAI_API_KEY\"] == \"kept\"\r\n  36:     assert \"COHERE_API_KEY\" not in env\r\n  37: \r\n  38: \r\n  39: def test_build_env_applies_the_strip(monkeypatch):\r\n  40:     monkeypatch.setenv(\"SOME_VENDOR_API_KEY\", \"leakme\")\r\n  41:     monkeypatch.delenv(\"EDP_SPAWN_ENV_KEEP\", raising=False)\r\n  42:     env = build_env(role=\"worker\", handle=\"p1:a1\", session_id=\"s\",\r\n  43:                     broker_url=None, pool_url=None, agent_home=None,\r\n","exit_code":0,"status":"completed"}}
