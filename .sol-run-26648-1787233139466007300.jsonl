e JSON file per rule); they do NOT\r\n15319: # reimplement persistence, validation, the governed-effect safety model, or the\r\n15320: # compile_spec sandbox. The RuleSupervisor (started as a service) is what keeps\r\n15321: # every enabled rule subscribed across restarts.\r\n15322: def _registry_root(ctx) -> \"Path\":\r\n15323:     \"\"\"Where registered rules persist: <agent_home>/.reactive/registry.\r\n15324:     Mirrors RuleRegistry.default_registry_root() (EDP_AGENT_HOME-based) but is\r\n15325:     resolved from THIS server's store root so the MCP tool and the supervisor\r\n15326:     agree on one location regardless of the supervisor's cwd.\"\"\"\r\n15327:     return ctx.recipes.root.parent / \".reactive\" / \"registry\"\r\n15328: \r\n15329: \r\n15330: class _RegisterRuleIn(BaseModel):\r\n15331:     name: str                              # unique rule name (audit identity)\r\n15332:     spec: str                              # the rx observe lambda (one expr)\r\n15333:     owner: str                             # provenance inbox (echo filter)\r\n15334:     bindings: dict = {}                    # spec bindings, e.g. {\"me\": \"...\"}\r\n15335:     effect: dict | None = None             # OPTIONAL governed EffectSpec dict\r\n14718: \r\n14719: \r\n14720: class _DeleteObjIn(BaseModel):\r\n14721:     type: str           # 'step' | 'action'\r\n14722:     ids: dict = {}      # step: {recipe_id, step_id}; action: {plan_id, action_id}\r\n14723:     reason: str = \"\"    # why â€” recorded in the audit trail (give a real one)\r\n14724: \r\n14725: \r\n14726: class DeleteObject(_ClaudeTool):\r\n14727:     \"\"\"Delete a step or an action from the live map (P3 advisory FSM) â€”\r\n14728:     use this when work is genuinely obsolete (superseded scope, a wrongly\r\n14729:     authored action), instead of leaving zombie entries or recording a\r\n14730:     whole new plan. e.g. delete_object(type='action', ids={'plan_id':'p',\r\n14731:     'action_id':'a3'}, reason='superseded by a4'). Risky-but-legal deletes\r\n14732:     PROCEED and return `advisories` (dependents' depends_on auto-rewritten,\r\n14733:     orphaned plan noted, done-work evidence digested into the audit trail).\r\n14734:     HARD-BLOCKED only when genuinely unsafe: the recipe/plan is terminal,\r\n14735:     the target is in_progress under a LIVE shell (steer or pool_reap it\r\n14736:     first), or it is the recipe's last step past comprehension (mark it\r\n14737:     'skipped' instead). The deletion + your `reason` are recorded in the\r\n14738:     owning trail â€” history stays honest.\"\"\"\r\n14739: \r\n14740:     name = \"delete_object\"\r\n14741:     InputModel = _DeleteObjIn\r\n14742:     OutputModel = _ObjResultOut\r\n14743: \r\n14744:     async def _run(self, m: _DeleteObjIn):\r\n14745:         from ..objects import ObjectError, delete_object\r\n14746:         refuse = _guard_object_crud(self.ctx, self.name, m.type, ids=m.ids)\r\n14747:         if refuse is not None:\r\n14748:             return refuse\r\n14749:         try:\r\n14750:             res = await delete_object(self.ctx, m.type, m.ids, m.reason)\r\n14751:         except ObjectError as e:\r\n14752:             return _precondition(str(e))\r\n14753:         return Tool.ok(_ObjResultOut(result=res))\r\n14754: \r\n14755: \r\n14756: # â”€â”€ observe (reactive subscription) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n14757: class _ObserveIn(BaseModel):\r\n14758:     spec: str                              # the rx lambda (a single expr)\r\n14759:     bindings: dict = {}                    # e.g. {\"me\": \"...\", \"plan_id\": ...}\r\n14760:     subscription_id: str | None = None     # omit â†’ generated\r\n14761:     # Phase-2-A motor nerve (OPTIONAL): a governed EffectSpec dict. Absent â†’\r\n14762:     # pure sensory subscription (wake-only), exactly as before. Present â†’\r\n14763:     # each emission ALSO dispatches ONE allowlisted, idempotency-keyed,\r\n14764:     # rate-capped, audited, advisory-by-default action via the SAME governed\r\n14765:     # sink the driver already runs at phase=2 (Tier-2 stays DARK).\r\n","exit_code":0,"status":"completed"}}
