n, so the user's word still outranks the\r\n 651:         # reviewer's â€” but never silently.)\r\n 652:         failed_verdicts = [\r\n 653:             a for a in p.actions\r\n 654:             if a.status in (\"done\", \"skipped\")\r\n 655:             and (a.review_verdict or {}).get(\"passed\") is False\r\n 656:         ]\r\n 657:         if failed_verdicts:\r\n 658:             for a in failed_verdicts:\r\n 659:                 a.status = \"pending\"\r\n 660:                 # Count the cycle even when no worker/reviewer seam did â€”\r\n 661:                 # rework that never clears the stamp must walk into the\r\n 662:                 # G-REWORK hard cap (frozen â†’ ask_above), not loop forever.\r\n 663:                 bump_verify_failure(a)\r\n 664:             ids = [a.action_id for a in failed_verdicts]\r\n 665:             return Instruction(\r\n 666:                 kind=K.WAIT, args={\"reopened_action_ids\": ids},\r\n 667:                 rationale=(\r\n 668:                     f\"G-VERDICT: reopened {ids} to pending â€” each carries \"\r\n 669:                     \"a reviewer verdict with passed=false, and a plan \"\r\n 670:                     \"cannot close succeeded over a recorded FAIL. Rework \"\r\n 671:                     \"will be re-dispatched on the next tick; a passing \"\r\n 672:                     \"re-review overwrites the stamp. If the verdict is \"\r\n 673:                     \"wrong or the rework path is unclear, raise ask_above.\"\r\n 674:                 ),\r\n 675:             )\r\n 676:         p.state = PlanState.ACCEPTANCE_REVIEW\r\n 677:         return plan_next_action(p, live_action_ids, parked_action_ids,\r\n 678:                                 worklog_tails)\r\n 679: \r\n 680:     if p.state == PlanState.ACCEPTANCE_REVIEW:\r\n 681:         ts = success_criteria_for(p.domain)(p)\r\n 682:         if ts is None:\r\n 683:             return Instruction(\r\n 684:                 kind=K.INVOKE_SKILL, args={\"skill\": SKILL_