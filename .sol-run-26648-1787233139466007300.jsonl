n  33:     async def send(self, msg: BrokerMessage) -> ToolResult:\r\n  34:         payload = msg.model_dump(mode=\"json\", by_alias=True)\r\n  35:         # F37#4 (2026-08-18) â€” provenance metadata, stamped at the ONE seam\r\n  36:         # every outbound message crosses, from the server-process env (never\r\n  37:         # a caller argument, so a model cannot spoof it). The broker itself\r\n  38:         # stays unauthenticated (single-operator ruling); this gives the\r\n  39:         # READER honest origin data next to the untrusted body.\r\n  40:         body = payload.get(\"body\")\r\n  41:         if isinstance(body, dict) and \"_sender\" not in body:\r\n  42:             role = os.environ.get(\"EDP_ROLE\", \"\").strip() or None\r\n  43:             handle = os.environ.get(\"EDP_HANDLE\", \"\").strip() or None\r\n  44:             if role or handle:\r\n  45:                 body[\"_sender\"] = {\"role\": role, \"handle\": handle}\r\n  46:         r = await self.client.post(\r\n  47:             f\"{self.base}/v1/publish\",\r\n  48:             json=payload,\r\n  49:         )\r\n  50:         if r.status_code // 100 == 2:\r\n  51:             return Tool.ok(_Sent(msg_id=r.json()[\"msg_id\"]))\r\n  52:         return Tool.from_upstream(r)  # verbatim or EnvelopeViolation\r\n  53: \r\n  54:     async def poll(\r\n  55:         self, recipient: str, since_ts: datetime | None = None\r\n  56:     ) -> list[BrokerMessage]:\r\n  57:         params = {}\r\n  58:         if since_ts is not None:\r\n  59:             params[\"since_ts\"] = since_ts.isoformat()\r\n  60:         r = await self.client.get(\r\n  61:             f\"{self.base}/v1/inbox/{recipient}\", params=params,\r\n  62:             timeout=POLL_TIMEOUT_S,\r\n  63:         )\r\n  64:         r.raise_for_status()\r\n  65:         return [BrokerMessage.model_validate(x) for x in r.json()]\r\n  66: \r\n  67:     async def get_message(self, msg_id: str) -> BrokerMessage | None:\r\n  68:         # Phase 2.5 (2026-05-21): needed by Reply tool. The real\r\n  69:         # edp-broker `/v1/message/{msg_id}` endpoint lands when this\r\n  70:         # path is first exercised live; until then HttpBroker stubs\r\n  71:         # cleanly. (TODO: implement broker-side index + endpoint.)\r\n  72:         r = await self.client.get(f\"{self.base}/v1/message/{msg_id}\")\r\n  73:         if r.status_code == 404:\r\n  74:             return None\r\n  75:         r.raise_for_status()\r\n  76:         return BrokerMessage.model_validate(r.json())\r\n  77: \r\n  78:     async def query(\r\n  79:         self,\r\n  80:         to: str | None = None,\r\n  81:         from_: str | None = None,\r\n  82:         kind: str | None = None,\r\n  83:         since: datetime | None = None,\r\n  84:     ) -> list[BrokerMessage]:\r\n  85:         # GET /v1/messages cross-inbox inspection (object-model reader).\r\n  86:         params: dict[str, str] = {}\r\n  87:         if to is not None:\r\n  88:             params[\"to\"] = to\r\n  89:         if from_ is not None:\r\n  90:             params[\"from\"] = from_\r\n  91:         if kind is not None:\r\n  92:             params[\"kind\"] = kind\r\n  93:         if since is not None:\r\n  94:             params[\"since_ts\"] = since.isoformat()\r\n  95:         r = await self.client.get(f\"{self.base}/v1/messages\", params=params)\r\n  96:         r.raise_for_status()\r\n  97:         return [BrokerMessage.model_validate(x) for x in r.json()]\r\n  98: \r\n  99:     async def register_alias(\r\n 100:         self, alias: str, target: str, owner_session: str = \"*\"\r\n 101:     ) -> None:\r\n 102:         # s12(c): POST /v1/alias â€” same absolute (ownerless) bridge the pool\r\n 103:         # registers for a planner's colonâ†’dash handle (edp-pool/service.py:\r\n 104:         # 356-371). Best-effort: a broker that is down must NOT fail the\r\n 105:         # neuron's reconcile tick; the next tick re-asserts (idempotent).\r\n 106:         try:\r\n 107:             await self.client.post(\r\n 108:                 f\"{self.base}/v1/alias\",\r\n 109:                 json={\r\n 110:                     \"owner_session\": owner_session,\r\n 111:                     \"alias\": alias,\r\n 112:                     \"target\": target,\r\n 113:                 },\r\n 114:             )\r\n 115:         except Exception:  # noqa: BLE001 â€” broker down â‰  tick failure\r\n 116:             pass\r\n--- 10890-11090 ---\r\n10890: \r\n10891: \r\n10892: async def _unknown_recipient_warning(ctx, to: str) -> str | None:\r\n10893:     \"\"\"F7 (2026-08-17) â€” dead-letter detection, surfaced to the SENDER.\r\n10894: \r\n10895:     The broker is a dumb pipe: a send to an inbox nobody owns succeeds\r\n10896:     silently and the message rots (the 2026-05-24 literal-\"neuron\"\r\n10897:     dead-letter class). The sender is the one shell guaranteed alive and\r\n10898:     contextful at send time, so the warning rides its send RESULT. Known =\r\n10899:     a topic, a recipe, a plan (dash or colon head), or a handle the pool\r\n10900:     holds a session for. Fail-open: any probe error â†’ no warning (an\r\n10901:     unreachable pool must never block or spam a send).\"\"\"\r\n10902:     try:\r\n10903:         if not to or to.startswith(\"topic:\"):\r\n10904:             return None\r\n10905:         head = to.split(\":\", 1)[0]\r\n10906:         if ctx.recipes.exists(to) or ctx.recipes.exists(head):\r\n10907:             return None\r\n10908:         if ctx.plans.exists(to) or ctx.plans.exists(head):\r\n10909:             return None\r\n10910:         live = (await ctx.pool.liveness(to))[\"state\"]\r\n10911:         if live in (\"alive\", \"parked\"):\r\n10912:             return None\r\n10913:         for row in await ctx.pool.sessions():\r\n10914:             if row.get(\"handle\") == to:\r\n10915:                 return None\r\n10916:     except Exception:  # noqa: BLE001 â€” detection must never break a send\r\n10917:         return None\r\n10918:     return (\r\n10919:         f\"recipient {to!r} matches NO known inbox (not a recipe, plan, \"\r\n10920:         \"topic, or pool-held handle) â€” the message was accepted by the \"\r\n10921:         \"broker but may DEAD-LETTER. Check the address: use whoami()/\"\r\n10922:         \"lineage values (planner inbox = DASH plan_id; worker = \"\r\n10923:         \"<plan_id>:<action_id>; neuron = recipe_id), then re-send.\")\r\n10924: \r\n10925: \r\n10926: class BrokerSend(_ClaudeTool):\r\n10927:     \"\"\"Send a RAW broker message â€” you supply from/to/kind/body yourself.\r\n10928:     This is the low-level escape hatch; prefer the routed tools, which\r\n10929:     resolve addresses for you and never dead-letter: `reply(msg_id, â€¦)`\r\n10930:     to answer anything (routes to the sender), `ask_above` /\r\n10931:     `notify_above` for upward traffic (parent or audience='neuron'),\r\n10932:     `emit_recipe_event` for recipe-wide broadcasts. Reach for broker_send\r\n10933:     only when none of those fit: messaging a specific live handle you\r\n10934:     discovered (e.g. steering the planner of an edited step at\r\n10935:     `<recipe_id>-<step_id>`), or publishing to a `topic:<name>` recipient.\r\n10936:     Addressing gotcha: a planner's inbox is its DASH plan_id; a worker's\r\n10937:     is its colon `<plan_id>:<action_id>`; the neuron's is the recipe_id.\r\n10938:     Use whoami()/lineage values â€” never hand-build an address.\"\"\"\r\n10939: \r\n10940:     name = \"broker_send\"\r\n10941:     InputModel = _SendIn\r\n10942:     OutputModel = BaseModel\r\n10943: \r\n10944:     async def _run(self, m: _SendIn):\r\n10945:         # W2 leg 3: warn-only constraint stamp on the body â€” NEVER blocks.\r\n10946:         _warn_comms_constraints(self.ctx, m.body, \"broker_send\")\r\n10947:         msg = BrokerMessage(\r\n10948:             msg_id=str(uuid.uuid4()),\r\n10949:             ts=_now(),\r\n10950:             **{\"from\": m.from_},\r\n10951:             to=m.to,\r\n10952:             kind=m.kind,\r\n10953:             body=m.body,\r\n10954:         )\r\n10955:         # F7: probe the recipient BEFORE the send so the warning can ride\r\n10956:         # the send result â€” the sender is the only party positioned to fix\r\n10957:         # a bad address at zero cost.\r\n10958:         _dead_letter = await _unknown_recipient_warning(self.ctx, m.to)\r\n10959:         res = await self.ctx.broker.send(msg)\r\n10960:         # v7 P3.2 â€” a steer is VERIFIED, not assumed. Record the send\r\n10961:         # durably (msg_id + recipient) where the sender's own reconcile can\r\n10962:         # correlate it against inbound steer_acks: the planner/worker side\r\n10963:         # in its plan worklog, the neuron side in the recipe events trail\r\n10964:         # (a neuron has no plan worklog â€” _sender_plan_id returns None).\r\n10965:         # Best-effort: a failed record never fails the send.\r\n10966:         if m.kind == \"steer\" and getattr(res, \"ok\", False):\r\n10967:             try:\r\n10968:                 pid = _sender_plan_id()\r\n10969:                 if pid and self.ctx.plans.exists(pid):\r\n10970:                     self.ctx.plans.append_worklog(pid, {\r\n10971:                         \"kind\": \"message_sent\", \"msg_kind\": \"steer\",\r\n10972:                         \"msg_id\": msg.msg_id, \"to\": m.to,\r\n10973:                         \"agent_role\":\r\n10974:                             os.environ.get(\"EDP_ROLE\", \"\").strip()\r\n10975:                             or \"unknown\",\r\n10976:                         \"from_handle\":\r\n10977:                             os.environ.get(\"EDP_HANDLE\", \"\").strip() or None,\r\n10978:                         \"summary\": str(m.body)[:300],\r\n10979:                     })\r\n10980:                 else:\r\n10981:                     rid = re.sub(r\"-s\\d+$\", \"\", m.to.split(\":\", 1)[0])\r\n10982:                     if self.ctx.recipes.exists(rid):\r\n10983:                         self.ctx.recipes.append_worklog(rid, {\r\n10984:                             \"kind\": \"steer_sent\", \"msg_id\": msg.msg_id,\r\n10985:                             \"to\": m.to, \"summary\": str(m.body)[:300],\r\n10986:                         })\r\n10987:             except Exception as e:\r\n10988:                 _log.warning(\"steer_send_record_failed\",\r\n10989:                              \"steer-send record failed\", error=str(e))\r\n10990:         # F7: the dead-letter warning rides the SUCCESSFUL send result â€”\r\n10991:         # the broker accepted the message, but the sender is told, now,\r\n10992:         # that nobody is known to own that inbox.\r\n10993:         if _dead_letter and getattr(res, \"ok\", False):\r\n10994:             res = _with_spawn_advisories(res, [{\r\n10995:                 \"kind\": \"unknown_recipient\", \"detail\": _dead_letter}])\r\n10996:         return res\r\n10997: \r\n10998: \r\n10999: class _SteerWorkerIn(BaseModel):\r\n11000:     action_id: str          # the live worker's action in YOUR plan\r\n11001:     body: dict = {}         # the correction â€” what changed and why\r\n11002:     plan_id: str | None = None   # defaults from the caller's lineage\r\n11003: \r\n11004: \r\n11005: class SteerWorker(_ClaudeTool):\r\n11006:     \"\"\"F5 (2026-08-17) â€” the planner's CORRECTION verb. Sends a\r\n11007:     `kind=\"steer\"` to the live worker holding `<plan_id>:<action_id>`,\r\n11008:     resolving the address from YOUR plan (never hand-built). The worker\r\n11009:     must `steer_ack` (restate) before acting â€” the send is recorded in the\r\n11010:     plan worklog so reconcile's steer-watch can correlate the ack. Refuses\r\n11011:     when the action has no live shell (a steer to a dead worker is a\r\n11012:     dead letter â€” re-dispatch instead) or when the action is not yours.\"\"\"\r\n11013: \r\n11014:     name = \"steer_worker\"\r\n11015:     InputModel = _SteerWorkerIn\r\n11016:     OutputModel = BaseModel\r\n11017: \r\n11018:     async def _run(self, m: _SteerWorkerIn):\r\n11019:         _me, parent = _self_and_parent_addresses()\r\n11020:         role = os.environ.get(\"EDP_ROLE\", \"\").strip()\r\n11021:         plan_id = m.plan_id\r\n11022:         if not plan_id:\r\n11023:             if role == \"planner\":\r\n11024:                 plan_id = _me                 # dash plan_id\r\n11025:             elif not role:\r\n11026:                 return _precondition(\r\n11027:                     \"steer_worker: pass plan_id explicitly â€” no planner \"\r\n11028:                     \"lineage resolves from this shell.\")\r\n11029:         if not plan_id or not self.ctx.plans.exists(plan_id):\r\n11030:             return _precondition(f\"unknown plan {plan_id!r}\")\r\n11031:         p = self.ctx.plans.load(plan_id)\r\n11032:         a = next((x for x in p.actions if x.action_id == m.action_id), None)\r\n11033:         if a is None:\r\n11034:             return _precondition(\r\n11035:                 f\"no action {m.action_id!r} in plan {plan_id!r} â€” steer an \"\r\n11036:                 \"action you authored (query_objects shows them).\")\r\n11037:         handle = f\"{plan_id}:{m.action_id}\"\r\n11038:         live = (await self.ctx.pool.liveness(handle))[\"state\"]\r\n11039:         if live != \"alive\":\r\n11040:             return _precondition(\r\n11041:                 f\"worker {handle!r} is {live!r}, not alive â€” a steer would \"\r\n11042:                 \"dead-letter. If the shell crashed, reconcile re-dispatches \"\r\n11043:                 \"(or pool_reap + re-dispatch); fold the correction into the \"\r\n11044:                 \"action's grounding instead (update_object the action / \"\r\n11045:                 \"record_context scoped to this plan).\")\r\n11046:         if not m.body:\r\n11047:             return _precondition(\r\n11048:                 \"steer_worker: body is empty â€” say what changed and why \"\r\n11049:                 \"(the worker restates it in its steer_ack).\")\r\n11050:         msg = BrokerMessage(\r\n11051:             msg_id=str(uuid.uuid4()), ts=_now(),\r\n11052:             **{\"from\": _me or plan_id}, to=handle,\r\n11053:             kind=\"steer\", body=m.body)\r\n11054:         res = await self.ctx.broker.send(msg)\r\n11055:         if getattr(res, \"ok\", False):\r\n11056:             # Same durable send record BrokerSend writes for steers â€” the\r\n11057:             # steer-watch (unacked_steers) correlates acks against it.\r\n11058:             try:\r\n11059:                 self.ctx.plans.append_worklog(plan_id, {\r\n11060:                     \"kind\": \"message_sent\", \"msg_kind\": \"steer\",\r\n11061:                     \"msg_id\": msg.msg_id, \"to\": handle,\r\n11062:                     \"agent_role\": role or \"unknown\",\r\n11063:                     \"from_handle\":\r\n11064:                         os.environ.get(\"EDP_HANDLE\", \"\").strip() or None,\r\n11065:                     \"summary\": str(m.body)[:300],\r\n11066:                 })\r\n11067:             except Exception as e:  # noqa: BLE001 â€” never fail the send\r\n11068:                 _log.warning(\"steer_send_record_failed\",\r\n11069:                              \"steer-send record failed\", error=str(e))\r\n11070:         return res\r\n11071: \r\n11072: \r\n11073: class _RecallIn(BaseModel):\r\n11074:     query: str\r\n11075:     scope: str | None = None\r\n11076:     # s17 a7: recall fans out over global + recipe + domain scopes, so the\r\n11077:     # merged result set grows with the total facts stored â€” a LIST output that\r\n11078:     # #18 requires bounded by construction. Window it (default WINDOW) with a\r\n11079:     # count-first cursor; page the rest with offset/limit.\r\n11080:     offset: int = 0\r\n11081:     limit: int = WINDOW\r\n11082: \r\n11083: \r\n11084: class _RecallOut(BaseModel):\r\n11085:     results: list[dict]           # a7: the bounded <=limit slice\r\n11086:     count: int = 0                # FULL number of recalled facts\r\n11087:     cursor: int | None = None     # next offset to page from, or None at the end\r\n11088: \r\n11089: \r\n11090: class Recall(_ClaudeTool):\r\n--- 11220-11305 ---\r\n11220:     this at cold start to discover your environment instead of string-\r\n11221:     munging EDP_HANDLE. Use `self_address` as `me` for `rx.broker(me)`.\r\n11222:     **GOTCHA:** a planner's inbox is its plan_id (`<recipe_id>-<step_id>`,\r\n11223:     DASH), NOT its `EDP_HANDLE` (`<recipe_id>:<step_id>`, COLON). Workers:\r\n11224:     self_address == your EDP_HANDLE. Neuron: no EDP_HANDLE â†’ self_address\r\n11225:     is null; your inbox is your recipe_id.\r\n11226: \r\n11227:     `lineage` tells a worker which recipe/neuron it ultimately works under\r\n11228:     (recipe_id, plan_id, planner_address, neuron_address) â€” addressing\r\n11229:     knowledge for emit_recipe_event tagging and for routing decision-class\r\n11230:     questions to the neuron (ask_above audience='neuron'). It is strictly\r\n11231:     your OWN lineage; there is no global agent registry.\"\"\"\r\n11232: \r\n11233:     name = \"whoami\"\r\n11234:     idempotent = True\r\n11235:     InputModel = _WhoAmIIn\r\n11236:     OutputModel = _WhoAmIOut\r\n11237: \r\n11238:     async def _run(self, m: _WhoAmIIn):\r\n11239:         role = os.environ.get(\"EDP_ROLE\", \"\").strip() or None\r\n11240:         me, parent = _self_and_parent_addresses()\r\n11241:         lineage: dict = {}\r\n11242:         recipe_id, extras = _resolve_recipe_lineage(self.ctx)\r\n11243:         if recipe_id:\r\n11244:             lineage[\"recipe_id\"] = recipe_id\r\n11245:             lineage[\"neuron_address\"] = recipe_id\r\n11246:             if extras.get(\"plan_id\"):\r\n11247:                 lineage[\"plan_id\"] = extras[\"plan_id\"]\r\n11248:                 lineage[\"planner_address\"] = extras[\"plan_id\"]\r\n11249:             if extras.get(\"action_id\"):\r\n11250:                 lineage[\"action_id\"] = extras[\"action_id\"]\r\n11251:             if role == \"planner\" and me:\r\n11252:                 lineage[\"step_id\"] = me[len(recipe_id) + 1:] or None\r\n11253:         return Tool.ok(_WhoAmIOut(\r\n11254:             role=role, self_address=me, parent_address=parent,\r\n11255:             recipe_id=recipe_id, lineage=lineage,\r\n11256:             note=(\"bind rx.broker(me) to self_address â€” it's the inbox \"\r\n11257:                   \"others reply to you at (planner: dash plan_id, NOT \"\r\n11258:                   \"colon EDP_HANDLE). lineage shows the recipe/neuron you \"\r\n11259:                   \"work under; prefer your parent or the flowback channel \"\r\n11260:                   \"(emit_recipe_event) for routine traffic.\"),\r\n11261:         ))\r\n11262: \r\n11263: \r\n11264: def _question_envelope_for_caller(ctx, options=None) -> dict | None:\r\n11265:     \"\"\"DESIGN-v7 2.1 â€” load whatever objects the CALLER's lineage resolves to\r\n11266:     (plan/action for a worker; recipe/step for a planner) and compose the\r\n11267:     question envelope from them. This is the ONE IO wrapper around the pure\r\n11268:     `fsm.envelope.compose_question_envelope`; `ask_above` calls it on every\r\n11269:     send so enrichment happens BY CONSTRUCTION â€” no guide compliance, no\r\n11270:     refusal path. Returns None (never raises) when nothing resolves or a load\r\n11271:     fails: a degraded envelope must never block the question itself.\"\"\"\r\n11272:     try:\r\n11273:         recipe_id, extras = _resolve_recipe_lineage(ctx)\r\n11274:         plan = action = recipe = step = None\r\n11275:         pid = extras.get(\"plan_id\")\r\n11276:         if pid and ctx.plans.exists(pid):\r\n11277:             plan = ctx.plans.load(pid)\r\n11278:             aid = extras.get(\"action_id\")\r\n11279:             if aid:\r\n11280:                 action = next(\r\n11281:                     (a for a in plan.actions if a.action_id == aid), None)\r\n11282:         if recipe_id and ctx.recipes.exists(recipe_id):\r\n11283:             recipe = ctx.recipes.load(recipe_id)\r\n11284:             # A planner's EDP_HANDLE is <recipe_id>:<step_id> â€” resolve the\r\n11285:             # step so a step-level (no-action) question still carries a\r\n11286:             # what-I-was-doing line and its dependents.\r\n11287:             if os.environ.get(\"EDP_ROLE\", \"\").strip() == \"planner\":\r\n11288:                 handle = os.environ.get(\"EDP_HANDLE\", \"\").strip()\r\n11289:                 sid = handle.rsplit(\":\", 1)[-1] if \":\" in handle else None\r\n11290:                 if sid:\r\n11291:                     step = next(\r\n11292:                         (s for s in recipe.steps if s.step_id == sid), None)\r\n11293:         if not (plan or action or recipe or step or options):\r\n11294:             return None\r\n11295:         env = compose_question_envelope(\r\n11296:             plan=plan, action=action, recipe=recipe, step=step,\r\n11297:             options=options)\r\n11298:         return env or None\r\n11299:     except Exception:  # noqa: BLE001 â€” enrichment must never block the ask\r\n11300:         return None\r\n11301: \r\n11302: \r\n11303: class _AskAboveIn(BaseModel):\r\n11304:     question: str\r\n11305:     body: dict = {}\r\nclaude/src/edp_claude/clients/http_broker.py:41:        if isinstance(body, dict) and \"_sender\" not in body:\r\nclaude/src/edp_claude/clients/http_broker.py:45:                body[\"_sender\"] = {\"role\": role, \"handle\": handle}\r\nclaude/src/edp_claude/tools/_tools.py:10964:        # (a neuron has no plan worklog — _sender_plan_id returns None).\r\nclaude/src/edp_claude/tools/_tools.py:10968:                pid = _sender_plan_id()\r\nclaude/src/edp_claude/tools/_tools.py:11169:def _sender_plan_id() -> str | None:\r\nclaude/src/edp_claude/tools/_tools.py:11185:    pid = _sender_plan_id()\r\nclaude/s