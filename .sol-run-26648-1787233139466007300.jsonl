{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$f='\"'claude/src/edp_claude/tools/bridge.py'; \"'$c=Get-Content $f; for($i=0;$i -lt $c.Count;$i++){ '\"'{0,5}: {1}' -f (\"'$i+1),$c[$i] }'","aggregated_output":"    1: \"\"\"The provider bridge engine â€” any external model as a deterministic tool.\r\n    2: \r\n    3: WHY THIS EXISTS (v7 ruling, 2026-08-05). The framework runs 100% on Claude Code\r\n    4: shells; model diversity happens INSIDE the shells: frontier models author plans\r\n    5: and judgments, cheap external models execute bulk generation, review pre-screens,\r\n    6: cross-family consults, and adversarial challenges. sol_bridge.py proved the\r\n    7: pattern for one backend (the Codex CLI); this module generalizes it to a named\r\n    8: DELEGATE registry with two backend kinds, while keeping sol_bridge's discipline:\r\n    9: \r\n   10:   * NEVER retries, NEVER grinds, NEVER silently shrinks a request. A failure is\r\n   11:     a returned BridgeRun(ok=False) for the tool to surface upward.\r\n   12:   * PURE where possible: config parsing, work-order assembly, payload building,\r\n   13:     route resolution, and cost estimation take no ctx and do no IO â€” unit-tested\r\n   14:     without ever touching a network or the codex binary.\r\n   15:   * Preconditions raise BridgeError (the tool layer converts to\r\n   16:     TOOL_PRECONDITION); genuine provider failures are returned, not raised.\r\n   17: \r\n   18: BACKENDS\r\n   19:   cli   â€” the Codex CLI via sol_bridge.run_sol. Bills the user's ChatGPT plan\r\n   20:           quota (no API dollars). ALWAYS sandbox=read-only here: bridge\r\n   21:           delegates return TEXT; they never write files. (Asset authoring keeps\r\n   22:           its own dedicated path: sol_author_asset.)\r\n   23:   http  â€” any OpenAI-compatible chat-completions endpoint (OpenAI, DeepSeek,\r\n   24:           Mistral, Google-compat gateways, local servers) with the user's key\r\n   25:           from an env var. stdlib urllib only â€” no SDK sprawl.\r\n   26: \r\n   27: CONTAINMENT (adversarial ruling). A delegate exists only inside one tool call's\r\n   28: request/response: no MCP surface, no broker access, no filesystem, no exec.\r\n   29: Challenge output is normalized to a FINDINGS structure â€” data for adjudication,\r\n   30: never an instruction stream. The broker-side kind allowlist for the adversary\r\n   31: sender identity lives with the kind registry, not here.\r\n   32: \r\n   33: AUDIT. Every call appends one JSONL row (delegate, model, sizes, usage, cost\r\n   34: estimate, outcome) to `.bridge/audit-<scope>.jsonl` under the agent home â€” the\r\n   35: per-role cost accounting the budget machinery reads.\r\n   36: \"\"\"\r\n   37: \r\n   38: import json\r\n   39: import os\r\n   40: import time\r\n   41: import urllib.error\r\n   42: import urllib.request\r\n   43: from dataclasses import dataclass, field\r\n   44: from pathlib import Path\r\n   45: \r\n   46: from . import sol_bridge\r\n   47: \r\n   48: # â”€â”€ configuration seams â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n   49: \r\n   50: #: Path override for the delegate registry; default <EDP_AGENT_HOME>/.bridge.json\r\n   51: _CONFIG_ENV = \"EDP_BRIDGE_CONFIG\"\r\n   52: \r\n   53: #: Wall-clock ceiling for one HTTP delegate turn (the CLI backend keeps\r\n   54: #: sol_bridge's own 900s default).\r\n   55: _HTTP_TIMEOUT_ENV = \"EDP_BRIDGE_HTTP_TIMEOUT_SECS\"\r\n   56: _HTTP_TIMEOUT_DEFAULT = 600.0\r\n   57: \r\n   58: #: ~4 chars/token â€” the same estimator _bounds.py uses; good enough to refuse\r\n   59: #: an oversized work order BEFORE it is sent (never truncated silently).\r\n   60: _CHARS_PER_TOKEN = 4\r\n   61: \r\n   62: #: The tool-call kinds a delegate can serve. `challenge` is the adversary.\r\n   63: KINDS = (\"generate\", \"review\", \"consult\", \"challenge\")\r\n   64: \r\n   65: #: Challenge findings must land in this shape â€” data, never directives.\r\n   66: _CHALLENGE_CONTRACT = (\r\n   67:     \"Respond ONLY with a JSON array of findings. Each finding: \"\r\n   68:     '{\"finding\": <one-sentence defect claim>, \"evidence\": <why, concretely>, '\r\n   69:     '\"severity\": \"low\"|\"medium\"|\"high\", \"target\": <the id/part attacked>}. '\r\n   70:     \"No prose outside the JSON. An empty array means you found nothing.\")\r\n   71: \r\n   72: \r\n   73: class BridgeError(RuntimeError):\r\n   74:     \"\"\"A precondition the engine refuses to proceed past (unknown delegate,\r\n   75:     oversized work order, missing key). Tool layer â†’ TOOL_PRECONDITION.\"\"\"\r\n   76: \r\n   77: \r\n   78: # â”€â”€ delegate registry (PURE parsing; IO only in load_config) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n   79: @dataclass(frozen=True)\r\n   80: class Delegate:\r\n   81:     name: str\r\n   82:     backend: str                       # \"cli\" | \"http\"\r\n   83:     model: str                         # exact pinned id (doctrine: never aliases)\r\n   84:     effort: str | None = None          # medium is the fleet ruling default\r\n   85:     base_url: str | None = None        # http only\r\n   86:     api_key_env: str | None = None     # http only\r\n   87:     max_context_tokens: int = 250_000  # refuse oversized work orders up front\r\n   88:     max_output_tokens: int = 16_000\r\n   89:     price_in_per_mtok: float = 0.0     # 0.0 = subscription/plan quota (cli)\r\n   90:     price_out_per_mtok: float = 0.0\r\n   91:     # F34-h (2026-08-18, campaign R3 lesson): per-delegate wall-clock ceiling\r\n   92:     # for one CLI turn. None â†’ sol_bridge's default (EDP_SOL_TIMEOUT_SECS,\r\n   93:     # 900s). A deliberately DEEP delegate (a repo-scale adversary) gets its\r\n   94:     # longer leash HERE, in config â€” a timeout is a config decision, never an\r\n   95:     # agent's whim. The right-sizing law still applies first: one artifact\r\n   96:     # per turn; a hunt that needs more than one turn is a multi-turn thread,\r\n   97:     # not a mega-turn.\r\n   98:     timeout_secs: float | None = None\r\n   99: \r\n  100: \r\n  101: def parse_config(raw: dict) -> tuple[dict[str, Delegate], dict[str, str]]:\r\n  102:     \"\"\"PURE. `raw` is the decoded .bridge.json: {\"delegates\": {name: {...}},\r\n  103:     \"routes\": {\"role:task_class\": delegate_name}}. Validates hard â€” a bad\r\n  104:     registry entry is a config bug to fix now, not a runtime surprise later.\"\"\"\r\n  105:     delegates: dict[str, Delegate] = {}\r\n  106:     for name, row in (raw.get(\"delegates\") or {}).items():\r\n  107:         if not isinstance(row, dict):\r\n  108:             raise BridgeError(f\"delegate {name!r}: entry must be an object\")\r\n  109:         backend = row.get(\"backend\")\r\n  110:         if backend not in (\"cli\", \"http\"):\r\n  111:             raise BridgeError(\r\n  112:                 f\"delegate {name!r}: backend must be 'cli' or 'http', \"\r\n  113:                 f\"got {backend!r}\")\r\n  114:         model = row.get(\"model\")\r\n  115:         if not model or not isinstance(model, str):\r\n  116:             raise BridgeError(f\"delegate {name!r}: 'model' (exact id) is required\")\r\n  117:         if backend == \"http\" and not row.get(\"base_url\"):\r\n  118:             raise BridgeError(f\"delegate {name!r}: http backend needs 'base_url'\")\r\n  119:         if backend == \"http\" and not row.get(\"api_key_env\"):\r\n  120:             raise BridgeError(f\"delegate {name!r}: http backend needs \"\r\n  121:                               f\"'api_key_env' (env var NAME, never the key itself)\")\r\n  122:         delegates[name] = Delegate(\r\n  123:             name=name, backend=backend, model=model,\r\n  124:             effort=row.get(\"effort\"),\r\n  125:             base_url=row.get(\"base_url\"),\r\n  126:             api_key_env=row.get(\"api_key_env\"),\r\n  127:             max_context_tokens=int(row.get(\"max_context_tokens\", 250_000)),\r\n  128:             max_output_tokens=int(row.get(\"max_output_tokens\", 16_000)),\r\n  129:             price_in_per_mtok=float(row.get(\"price_in_per_mtok\", 0.0)),\r\n  130:             price_out_per_mtok=float(row.get(\"price_out_per_mtok\", 0.0)),\r\n  131:             timeout_secs=(float(row[\"timeout_secs\"])\r\n  132:                           if row.get(\"timeout_secs\") else None),\r\n  133:         )\r\n  134: \r\n  135:     routes: dict[str, str] = {}\r\n  136:     for key, target in (raw.get(\"routes\") or {}).items():\r\n  137:         if key.startswith(\"_\"):\r\n  138:             continue        # comment key (the _doc convention), not a route\r\n  139:         if target not in delegates:\r\n  140:             raise BridgeError(\r\n  141:                 f\"route {key!r} names unknown delegate {target!r} \"\r\n  142:                 f\"(known: {sorted(delegates)})\")\r\n  143:         routes[key] = target\r\n  144:     return delegates, routes\r\n  145: \r\n  146: \r\n  147: def config_path() -> Path:\r\n  148:     override = os.environ.get(_CONFIG_ENV, \"\").strip()\r\n  149:     if override:\r\n  150:         return Path(override)\r\n  151:     home = os.environ.get(\"EDP_AGENT_HOME\") or os.getcwd()\r\n  152:     return Path(home) / \".bridge.json\"\r\n  153: \r\n  154: \r\n  155: def load_config() -> tuple[dict[str, Delegate], dict[str, str]]:\r\n  156:     f = config_path()\r\n  157:     if not f.is_file():\r\n  158:         raise BridgeError(\r\n  159:             f\"no bridge config at {f} â€” create .bridge.json with a 'delegates' \"\r\n  160:             f\"map (see docs) or set {_CONFIG_ENV}.\")\r\n  161:     try:\r\n  162:         raw = json.loads(f.read_text(encoding=\"utf-8\"))\r\n  163:     except (OSError, json.JSONDecodeError) as e:\r\n  164:         raise BridgeError(f\"bridge config {f} unreadable: {e}\") from e\r\n  165:     return parse_config(raw)\r\n  166: \r\n  167: \r\n  168: def route_for(role: str, task_class: str, routes: dict[str, str]) -> str | None:\r\n  169:     \"\"\"PURE. Deterministic route lookup â€” `role:task_class`, then `role:*`,\r\n  170:     then None (= do not delegate). No agent ever chooses a model.\"\"\"\r\n  171:     return routes.get(f\"{role}:{task_class}\") or routes.get(f\"{role}:*\")\r\n  172: \r\n  173: \r\n  174: # â”€â”€ work-order assembly (PURE) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  175: def approx_tokens(text: str) -> int:\r\n  176:     return max(1, len(text) // _CHARS_PER_TOKEN)\r\n  177: \r\n  178: \r\n  179: def build_work_order(*, task: str, context: str = \"\",\r\n  180:                      acceptance: str = \"\", kind: str = \"generate\") -> str:\r\n  181:     \"\"\"PURE. One self-contained prompt: the delegate sees ONLY this â€” it has no\r\n  182:     tools and no way to ask follow-ups, so the caller must include everything\r\n  183:     (action fields, relevant file content, the spec-doc excerpt it selected).\"\"\"\r\n  184:     if kind not in KINDS:\r\n  185:         raise BridgeError(f\"kind must be one of {KINDS}, got {kind!r}\")\r\n  186:     if not task or not task.strip():\r\n  187:         raise BridgeError(\"task is empty â€” nothing to delegate.\")\r\n  188:     parts = [f\"# Task ({kind})\", task.strip()]\r\n  189:     if context.strip():\r\n  190:         parts += [\"# Context (complete â€” you cannot ask follow-ups)\",\r\n  191:                   context.strip()]\r\n  192:     if acceptance.strip():\r\n  193:         parts += [\"# Acceptance criteria (your output is judged against these)\",\r\n  194:                   acceptance.strip()]\r\n  195:     if kind == \"challenge\":\r\n  196:         parts += [\"# Output contract\", _CHALLENGE_CONTRACT]\r\n  197:     elif kind == \"review\":\r\n  198:         parts += [\"# Output contract\",\r\n  199:                   \"List concrete defects with evidence, then a one-line \"\r\n  200:                   \"verdict: PASS or FAIL(reasons). You are a pre-screen; a \"\r\n  201:                   \"senior reviewer adjudicates â€” be precise, not polite.\"]\r\n  202:     return \"\\n\\n\".join(parts)\r\n  203: \r\n  204: \r\n  205: def check_budget(delegate: Delegate, work_order: str) -> None:\r\n  206:     \"\"\"Refuse an order that cannot fit the delegate's window â€” loudly, before\r\n  207:     any spend. Silent truncation is forbidden (CONTENT-payload doctrine).\"\"\"\r\n  208:     # F38#11: a CLI delegate ALSO has the 30KB argv cap (Windows command\r\n  209:     # line) â€” far tighter than any token window. Refuse here, in the\r\n  210:     # documented BridgeError shape, before a slot is taken or spend risked.\r\n  211:     if delegate.backend == \"cli\":\r\n  212:         from . import sol_bridge as _sb\r\n  213:         nbytes = len(work_order.encode(\"utf-8\"))\r\n  214:         if nbytes > _sb._PROMPT_MAX_BYTES:\r\n  215:             raise BridgeError(\r\n  216:                 f\"work order is {nbytes} bytes; a CLI delegate passes it as \"\r\n  217:                 f\"one argv element and Windows caps the command line near \"\r\n  218:                 f\"32KB â€” keep it under {_sb._PROMPT_MAX_BYTES} bytes \"\r\n  219:                 f\"(tighter context, or reference files the delegate can \"\r\n  220:                 f\"read from its workspace).\")\r\n  221:     need = approx_tokens(work_order) + delegate.max_output_tokens\r\n  222:     if need > delegate.max_context_tokens:\r\n  223:         raise BridgeError(\r\n  224:             f\"work order â‰ˆ{approx_tokens(work_order)} tokens + \"\r\n  225:             f\"{delegate.max_output_tokens} output exceeds {delegate.name}'s \"\r\n  226:             f\"{delegate.max_context_tokens}-token window. Shrink the context \"\r\n  227:             f\"(reference fewer files / tighter spec excerpt) â€” the bridge never \"\r\n  228:             f\"truncates silently.\")\r\n  229: \r\n  230: \r\n  231: # â”€â”€ HTTP payload (PURE) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  232: def build_http_payload(delegate: Delegate, work_order: str) -> dict:\r\n  233:     payload = {\r\n  234:         \"model\": delegate.model,\r\n  235:         \"messages\": [{\"role\": \"user\", \"content\": work_order}],\r\n  236:         \"max_tokens\": delegate.max_output_tokens,\r\n  237:         \"stream\": False,\r\n  238:     }\r\n  239:     if delegate.effort:\r\n  240:         payload[\"reasoning_effort\"] = delegate.effort\r\n  241:     return payload\r\n  242: \r\n  243: \r\n  244: def estimate_cost(delegate: Delegate, tokens_in: int, tokens_out: int) -> float:\r\n  245:     \"\"\"PURE. USD estimate; 0.0 for subscription-billed (cli) delegates.\"\"\"\r\n  246:     return (tokens_in * delegate.price_in_per_mtok\r\n  247:             + tokens_out * delegate.price_out_per_mtok) / 1_000_000\r\n  248: \r\n  249: \r\n  250: # â”€â”€ result shape â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  251: @dataclass\r\n  252: class BridgeRun:\r\n  253:     \"\"\"`ok` is the ONLY branch point: False â†’ surface a blocker upward, STOP.\r\n  254:     `findings` is populated for kind=challenge (parsed, best-effort).\"\"\"\r\n  255:     ok: bool\r\n  256:     delegate: str\r\n  257:     model: str\r\n  258:     kind: str\r\n  259:     content: str = \"\"\r\n  260:     findings: list[dict] = field(default_factory=list)\r\n  261:     tokens_in: int = 0\r\n  262:     tokens_out: int = 0\r\n  263:     cost_usd: float = 0.0\r\n  264:     error: str | None = None\r\n  265: \r\n  266: \r\n  267: def parse_findings(content: str) -> list[dict] | None:\r\n  268:     \"\"\"PURE, defensive. Extract the findings array from a challenge reply.\r\n  269: \r\n  270:     F38#6 â€” the return now DISTINGUISHES the two zero-findings cases:\r\n  271:     * [] â€” the delegate returned a VALID (possibly empty) findings array:\r\n  272:       a real hunt found nothing. Legal, satisfies the contract.\r\n  273:     * None â€” the reply broke the contract (no parseable JSON array). The\r\n  274:       caller must treat this as a FAILED challenge, never a clean pass:\r\n  275:       arbitrary/prompt-injected prose used to read as findings=[] and\r\n  276:       satisfy G-CHALLENGE.\r\n  277:     \"\"\"\r\n  278:     text = content.strip()\r\n  279:     start, end = text.find(\"[\"), text.rfind(\"]\")\r\n  280:     if start == -1 or end <= start:\r\n  281:         return None\r\n  282:     try:\r\n  283:         arr = json.loads(text[start:end + 1])\r\n  284:     except json.JSONDecodeError:\r\n  285:         return None\r\n  286:     if not isinstance(arr, list):\r\n  287:         return None\r\n  288:     out = []\r\n  289:     for f in arr if isinstance(arr, list) else []:\r\n  290:         if isinstance(f, dict) and isinstance(f.get(\"finding\"), str):\r\n  291:             out.append({\r\n  292:                 \"finding\": f[\"finding\"],\r\n  293:                 \"evidence\": str(f.get(\"evidence\", \"\")),\r\n  294:                 \"severity\": f.get(\"severity\") if f.get(\"severity\") in\r\n  295:                             (\"low\", \"medium\", \"high\") else \"medium\",\r\n  296:                 \"target\": str(f.get(\"target\", \"\")),\r\n  297:             })\r\n  298:     return out\r\n  299: \r\n  300: \r\n  301: # â”€â”€ audit sidecar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  302: def _audit_file(scope: str) -> Path:\r\n  303:     home = os.environ.get(\"EDP_AGENT_HOME\") or os.getcwd()\r\n  304:     safe = \"\".join(c if c.isalnum() or c in \"-_.\" else \"_\" for c in scope) or \"anon\"\r\n  305:     return Path(home) / \".bridge\" / f\"audit-{safe}.jsonl\"\r\n  306: \r\n  307: \r\n  308: def audit(scope: str, row: dict) -> None:\r\n  309:     \"\"\"Append-only, best-effort â€” an audit failure never blocks a result.\"\"\"\r\n  310:     try:\r\n  311:         f = _audit_file(scope)\r\n  312:         f.parent.mkdir(parents=True, exist_ok=True)\r\n  313:         with f.open(\"a\", encoding=\"utf-8\") as fh:\r\n  314:             fh.write(json.dumps(row, ensure_ascii=False) + \"\\n\")\r\n  315:     except OSError:\r\n  316:         pass\r\n  317: \r\n  318: \r\n  319: # â”€â”€ the impure entrypoints â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\r\n  320: def _redact_secret(text: str, secret: str) -> str:\r\n  321:     \"\"\"F37#8 â€” provider error bodies / response echoes return to the agent\r\n  322:     AND land in the audit sidecar; strip the bearer key before either.\"\"\"\r\n  323:     if secret and secret in text:\r\n  324:         return text.replace(secret, \"Â«redacted-api-keyÂ»\")\r\n  325:     return text\r\n  326: \r\n  327: \r\n  328: def _run_http(delegate: Delegate, work_order: str) -> tuple[str, int, int, str | None]:\r\n  329:     \"\"\"One chat-completions call. Returns (content, tokens_in, tokens_out,\r\n  330:     error). No retries â€” a provider failure is the caller's signal, not ours to\r\n  331:     massage away.\"\"\"\r\n  332:     key_env = delegate.api_key_env or \"\"\r\n  333:     key = os.environ.get(key_env, \"\").strip()\r\n  334:     if not key:\r\n  335:         raise BridgeError(\r\n  336:             f\"delegate {delegate.name!r}: env var {key_env!r} is empty â€” export \"\r\n  337:             f\"the provider API key there (the registry stores the NAME only).\")\r\n  338:     url = (delegate.base_url or \"\").rstrip(\"/\") + \"/chat/completions\"\r\n  339:     body = json.dumps(build_http_payload(delegate, work_order)).encode(\"utf-8\")\r\n  340:     req = urllib.request.Request(\r\n  341:         url, data=body, method=\"POST\",\r\n  342:         headers={\"Content-Type\": \"application/json\",\r\n  343:                  \"Authorization\": f\"Bearer {key}\"})\r\n  344:     timeout = float(os.environ.get(_HTTP_TIMEOUT_ENV, _HTTP_TIMEOUT_DEFAULT))\r\n  345:     try:\r\n  346:         with urllib.request.urlopen(req, timeout=timeout) as resp:\r\n  347:             body_text = resp.read().decode(\"utf-8\", errors=\"replace\")\r\n  348:         try:\r\n  349:             data = json.loads(body_text)\r\n  350:         except json.JSONDecodeError:\r\n  351:             # F38#12: HTTP 200 with a non-JSON body (proxy error page,\r\n  352:             # truncated stream) is a PROVIDER failure â€” the documented\r\n  353:             # ok=false path, never an uncaught exception that skips audit.\r\n  354:             return \"\", 0, 0, (\r\n  355:                 f\"{delegate.name} returned HTTP 200 with a non-JSON body: \"\r\n  356:                 f\"{_redact_secret(body_text[:300], key)!r}. First-class \"\r\n  357:                 f\"blocker â€” surface upward, do NOT retry-loop.\")\r\n  358:     except urllib.error.HTTPError as e:\r\n  359:         detail = \"\"\r\n  360:         try:\r\n  361:             detail = e.read().decode(\"utf-8\", errors=\"replace\")[:500]\r\n  362:         except OSError:\r\n  363:             pass\r\n  364:         detail = _redact_secret(detail, key)  # F37#8\r\n  365:         return \"\", 0, 0, (f\"HTTP {e.code} from {delegate.name}: {detail or e.reason}. \"\r\n  366:                           f\"First-class blocker â€” surface upward, do NOT retry-loop.\")\r\n  367:     except (urllib.error.URLError, TimeoutError, OSError) as e:\r\n  368:         return \"\", 0, 0, (f\"could not reach {delegate.name} \"\r\n  369:                           f\"({_redact_secret(str(e), key)}). First-class \"\r\n  370:                           f\"blocker â€” surface upward, do NOT retry-loop.\")\r\n  371:     try:\r\n  372:         content = data[\"choices\"][0][\"message\"][\"content\"] or \"\"\r\n  373:     except (KeyError, IndexError, TypeError):\r\n  374:         return \"\", 0, 0, (f\"{delegate.name} returned an unrecognized response \"\r\n  375:                           f\"shape: {_redact_secret(str(data)[:300], key)}\")\r\n  376:     usage = data.get(\"usage\") or {}\r\n  377:     try:\r\n  378:         tin = int(usage.get(\"prompt_tokens\", 0) or 0)\r\n  379:         tout = int(usage.get(\"completion_tokens\", 0) or 0)\r\n  380:     except (TypeError, ValueError):\r\n  381:         tin = tout = 0     # malformed usage: report unknown, never raise\r\n  382:     return content, tin, tout, None\r\n  383: \r\n  384: \r\n  385: #: ToS-safety concurrency cap for subscription-CLI delegates (user ruling\r\n  386: #: 2026-08-07): N shells calling codex simultaneously looks like automated\r\n  387: #: hammering of a consumer ChatGPT plan. Cross-PROCESS slot lock (every\r\n  388: #: shell's MCP server is a separate process, so an in-process semaphore\r\n  389: #: guards nothing): atomic mkdir slots under the agent home. Default 2\r\n  390: #: concurrent codex turns fleet-wide; EDP_BRIDGE_CLI_MAX=1 serializes.\r\n  391: _CLI_MAX_ENV = \"EDP_BRIDGE_CLI_MAX\"\r\n  392: _CLI_SLOT_WAIT_S = 900.0            # matches sol_bridge's turn ceiling\r\n  393: # F38#4: staleness must EXCEED every legal delegate timeout (per-delegate\r\n  394: # timeout_secs goes to 1800), or the reaper steals a slot from a live\r\n  395: # long-running turn and the concurrency cap collapses. 2400 = 1800 + margin.\r\n  396: _CLI_SLOT_STALE_S = 2400.0          # reap a slot from a crashed process\r\n  397: \r\n  398: \r\n  399: def _pid_alive(pid: int) -> bool:\r\n  400:     \"\"\"Best-effort cross-platform liveness probe; unknown reads as ALIVE\r\n  401:     (never steal a slot we cannot prove is dead). NOTE: os.kill(pid, 0) is a\r\n  402:     POSIX idiom â€” on Windows signal 0 is CTRL_C_EVENT, not a probe â€” so\r\n  403:     Windows takes a ctypes OpenProcess path (F38#4).\"\"\"\r\n  404:     if pid <= 0:\r\n  405:         return False\r\n  406:     import sys\r\n  407:     if sys.platform == \"win32\":\r\n  408:         import ctypes\r\n  409:         from ctypes import wintypes\r\n  410:         PROCESS_QUERY_LIMITED_INFORMATION = 0x1000\r\n  411:         STILL_ACTIVE = 259\r\n  412:         ERROR_INVALID_PARAMETER = 87\r\n  413:         # use_last_error=True + get_last_error(): the raw\r\n  414:         # windll.kernel32.GetLastError() reads whatever the interpreter's\r\n  415:         # own intervening Win32 calls left behind â€” a stale value here\r\n  416:         # would misclassify dead-vs-alive. restype=HANDLE: the default\r\n  417:         # c_int restype truncates a 64-bit HANDLE.\r\n  418:         k32 = ctypes.WinDLL(\"kernel32\", use_last_error=True)\r\n  419:         k32.OpenProcess.restype = wintypes.HANDLE\r\n  420:         k32.OpenProcess.argtypes = (wintypes.DWORD, wintypes.BOOL,\r\n  421:                                     wintypes.DWORD)\r\n  422:         k32.GetExitCodeProcess.argtypes = (wintypes.HANDLE,\r\n  423:                                            ctypes.POINTER(wintypes.DWORD))\r\n  424:         k32.CloseHandle.argtypes = (wintypes.HANDLE,)\r\n  425:         handle = k32.OpenProcess(\r\n  426:             PROCESS_QUERY_LIMITED_INFORMATION, False, pid)\r\n  427:         if not handle:\r\n  428:             # invalid-parameter = no such process â†’ dead; anything else\r\n  429:             # (e.g. access-denied) is unprovable â†’ treat as alive.\r\n  430:             return ctypes.get_last_error() != ERROR_INVALID_PARAMETER\r\n  431:         try:\r\n  432:             code = wintypes.DWORD()\r\n  433:             if k32.GetExitCodeProcess(handle, ctypes.byref(code)):\r\n  434:                 return code.value == STILL_ACTIVE\r\n  435:             return True\r\n  436:         finally:\r\n  437:             k32.CloseHandle(handle)\r\n  438:     try:\r\n  439:         os.kill(pid, 0)\r\n  440:         return True\r\n  441:     except ProcessLookupError:\r\n  442:         return False\r\n  443:     except OSError:\r\n  444:         return True     # exists but not ours to signal\r\n  445: \r\n  446: \r\n  447: def _cli_slot_acquire() -> tuple[Path, str] | None:\r\n  448:     home = Path(os.environ.get(\"EDP_AGENT_HOME\") or os.getcwd())\r\n  449:     slots_dir = home / \".bridge\" / \"cli-slots\"\r\n  450:     slots_dir.mkdir(parents=True, exist_ok=True)\r\n  451:     try:\r\n  452:         n = max(1, int(os.environ.get(_CLI_MAX_ENV, \"2\")))\r\n  453:     except ValueError:\r\n  454:         n = 2\r\n  455:     nonce = f\"{os.getpid()}-{time.time_ns()}\"\r\n  456:     deadline = time.time() + _CLI_SLOT_WAIT_S\r\n  457:     while time.time() < deadline:\r\n  458:         reaped = False\r\n  459:         for i in range(n):\r\n  460:             slot = slots_dir / f\"slot-{i}.lock\"\r\n  461:             try:\r\n  462:                 slot.mkdir()                     # atomic acquire\r\n  463:                 (slot / \"pid\").write_text(str(os.getpid()))\r\n  464:                 # F38#4: ownership nonce â€” release only removes a slot it\r\n  465:                 # still owns, so a reaped-and-reacquired slot cannot be\r\n  466:                 # deleted by its previous holder's finally block.\r\n  467:                 (slot / \"nonce\").write_text(nonce)\r\n  468:                 return slot, nonce\r\n  469:             except FileExistsError:\r\n  470:                 # reap ONLY a slot that is both aged AND provably dead â€”\r\n  471:                 # age alone stole slots from live long-running turns.\r\n  472:                 try:\r\n  473:                     age = time.time() - slot.stat().st_mtime\r\n  474:                     if age <= _CLI_SLOT_STALE_S:\r\n  475:                         continue\r\n  476:                     pid_raw = (slot / \"pid\").read_text().strip()\r\n  477:                     if pid_raw.isdigit() and _pid_alive(int(pid_raw)):\r\n  478:                         continue\r\n  479:                     (slot / \"pid\").unlink(missing_ok=True)\r\n  480:                     (slot / \"nonce\").unlink(missing_ok=True)\r\n  481:                     slot.rmdir()\r\n  482:                     reaped = True                # retry acquisition at once\r\n  483:                 except OSError:\r\n  484:                     pass\r\n  485:         if reaped:\r\n  486:             continue                             # skip the wait â€” a slot freed\r\n  487:         time.sleep(2.0)\r\n  488:     return None\r\n  489: \r\n  490: \r\n  491: def _cli_slot_release(slot: Path | None, nonce: str | None = None) -> None:\r\n  492:     if slot is None:\r\n  493:         return\r\n  494:     try:\r\n  495:         if nonce is not None:\r\n  496:             try:\r\n  497:                 if (slot / \"nonce\").read_text().strip() != nonce:\r\n  498:                     return      # no longer ours (reaped + reacquired)\r\n  499:             except OSError:\r\n  500:                 pass            # nonce unreadable â€” fall through, best effort\r\n  501:         (slot / \"pid\").unlink(missing_ok=True)\r\n  502:         (slot / \"nonce\").unlink(missing_ok=True)\r\n  503:         slot.rmdir()\r\n  504:     except OSError:\r\n  505:         pass\r\n  506: \r\n  507: \r\n  508: def _run_cli(delegate: Delegate, work_order: str, caller: str,\r\n  509:              kind: str) -> tuple[str, int, int, str | None]:\r\n  510:     \"\"\"One Codex-CLI turn via sol_bridge â€” ALWAYS read-only sandbox: bridge\r\n  511:     delegates return text, they never write. Thread stickiness per\r\n  512:     (caller, delegate) via sol_bridge's own store; a challenge always starts a\r\n  513:     FRESH thread so the adversary never accretes sympathy for prior context.\r\n  514:     Fleet-wide concurrency is slot-capped (see _CLI_MAX_ENV above): a shell\r\n  515:     that cannot get a slot within the wait window gets a BLOCKER, never a\r\n  516:     pile-on.\"\"\"\r\n  517:     acquired = _cli_slot_acquire()\r\n  518:     if acquired is None:\r\n  519:         return \"\", 0, 0, (\r\n  520:             f\"no codex slot free within {_CLI_SLOT_WAIT_S:.0f}s \"\r\n  521:             f\"({_CLI_MAX_ENV} caps fleet-wide concurrent sol turns to \"\r\n  522:             f\"protect the ChatGPT plan) â€” surface upward and continue other \"\r\n  523:             f\"work; do NOT retry-loop.\")\r\n  524:     slot, nonce = acquired\r\n  525:     try:\r\n  526:         import tempfile\r\n  527:         workdir = str(Path(tempfile.gettempdir()) / \"edp-bridge\"\r\n  528:                       / delegate.name)\r\n  529:         run = sol_bridge.run_sol(\r\n  530:             prompt=work_order, workdir=workdir, sandbox=\"read-only\",\r\n  531:             caller=caller, advisor=delegate.name, effort=delegate.effort,\r\n  532:             new_thread=(kind == \"challenge\"),\r\n  533:             timeout_secs=delegate.timeout_secs,\r\n  534:             # F38#1: the registry's pin reaches the CLI (-m) instead of the\r\n  535:             # CLI default running while the audit claims the pinned model.\r\n  536:             model=delegate.model)\r\n  537:         content = run.last_message or \"\\n\".join(run.agent_messages)\r\n  538:         return content, 0, 0, (None if run.ok else run.error)\r\n  539:     except sol_bridge.SolBridgeError as e:\r\n  540:         # F38#11: a CLI precondition (oversized argv, missing binary) must\r\n  541:         # cross the tool boundary as the documented BridgeError shape, not\r\n  542:         # an uncaught exception that skips the audit row.\r\n  543:         raise BridgeError(str(e)) from e\r\n  544:     finally:\r\n  545:         _cli_slot_release(slot, nonce)\r\n  546: \r\n  547: \r\n  548: def delegate_call(*, kind: str, delegate_name: str, task: str,\r\n  549:                   context: str = \"\", acceptance: str = \"\",\r\n  550:                   caller: str = \"anon\") -> BridgeRun:\r\n  551:     \"\"\"Run ONE delegated turn. Preconditions raise BridgeError; provider\r\n  552:     failures return BridgeRun(ok=False). Every call is audit-logged.\"\"\"\r\n  553:     delegates, _routes = load_config()\r\n  554:     d = delegates.get(delegate_name)\r\n  555:     if d is None:\r\n  556:         raise BridgeError(f\"unknown delegate {delegate_name!r} \"\r\n  557:                           f\"(known: {sorted(delegates)})\")\r\n  558:     order = build_work_order(task=task, context=context,\r\n  559:                              acceptance=acceptance, kind=kind)\r\n  560:     check_budget(d, order)\r\n  561: \r\n  562:     t0 = time.time()\r\n  563:     if d.backend == \"http\":\r\n  564:         content, tin, tout, err = _run_http(d, order)\r\n  565:     else:\r\n  566:         content, tin, tout, err = _run_cli(d, order, caller, kind)\r\n  567:     # F38#13: usage is estimated (and cost computed) only for a call the\r\n  568:     # provider actually served â€” a connection-refused attempt used to be\r\n  569:     # audited as full estimated spend and eat the budget for money never\r\n  570:     # spent. A failed call records zeros; billing truth stays with `ok`.\r\n  571:     if err is None:\r\n  572:         tin = tin or approx_tokens(order)      # cli reports no usage; estimate\r\n  573:         tout = tout or approx_tokens(content)\r\n  574:         cost = estimate_cost(d, tin, tout)\r\n  575:     else:\r\n  576:         tin = tout = 0\r\n  577:         cost = 0.0\r\n  578: \r\n  579:     run = BridgeRun(ok=err is None, delegate=d.name, model=d.model, kind=kind,\r\n  580:                     content=content, tokens_in=tin, tokens_out=tout,\r\n  581:                     cost_usd=round(cost, 6), error=err)\r\n  582:     if kind == \"challenge\" and run.ok:\r\n  583:         parsed = parse_findings(content)\r\n  584:         if parsed is None:\r\n  585:             # F38#6: a reply that broke the findings contract is a FAILED\r\n  586:             # challenge â€” ok=false, raw text quarantined in content for\r\n  587:             # diagnostics, never returned as a satisfied adversarial pass.\r\n  588:             run.ok = False\r\n  589:             run.error = (\r\n  590:                 \"challenge reply broke the findings contract (no JSON \"\r\n  591:                 \"array) â€” the adversarial pass did NOT happen. Re-run the \"\r\n  592:                 \"challenge; do not treat the raw text as findings.\")\r\n  593:         else:\r\n  594:             run.findings = parsed\r\n  595: \r\n  596:     audit(caller, {\r\n  597:         \"ts\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\r\n  598:         \"kind\": kind, \"delegate\": d.name, \"model\": d.model,\r\n  599:         # F38#5: lineage for budget attribution â€” the caller handle rides\r\n  600:         # on every row so spend can be scoped to its recipe.\r\n  601:         \"caller\": caller,\r\n  602:         \"order_bytes\": len(order.encode(\"utf-8\")),\r\n  603:         \"tokens_in\": tin, \"tokens_out\": tout, \"cost_usd\": run.cost_usd,\r\n  604:         \"ok\": run.ok, \"error\": (run.error or \"\")[:300],\r\n  605:         \"findings\": len(run.findings), \"secs\": round(time.time() - t0, 1),\r\n  606:     })\r\n  607:     return run\r\n","exit_code":0,"status":"completed"}}
