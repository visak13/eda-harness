merge; the critical planes (rx.worklog,\r\n14772:     # rx.broker, rx.recipe_events) are NEVER limited, at any setting.\r\n14773:     #\r\n14774:     # It was a debounce on the MERGED stream until s29, and that DISCARDED a\r\n14775:     # worker's `done` whenever a poller was merged in (debounce waits for a\r\n14776:     # quiet that a 2s poller never allows, and keeps only the burst's last\r\n14777:     # item). Never rate-limit a merged stream. Wired via --min-interval-ms.\r\n14778:     min_interval_ms: float = 0.0\r\n14779: \r\n14780: \r\n14781: class _ObserveOut(BaseModel):\r\n14782:     subscription_id: str\r\n14783:     bound_to: list[str]                    # source names the spec referenced\r\n14784:     monitor_cmd: str                       # run THIS under the Monitor tool\r\n14785:     has_effect: bool = False               # True â†’ a governed effect is wired\r\n14786:     reused: bool = False                   # True â†’ an identical subscription\r\n14787:                                            # already exists; DO NOT start a\r\n14788:                                            # second Monitor (idempotent reuse,\r\n14789:                                            # s17 FA2-F2 / RC2)\r\n14790: \r\n14791: \r\n14792: # Default lifetime after which an idle .reactive/sub-*.spec artifact triplet\r\n14793: # (.spec + .bindings.json + .effect.json) is eligible for garbage collection\r\n14794: # on the NEXT observe() call. A live subscription rewrites/refreshes its spec\r\n14795: # at arm time, so its mtime is always recent â€” only abandoned artifacts from\r\n14796: # closed shells age past this and get swept. Override with the env var.\r\n14797: # (s17 FA2-F2 / RC2: bound the 777-and-growing leak.)\r\n14798: _REACTIVE_SPEC_TTL_SECS = int(\r\n14799:     os.environ.get(\"EDP_REACTIVE_SPEC_TTL_SECS\", str(24 * 3600)))\r\n14800: \r\n14801: \r\n14802: def _subscription_matches(root: Path, sid: str, spec: str,\r\n14803:                           bindings: dict, effect: dict | None) -> bool:\r\n14804:     \"\"\"True iff a persisted subscription `sid` is byte-identical to the\r\n14805:     (spec, bindings, effect) being requested now. Used to make observe()\r\n14806:     IDEMPOTENT: re-arming the SAME subscription returns the existing one\r\n14807:     (reused=True) instead of minting a duplicate driver (s17 FA2-F2 / RC2).\r\n14808:     A differing spec/bindings/effect under the same sid is a genuine\r\n14809:     re-spec and is NOT a match (the caller overwrites + re-arms).\"\"\"\r\n14810:     spec_path = root / f\"{sid}.spec\"\r\n14811:     if not spec_path.exists():\r\n14812:         return False\r\n14813:     try:\r\n14814:         if spec_path.read_text(encoding=\"utf-8\") != spec:\r\n14815:             return False\r\n14816:         # bindings: file present iff bindings non-empty; content must match.\r\n14817:         b_path = root / f\"{sid}.bindings.json\"\r\n14818:         if bindings:\r\n14819:             if not b_path.exists() or \\\r\n14820:                     b_path.read_text(encoding=\"utf-8\") != json.dumps(bindings):\r\n14821:                 return False\r\n14822:         elif b_path.exists():\r\n14823:             return False\r\n14824:         # effect: file present iff an effect was wired; content must match.\r\n14825:         e_path = root / f\"{sid}.effect.json\"\r\n14826:         if effect is not None:\r\n14827:             if not e_path.exists():\r\n14828:                 return False\r\n14829:         elif e_path.exists():\r\n14830:             return False\r\n14831:     except OSError:\r\n14832:         return False\r\n14833:     return True\r\n14834: \r\n14835: \r\n14836: def _gc_stale_subscriptions(root: Path, *, keep: str, ttl_secs: int,\r\n14837:                             now_ts: float) -> int:\r\n14838:     \"\"\"Sweep abandoned `.reactive/sub-*.spec` artifact triplets whose spec\r\n14839:     file is older than `ttl_secs`, returning the count of triplets removed.\r\n14840: \r\n14841:     Age-scoped: a LIVE subscription re-writes its `.spec` at arm time, so its\r\n14842:     mtime stays recent and it is never swept; only artifacts left behind by\r\n14843:     closed shells age past the TTL. Never removes the `keep` sid (the one\r\n14844:     being armed right now). Only touches `sub-*.{spec,bindings.json,effect.json}`\r\n14845:     directly under `root` â€” the `registry/` and `effect_audit/` SUBDIRS (the\r\n14846:     durable rule registry + the governed-effect audit trail) are left intact.\r\n14847:     Best-effort: a per-file error is logged and skipped, never fatal to the\r\n14848:     observe() call (s17 FA2-F2 / RC2 â€” bound the unbounded leak).\"\"\"\r\n14849:     removed = 0\r\n14850:     try:\r\n14851:         candidates = list(root.glob(\"sub-*.spec\"))\r\n14852:     except OSError:\r\n14853:         return 0\r\n14854:     # 2026-08-17 (live incident, s4 planner resume): a subscription the\r\n14855:     # handle index points at is NOT swept at the ordinary TTL â€” the sweep\r\n14856:     # used to take a parked shell's spec and the resume rewire then handed\r\n14857:     # back EMPTY wiring. F32 refinement (Sol-review #7): \"never\" became an\r\n14858:     # immortality bug of its own (an orphaned indexed sid from a dead shell\r\n14859:     # lived forever) â€” indexed sids now age out at a LONG ttl\r\n14860:     # (EDP_REACTIVE_INDEXED_TTL_SECS, default 7 days) and are UNREGISTERED\r\n14861:     # from the index on sweep, so a later rewire honestly says \"no wiring â€”\r\n14862:     # arm_wiring()\" instead of pointing at a ghost.\r\n14863:     try:\r\n14864:         from ..reactive.handle_index import all_indexed_sids\r\n14865:         indexed = all_indexed_sids(root)\r\n14866:     except Exception:  # noqa: BLE001 â€” an unreadable index must not stop GC\r\n14867:         indexed = set()\r\n14868:     try:\r\n14869:         indexed_ttl = int(os.environ.get(\r\n14870:             \"EDP_REACTIVE_INDEXED_TTL_SECS\", str(7 * 24 * 3600)))\r\n14871:     except ValueError:\r\n14872:         indexed_ttl = 7 * 24 * 3600\r\n14873:     for spec_path in candidates:\r\n14874:         sid = spec_path.name[:-len(\".spec\")]\r\n14875:         if sid == keep:\r\n14876:             continue\r\n14877:         if sid in indexed:\r\n14878:             try:\r\n14879:                 if now_ts - spec_path.stat().st_mtime <= indexed_ttl:\r\n14880:                     continue\r\n14881:             except OSError:\r\n14882:                 continue\r\n14883:             # aged past even the long TTL â€” drop the index entry too.\r\n14884:             try:\r\n14885:                 from ..reactive.handle_index import (\r\n14886:                     _load as _hi_load, unregister_subscription)\r\n14887:                 for h, sids in _hi_load(root).items():\r\n14888:                     if sid in sids:\r\n14889:                         unregister_subscription(root, h, sid)\r\n14890:             except Exception:  # noqa: BLE001 â€” best-effort\r\n14891:                 pass\r\n14892:         try:\r\n14893:             if now_ts - spec_path.stat().st_mtime <= ttl_secs:\r\n14894:                 continue\r\n14895:             for suffix in (\".spec\", \".bindings.json\", \".effect.json\"):\r\n14896:                 p = root / f\"{sid}{suffix}\"\r\n14897:                 if p.exists():\r\n14898:                     p.unlink()\r\n14899:             removed += 1\r\n14900:         except OSError as exc:\r\n14901:             _log.warning(\"observe_gc_skip\", f\"could not sweep {sid}: {exc}\",\r\n14902:                          sid=sid)\r\n14903:             continue\r\n14904:     return removed\r\n14905: \r\n14906: \r\n14907: class ObserveStream(_ClaudeTool):\r\n14908:     \"\"\"Set up a reactive subscription (REACTIVE-STREAMS.md). `spec` is a\r\n14909:     single RxPY expression over `rx` (sources + operators); the tool\r\n14910:     validates it compiles to an Observable (no I/O), persists it, and\r\n14911:     returns a command to run under the harness `Monitor` tool â€” **one\r\n14912:     Monitor per observe() call = one Subscription**. The sink only WAKES +\r\n14913:     delivers; mutation stays in the object/CRUD surface. A bad spec returns\r\n14914:     a consumable error, never a silent no-op. OPTIONAL: pass `effect` (a\r\n14915:     governed EffectSpec dict) + `owner` to turn it into an ACTIONABLE reflex\r\n14916:     â€” each emission ALSO dispatches ONE allowlisted, idempotency-keyed,\r\n14917:     rate-capped, audited action via the phase=2 governed sink (advisory-by-\r\n14918:     default; Tier-2 mutating effects stay DARK; a bad effect fails fast\r\n14919:     here). For a DURABLE reflex that survives a restart, use register_rule\r\n14920:     instead. IDEMPOTENT: re-arming with the SAME `subscription_id` and an\r\n14921:     identical spec/bindings/effect returns the existing subscription with\r\n14922:     `reused=True` and the same `monitor_cmd` â€” do NOT start a second Monitor\r\n14923:     in that case (one logical subscription = one live driver). Each call also\r\n14924:     garbage-collects abandoned `.reactive/sub-*.spec` artifacts older than the\r\n14925:     TTL. Worked usage: get_guide('reactive-streams') /\r\n14926:     get_guide('reactive-streams-effects').\"\"\"\r\n14927: \r\n14928:     name = \"observe\"\r\n14929:     InputModel = _ObserveIn\r\n14930:     OutputModel = _ObserveOut\r\n14931: \r\n14932:     async def _run(self, m: _ObserveIn):\r\n14933:         import json as _json\r\n14934:         import uuid as _uuid\r\n14935: \r\n14936:         import reactivex as _rx\r\n14937: \r\n14938:         from ..reactive import (\r\n14939:             EffectError,\r\n14940:             EffectSpec,\r\n14941:             RxRuntime,\r\n14942:             SpecError,\r\n14943:             compile_spec,\r\n14944:         )\r\n14945: \r\n14946:         seen: list[str] = []\r\n14947: \r\n14948:         def _validation_provider(name, **kw):\r\n14949:             seen.append(name)\r\n14950:             return _rx.empty()   # no I/O â€” just exercise the composition\r\n14951: \r\n14952:         runtime = RxRuntime(_validation_provider)\r\n14953:         try:\r\n14954:             compile_spec(m.spec, runtime, m.bindings)\r\n14955:         except SpecError as exc:\r\n14956:             return _precondition(str(exc))\r\n14957: \r\n14958:         sid = m.subscription_id or f\"sub-{_uuid.uuid4().hex[:12]}\"\r\n14959:         root = self.ctx.recipes.root.parent / \".reactive\"\r\n14960:         root.mkdir(parents=True, exist_ok=True)\r\n14961: \r\n14962:         # (s17 FA2-F2 / RC2) IDEMPOTENT REUSE: if the caller supplied a\r\n14963:         # subscription_id whose persisted (spec, bindings, effect) is\r\n14964:         # byte-identical to what's being asked for now, this is a re-arm of\r\n14965:         # the SAME subscription â€” return reused=True and the same monitor_cmd\r\n14966:         # WITHOUT rewriting the artifacts, so the caller knows NOT to start a\r\n14967:         # second Monitor (one logical subscription = one live driver). A\r\n14968:         # differing spec under the same sid is a genuine re-spec â†’ overwrite.\r\n14969:         reused = bool(\r\n14970:             m.subscription_id\r\n14971:             and _subscription_matches(root, sid, m.spec, m.bindings, m.effect))\r\n14972: \r\n14973:         # (s17 FA2-F2 / RC2) bound the .reactive/sub-*.spec leak: sweep\r\n14974:         # abandoned artifact triplets older than the TTL on every arm. The\r\n14975:         # subscription we're arming right now (sid) is never swept, and the\r\n14976:         # registry/ + effect_audit/ subdirs are left intact. Best-effort.\r\n14977:         gc_removed = _gc_stale_subscriptions(\r\n14978:             root, keep=sid, ttl_secs=_REACTIVE_SPEC_TTL_SECS,\r\n14979:             now_ts=time.time())\r\n14980:         if gc_removed:\r\n14981:             _log.info(\"observe_gc_swept\",\r\n14982:                       f\"swept {gc_removed} stale sub-*.spec artifact(s)\",\r\n14983:                       removed=gc_removed)\r\n14984: \r\n14985:         spec_path = root / f\"{sid}.spec\"\r\n14986:         if not reused:\r\n14987:             spec_path.write_text(m.spec, encoding=\"utf-8\")\r\n14988:         # monitor_cmd runs under the harness `Monitor` (a bash shell), so:\r\n14989:         #  1. pin the interpreter to THIS MCP server's venv (`sys.executable`)\r\n14990:         #     â€” bare `python` under bash resolved to the wrong venv\r\n14991:         #     (edp-pool's, no `edp_claude`) â†’ ModuleNotFoundError.\r\n14992:         #  2. emit forward-slash, quoted paths â€” bash strips Windows\r\n14993:         #     backslashes (`C:\\X` â†’ `C:X`, exit 127). `.as_posix()` keeps\r\n14994:         #     the drive-letter form bash accepts.\r\n14995:         import sys as _sys\r\n14996:         py = Path(_sys.executable).as_posix()\r\n14997:         # The driver SUBPROCESS resolves its worklog path from EDP_AGENT_HOME\r\n14998:         # and its broker/pool from EDP_BROKER_URL/EDP_POOL_URL. The Monitor\r\n14999:         # may NOT inherit this MCP server's env â€” if it doesn't, the driver\r\n15000:         # defaults repo_root to \".\" and tails the WRONG worklog file â†’ zero\r\n15001:         # emissions â†’ a silently-dead subscription (the planner then falls\r\n15002:         # back to the slow heartbeat â€” the 2026-06-01 \"rx not working\" bug).\r\n15003:         # So BAKE the values into the command (same care already taken to pin\r\n15004:         # the interpreter), resolved from THIS process (authoritative): the\r\n15005:         # stores' actual root + the live client URLs.\r\n15006:         agent_home = self.ctx.recipes.root.parent.as_posix()\r\n15007:         broker_url = (getattr(self.ctx.broker, \"base\", None)\r\n15008:                       or os.environ.get(\"EDP_BROKER_URL\",\r\n15009:                                         \"http://127.0.0.1:9300\"))\r\n15010:         pool_url = (getattr(self.ctx.pool, \"base\", None)\r\n15011:                     or os.environ.get(\"EDP_POOL_URL\", \"http://127.0.0.1:9301\"))\r\n15012:         env_prefix = (\r\n15013:             f'EDP_AGENT_HOME=\"{agent_home}\" '\r\n15014:             f'EDP_BROKER_URL=\"{broker_url}\" '\r\n15015:             f'EDP_POOL_URL=\"{pool_url}\" '\r\n15016:         )\r\n15017:         cmd = (f'{env_prefix}\"{py}\" -m edp_claude.reactive.driver '\r\n15018:                f'--spec-file \"{spec_path.as_posix()}\"')\r\n15019:         if m.bindings:\r\n15020:             b_path = root / f\"{sid}.bindings.json\"\r\n15021:             if not reused:\r\n15022:                 b_path.write_text(_json.dumps(m.bindings), encoding=\"utf-8\")\r\n15023:             cmd += f' --bindings-file \"{b_path.as_posix()}\"'\r\n15024: \r\n15025:         # OPTIONAL governed effect (Phase-2-A motor nerve). Validate it HERE\r\n15026:         # through the SAME EffectSpec.compile gate the driver applies â€” so an\r\n15027:         # un-allowlisted / un-opted / malformed effect fails fast with a\r\n15028:         # consumable error instead of a driver that dies on launch. rule_id\r\n15029:         # defaults to the subscription id (audit-trail identity). We do NOT\r\n15030:         # build the dispatcher here (this MCP shell does not run effects); the\r\n15031:         # driver subprocess wires it at phase=2 via --effect-file (Tier-2 DARK,\r\n15032:         # advisory-by-default). owner = provenance/echo-filter inbox.\r\n15033:         has_effect = False\r\n15034:         if m.effect is not None:\r\n15035:             _eff_msg = _effect_role_violation(m.effect)  # F37#10\r\n15036:             if _eff_msg is not None:\r\n15037:                 return _precondition(_eff_msg)\r\n15038:             eff = {**m.effect}\r\n15039:             eff.setdefault(\"rule_id\", sid)\r\n15040:             try:\r\n15041:                 EffectSpec.compile(eff)   # allowlist + opt-in + arg contract\r\n15042:             except EffectError as exc:\r\n15043:                 return _precondition(f\"invalid effect: {exc}\")\r\n15044:             eff_path = root / f\"{sid}.effect.json\"\r\n15045:             if not reused:\r\n15046:                 eff_path.write_text(_json.dumps(eff), encoding=\"utf-8\")\r\n15047:             owner = m.owner or str(m.bindings.get(\"me\", \"\"))\r\n15048:             cmd += (f' --effect-file \"{eff_path.as_posix()}\"'\r\n15049:                     f' --owner \"{owner}\"')\r\n15050:             has_effect = True\r\n15051: \r\n15052:         # W7 part 4: thread the per-spec RATE-LIMIT knob into the driver ONLY\r\n15053:         # when set (>0), so the default (0) leaves the command byte-identical\r\n15054:         # to today's â€” preserving existing behavior + the idempotent-reuse\r\n15055:         # cmd equality.\r\n15056:         #\r\n15057:         # IT IS NOT A DEBOUNCE, AND THE DRIVER DOES NOT WRAP THE PIPELINE. This\r\n15058:         # comment used to read \"the driver wires it to RxRuntime.debounce_ms\",\r\n15059:         # which is what shipped and was the defect: one debounce over the COMPILED\r\n15060:         # (merged) stream waits for a silence that never comes when a poller is\r\n15061:         # merged in, and it keeps only the burst's LAST item â€” so a worker's\r\n15062:         # once-only `done` was DISCARDED and a pool snapshot delivered in its\r\n15063:         # place. s29/a3 deleted `_apply_debounce`; driver.main now hands the knob\r\n15064:         # to the RUNTIME, which applies `ops.sample` PER SOURCE, as each source is\r\n15065:         # constructed and BEFORE any merge, and only to the polled snapshot planes\r\n15066:         # (RATE_LIMITABLE_SOURCES). CRITICAL_SOURCES (broker/worklog/â€¦) are never\r\n15067:         # rate-limited at any setting, so no knob value can starve a once-only\r\n15068:         # event.\r\n15069:         if m.min_interval_ms and m.min_interval_ms > 0:\r\n15070:             cmd += f' --min-interval-ms {m.min_interval_ms}'\r\n15071: \r\n15072:         # W2 leg 2 (DESIGN-v6 Â§W2): associate this subscription with its OWNING\r\n15073:         # handle so the rewire hand-back can return it to a compacted shell.\r\n15074:         # The handle is the owner/me inbox (a plan_id / recipe_id / worker addr)\r\n15075:         # â€” the SAME address a shell drives next_action/reconcile under, so the\r\n15076:         # rewire block looks its subscriptions up by m.handle. Idempotent + dedup\r\n15077:         # so a reused=True re-arm re-indexes harmlessly (also self-heals a lost\r\n15078:         # index entry). Best-effort: an index write must NEVER fail the observe.\r\n15079:         from ..reactive.handle_index import register_subscription\r\n15080:         owner_handle = m.owner or str(m.bindings.get(\"me\", \"\"))\r\n15081:         if owner_handle:\r\n15082:             try:\r\n15083:                 register_subscription(root, owner_handle, sid)\r\n15084:             except OSError as exc:\r\n15085:                 _log.warning(\"observe_index_skip\",\r\n15086:                              f\"could not index {sid} -> {owner_handle}: {exc}\",\r\n15087:                              sid=sid)\r\n15088: \r\n15089:         # v7 WS7 (SHADOW.md Â§4): in a SHADOWED shell the subscription is\r\n15090:         # registered with the shadow's hosted driver instead of handing\r\n15091:         # back a Monitor command â€” same validation, same persistence, no\r\n15092:         # Monitor to babysit. monitor_cmd carries the note, not a command.\r\n15093:         if os.environ.get(\"EDP_SHADOW_NONCE\", \"\").strip():\r\n15094:             paths = _shadow_paths()\r\n15095:             if paths is not None:\r\n15096:                 _, cmd_path = paths\r\n15097:                 try:\r\n15098:                     with cmd_path.open(\"a\", encoding=\"utf-8\") as fh:\r\n15099:                         fh.write(json.dumps(\r\n15100:                             {\"verb\": \"observe\", \"spec\": m.spec}) + \"\\n\")\r\n15101:                     return Tool.ok(_ObserveOut(\r\n15102:                         subscription_id=sid,\r\n15103:                         bound_to=sorted(set(seen)),\r\n15104:                         monitor_cmd=(\"(shadow-hosted â€” registered with \"\r\n15105:                                      \"your shadow; NO Monitor needed. \"\r\n15106:                                      \"reflex(status) shows it live.)\"),\r\n15107:                         has_effect=has_effect,\r\n15108:                         reused=reused,\r\n15109:                     ))\r\n15110:                 except OSError:\r\n15111:                     pass          # fall through to the classic Monitor path\r\n15112:         return Tool.ok(_ObserveOut(\r\n15113:             subscription_id=sid,\r\n15114:             bound_to=sorted(set(seen)),\r\n15115:             monitor_cmd=cmd,\r\n--- 15325-15460 ---\r\n15325:     resolved from THIS server's store root so the MCP tool and the supervisor\r\n15326:     agree on one location regardless of the supervisor's cwd.\"\"\"\r\n15327:     return ctx.recipes.root.parent / \".reactive\" / \"registry\"\r\n15328: \r\n15329: \r\n15330: class _RegisterRuleIn(BaseModel):\r\n15331:     name: str                              # unique rule name (audit identity)\r\n15332:     spec: str                              # the rx observe lambda (one expr)\r\n15333:     owner: str                             # provenance inbox (echo filter)\r\n15334:     bindings: dict = {}                    # spec bindings, e.g. {\"me\": \"...\"}\r\n15335:     effect: dict | None = None             # OPTIONAL governed EffectSpec dict\r\n15336:     enabled: bool = True                   # registered + auto-subscribed if True\r\n15337:     replace: bool = False                  # overwrite an existing same-name rule\r\n15338: \r\n15339: \r\n15340: class _RegisterRuleOut(BaseModel):\r\n15341:     name: str\r\n15342:     owner: str\r\n15343:     enabled: bool\r\n15344:     has_effect: bool\r\n15345:     created_ts: str\r\n15346:     updated_ts: str\r\n15347:     note: str\r\n15348: \r\n15349: \r\n15350: class RegisterRule(_ClaudeTool):\r\n15351:     \"\"\"Register a DURABLE reactive rule = (an observe `spec` + optional\r\n15352:     governed `effect` + `owner`), persisted to disk so it SURVIVES a shell /\r\n15353:     broker / pool restart â€” a running RuleSupervisor re-subscribes every\r\n15354:     ENABLED rule on startup, so a standing reflex (e.g. the 6th-sense\r\n15355:     watcher) is a registered rule, not a session-bound monitor that dies\r\n15356:     with its shell. The `spec` (composition, no I/O) and `effect` (same\r\n15357:     allowlist + opt-in gate as the driver; advisory-by-default, Tier-2\r\n15358:     mutating effects DARK) are validated BEFORE disk, so an invalid rule\r\n15359:     never persists. **Use a unique `name`; set `replace=true` to\r\n15360:     overwrite.** Delegates to reactive.registry.RuleRegistry. Worked usage:\r\n15361:     get_guide('reactive-streams-effects').\"\"\"\r\n15362: \r\n15363:     name = \"register_rule\"\r\n15364:     InputModel = _RegisterRuleIn\r\n15365:     OutputModel = _RegisterRuleOut\r\n15366: \r\n15367:     async def _run(self, m: _RegisterRuleIn):\r\n15368:         from ..reactive import (\r\n15369:             EffectError,\r\n15370:             RegistryError,\r\n15371:             RuleRegistry,\r\n15372:             SpecError,\r\n15373:         )\r\n15374: \r\n15375:         _eff_msg = _effect_role_violation(m.effect)  # F37#10\r\n15376:         if _eff_msg is not None:\r\n15377:             return _precondition(_eff_msg)\r\n15378:         registry = RuleRegistry(root=_registry_root(self.ctx))\r\n15379:         try:\r\n15380:             rule = registry.register_rule(\r\n15381:                 name=m.name, spec=m.spec, effect=m.effect, owner=m.owner,\r\n15382:                 enabled=m.enabled, bindings=m.bindings, replace=m.replace)\r\n15383:         # register_rule validates the observe spec (SpecError) and the\r\n15384:         # governed effect (EffectError) BEFORE persisting, and rejects a\r\n15385:         # duplicate name (RegistryError). All three are user-fixable inputs â†’\r\n15386:         # surface as ONE consumable precondition, never an uncaught 500.\r\n15387:         except (RegistryError, SpecError, EffectError) as exc:\r\n15388:             return _precondition(str(exc))\r\n15389:         return Tool.ok(_RegisterRuleOut(\r\n15390:             name=rule.name, owner=rule.owner, enabled=rule.enabled,\r\n15391:             has_effect=rule.effect is not None,\r\n15392:             created_ts=rule.created_ts, updated_ts=rule.updated_ts,\r\n15393:             note=(\"registered durably; the rule supervisor subscribes it \"\r\n15394:                   \"on its next load (now if enabled and the supervisor is \"\r\n15395:                   \"running). Rediscover via list_rules.\"),\r\n15396:         ))\r\n15397: \r\n15398: \r\n15399: class _ListRulesIn(BaseModel):\r\n15400:     enabled_only: bool = False             # True â†’ only currently-enabled rules\r\n15401:     # a3: window the registry (it scales with the global rule count). Records\r\n15402:     # stay FULL (re-authoring needs spec/effect/bindings, and there is no\r\n15403:     # per-rule read to recover from a summary); `count` is the FULL total.\r\n15404:     offset: int = 0\r\n15405:     limit: int = WINDOW\r\n15406: \r\n15407: \r\n15408: class _ListRulesOut(BaseModel):\r\n15409:     count: int\r\n15410:     cursor: int | None = None              # next offset to page from, or None\r\n15411:     rules: list[dict]                      # each: full rule record (rediscovery)\r\n15412: \r\n15413: \r\n15414: class ListRules(_ClaudeTool):\r\n15415:     \"\"\"Enumerate the DURABLE reactive rules registered on disk so a no-context\r\n15416:     shell can REDISCOVER the standing reflexes after a restart (the durability\r\n15417:     counterpart of register_rule). Returns each rule's full record â€” name,\r\n15418:     owner, enabled, the observe `spec` + bindings, and the governed `effect`\r\n15419:     (if any) â€” which is exactly what's needed to understand or re-author a\r\n15420:     rule. Pass `enabled_only=true` to list just the rules the supervisor is\r\n15421:     actively keeping subscribed. Read-only; delegates to\r\n15422:     edp_claude.reactive.registry.RuleRegistry.\"\"\"\r\n15423: \r\n15424:     name = \"list_rules\"\r\n15425:     InputModel = _ListRulesIn\r\n15426:     OutputModel = _ListRulesOut\r\n15427: \r\n15428:     async def _run(self, m: _ListRulesIn):\r\n15429:         from ..reactive import RuleRegistry\r\n15430: \r\n15431:         registry = RuleRegistry(root=_registry_root(self.ctx))\r\n15432:         rules = (registry.enabled_rules() if m.enabled_only\r\n15433:                  else registry.list_rules())\r\n15434:         w = windowed([r.to_json() for r in rules], m.offset, m.limit)\r\n15435:         return Tool.ok(_ListRulesOut(\r\n15436:             count=w[\"count\"],\r\n15437:             cursor=w[\"cursor\"],\r\n15438:             rules=w[\"items\"],\r\n15439:         ))\r\n15440: \r\n15441: \r\n15442: def _digest_trim(text: Any, limit: int = 200) -> str:\r\n15443:     \"\"\"First-line, length-capped one-line projection for the digest packet.\"\"\"\r\n15444:     s = str(text or \"\").strip()\r\n15445:     first = s.splitlines()[0].strip() if s else \"\"\r\n15446:     return (first[:limit].rstrip() + \"â€¦\") if len(first) > limit else first\r\n15447: \r\n15448: \r\n15449: class _GetRecipeDigestIn(BaseModel):\r\n15450:     recipe_id: str\r\n15451:     # v7 P6.3: synthesis=true additionally returns the code-generated\r\n15452:     # \"state of the recipe\" markdown (the same content record_step_result\r\n15453:     # refreshes into context/state-synthesis.md on every step close).\r\n15454:     synthesis: bool = False\r\n15455: \r\n15456: \r\n15457: class _GetRecipeDigestOut(BaseModel):\r\n15458:    