{
  "mcpServers": {
    "edp-claude": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\Projects\\Learning\\eda-base3\\claude",
        "python",
        "-m",
        "edp_claude.mcp_server"
      ],
      "env": {
        "EDP_AGENT_HOME": "C:\\Projects\\Learning\\eda-base3\\claude",
        "EDP_LOG_DIR": "C:\\Projects\\Learning\\eda-base3\\.logs",
        "EDP_BROKER_URL": "http://127.0.0.1:9300",
        "EDP_POOL_URL": "http://127.0.0.1:9301",
        "EDP_TIER_WRITE": "1",
        "EDP_ROLE": "${EDP_ROLE:-neuron}",
        "EDP_ROLE_SCOPE": "${EDP_ROLE_SCOPE:-warn}",
        "EDP_HANDLE": "${EDP_HANDLE:-}",
        "EDP_SHADOW_NONCE": "${EDP_SHADOW_NONCE:-}",
        "EDP_SHADOW_DIR": "${EDP_SHADOW_DIR:-}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
