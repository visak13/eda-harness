# Virtual envs & caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.uv-cache/
node_modules/

# Logs & runtime telemetry
.logs/
*.log

# Live agent state stores (data, not code)
edp-pool/.claude-pool/
edp-pool/.shadows/
edp-pool/context/
edp-pool/.pool-logs/
edp-broker/.broker-data/
opencode-fleet/.fleet-data/
claude/.archive/
claude/.playwright-mcp/
claude/.shot_tmp/
claude/scratch/
*.png
# Exception: README visual assets are tracked
!docs/assets/**
claude/.recipes/
claude/.plans/
claude/.specs/
claude/.neurons/
claude/.sessions/
claude/.inbox_cursors/
claude/.reactive/
claude/.claude-pool/
claude/.claude/settings.local.json
claude/.reset-backups-*/

# Loose session-debug dumps at claude/ root (untracked in the baseline; keep them out).
# Named individually where a glob would risk catching real files.
claude/*_logs.txt
claude/*_example*.txt
claude/*_debug*.txt
claude/debug*.txt
